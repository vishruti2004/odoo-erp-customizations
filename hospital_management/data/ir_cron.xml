<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- patient reminder mail -->
        <record id="ir_cron_appointment_reminder" model="ir.cron">
            <field name="name">Appointment Reminder Cron</field>
            <field name="model_id" ref="model_hospital_appointment" />
            <field name="state">code</field>
            <field name="code">model.action_send_appointment_reminder()</field>
            <field name="user_id" ref="base.user_root" />

            <!-- Run Daily -->
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

        <!-- birthday Notification to  Doctor -->
        <record id="ir_cron_doctor_birthday" model="ir.cron">
            <field name="name">Doctor Birthday Mail Cron</field>

            <field name="model_id" ref="model_hospital_doctor" />
            <field name="state">code</field>
            <field name="code">model.action_send_doctor_birthday_mail()</field>

            <field name="user_id" ref="base.user_root" />

            <!-- Run Daily -->
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>

            <!-- First execution time -->
            <!-- <field name="nextcall">2026-02-26 00:00:00</field> -->

            <field name="active">True</field>
        </record>
    </data>
</odoo>