<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="appointment_summary_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page appointment_report_container">
                    <div class="report-header">
                        <table style="width: 100%; border: none !important;">
                            <tr>
                                <td style="text-align: left; vertical-align: middle;">
                                    <span class="report-title">Appointment Summary Report</span>
                                </td>
                                <td style="text-align: right; vertical-align: middle;">
                                    <span class="report-date">
                                        <strong>Generate Date:</strong>
                                        <span
                                            t-esc="context_timestamp(datetime.datetime.now()).strftime('%d-%m-%Y %I:%M %p')" />
                                    </span>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <table class="main-report-table">
                        <thead>
                            <tr>
                                <th style="width: 15%;">ID</th>
                                <th style="width: 25%;">Doctor</th>
                                <th style="width: 25%;">Patient</th>
                                <th style="width: 13%;">Status</th>
                                <th style="width: 22%;">Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="docs" t-as="o">
                                <td class="center-cell">
                                    <span t-field="o.name" />
                                </td>
                                <td class="center-cell">
                                    <span t-field="o.doctor_id.display_name" />
                                </td>
                                <td class="center-cell">
                                    <span t-field="o.patient_id.display_name" />
                                </td>
                                <td class="center-cell">
                                    <span t-field="o.state" />
                                </td>
                                <td class="date-cell">
                                    <span t-field="o.start_datetime"
                                        t-options='{"widget": "datetime"}' />
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>