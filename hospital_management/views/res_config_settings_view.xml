<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- SETTINGS VIEW -->
    <record id="res_config_settings_view_form_hospital" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.hospital</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Hospital" name="hospital_management">
                    <block title="Hospital Settings">
                        <setting string="Reminder Days"
                                 help="Set number of days before appointment reminder.">
                            <field name="reminder_days"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <!-- SETTINGS ACTION -->
    <record id="action_hospital_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'hospital_management'}</field>
    </record>

    <!-- SPECIALIZATION ACTION -->
    <record id="action_hospital_specialization" model="ir.actions.act_window">
        <field name="name">Specializations</field>
        <field name="res_model">hospital.specialization</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ROOT MENU -->
    <menuitem id="menu_hospital_root"
              name="Hospital"
              sequence="20"/>

    <!-- CONFIGURATION MENU -->
    <menuitem id="menu_hospital_configuration"
              name="Configuration"
              parent="menu_hospital_root"
              sequence="50"
              groups="hospital_management.group_admin"/>

    <!-- SETTINGS MENU -->
    <menuitem id="menu_hospital_settings"
              name="Settings"
              parent="menu_hospital_configuration"
              action="action_hospital_settings"
              sequence="1"
              groups="base.group_system"/>

    <!-- SPECIALIZATION MENU (UNDER CONFIGURATION) -->
    <menuitem id="menu_hospital_specialization"
              name="Specializations"
              parent="menu_hospital_configuration"
              action="action_hospital_specialization"
              sequence="2"
              groups="hospital_management.group_admin"/>

</odoo>