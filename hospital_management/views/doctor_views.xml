<odoo>

    <!-- LIST VIEW -->
    <record id="view_hospital_doctor_list" model="ir.ui.view">
        <field name="name">hospital.doctor.list</field>
        <field name="model">hospital.doctor</field>
        <field name="arch" type="xml">
            <list string="Doctors">
                <field name="active" widget="boolean_toggle"/>

                <field name="doctor_code"/>
                <field name="partner_id"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="date_of_birth"/>

                <field name="specialization_id"/>
                <field name="resource_calendar_id"/>
               <field name="currency_id" column_invisible="1"/>
                <field name="consultation_fee"/>

                <field name="slot_duration"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
   <record id="view_hospital_doctor_form" model="ir.ui.view">
    <field name="name">hospital.doctor.form</field>
    <field name="model">hospital.doctor</field>
    <field name="arch" type="xml">
        <form string="Doctor" edit="is_editable" delete="is_editable">
            <sheet>
                <field name="is_editable" invisible="1"/>
                
                <div class="oe_button_box" name="button_box">
                    <button name="action_open_appointments"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-bars"
                            invisible="appointment_count == 0">
                        <div class="o_stat_info">
                            <span class="o_stat_value"><field name="appointment_count"/></span>
                            <span class="o_stat_text">Appointments</span>
                        </div>
                    </button>
                </div>

                <group>
                    <group string="Basic Information">
                        <field name="doctor_code" readonly="1"/>
                        <field name="partner_id" readonly="not is_editable"/>
                        <field name="resource_calendar_id" options="{'no_create': True, 'no_open': True}" readonly="not is_editable"/>
                        <field name="active" widget="boolean_toggle" readonly="not is_editable"/>
                    </group>

                    <group string="Professional Details">
                        <field name="date_of_birth" readonly="not is_editable"/>
                        <field name="specialization_id" readonly="not is_editable"/>
                        <field name="consultation_fee" readonly="not is_editable"/>
                        <field name="slot_duration" readonly="not is_editable"/>
                    </group>
                </group>
            </sheet>
            <chatter/>
        </form>
    </field>
</record>
