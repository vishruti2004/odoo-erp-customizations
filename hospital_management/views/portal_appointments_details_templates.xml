<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="portal_appointment_page" name="My Appointment Detail">
        <t t-call="portal.portal_layout">
            <t t-set="wrapwrap_classes" t-value="'o_portal_bg_dark'" />

            <div class="container mb64">
                <div class="row">
                 <!-- side bar -->
                    <t t-call="portal.portal_record_sidebar">
                        <t t-set="classes" t-value="'col-lg-3 d-print-none'" />
                        <t t-set="entries">
                            <div id="appointment-nav"
                                class="d-flex align-items-center flex-grow-1 p-0"
                                role="complementary">
                                
                                <ul class="nav flex-column">
                                    <li class="nav-item">
                                        <a class="nav-link p-0" href="#appointment_section">
                                            Appointment
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link p-0" href="#description_section">
                                            Description
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link p-0" href="#communication_section">
                                            Communication
                                        </a>
                                    </li>
                                    <li class="nav-item mt-3">
                                        <div class="d-flex gap-2">

                                            <!-- Preview -->
                                            <a class="btn btn-outline-primary btn-sm flex-fill"
                                                target="_blank"
                                                t-att-href="'/report/pdf/hospital_management.report_appointment_document/%s' % appointment.id">
                                                <i class="fa fa-eye me-1" /> Preview </a>

                                            <!-- Download -->
                                            <a class="btn btn-primary btn-sm flex-fill"
                                                t-att-href="'/my/appointment/%s?report_type=pdf&amp;download=true' % appointment.id">
                                                <i class="fa fa-download me-1" /> Download </a>
                                        </div>
                                    </li>
                                </ul>
                            </div>
                        </t>
                    </t>

                    <!--  CONTENT  -->
                    <div class="col-lg-9">

                        <!--  APPOINTMENT  -->
                        <div id="appointment_section"
                            class="card shadow-sm mb-4"
                            style="scroll-margin-top:100px;">

                            <!-- Header -->
                            <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">

                                <h4 class="mb-0 text-primary">
                                    <i class="fa fa-calendar-check-o me-2" />
                                    <span t-field="appointment.name" />
                                </h4>

                                <div class="d-flex align-items-center gap-2">

                                    <!-- Status Badge -->
                                    <span
                                        t-attf-class="badge rounded-pill p-2 px-3 #{
                                        'bg-secondary' if appointment.state == 'draft' else
                                        'bg-info' if appointment.state == 'request' else
                                        'bg-success' if appointment.state == 'confirm' else
                                        'bg-warning text-dark' if appointment.state == 'consult' else
                                        'bg-primary' if appointment.state == 'done' else
                                        'bg-danger' if appointment.state == 'cancel' else 'bg-secondary'
                                    }"
                                        style="font-size:0.9rem;min-width:120px;text-align:center;">
                                    <span t-field="appointment.state" /></span>


                                    <!-- ACTION BUTTONS -->
                                     <!-- REQUEST (patient only) -->
                                    <a t-if="appointment.state == 'draft' and (
                                                appointment.patient_id.user_id.id == request.env.user.id
                                                or
                                                appointment.doctor_id.user_id.id == request.env.user.id
                                                or
                                                request.env.user.has_group('hospital_management.group_admin')
                                            )"
                                        t-att-href="'/my/appointment/action/%s/request' % appointment.id"
                                        class="btn btn-sm btn-success">Request</a>

                                    <!-- CONFIRM (doctor or admin) -->
                                    <a t-if="appointment.state == 'request' and (appointment.doctor_id.user_id.id == request.env.user.id or request.env.user.has_group('hospital_management.group_admin'))"
                                        t-att-href="'/my/appointment/action/%s/confirm' % appointment.id"
                                        class="btn btn-sm btn-success">Confirm</a>

                                    <!-- START CONSULTATION -->
                                    <a t-if="appointment.state == 'confirm' and (appointment.doctor_id.user_id.id == request.env.user.id or request.env.user.has_group('hospital_management.group_admin'))"
                                        t-att-href="'/my/appointment/action/%s/consult' % appointment.id"
                                        class="btn btn-sm btn-warning">Start Consultation</a>

                                    <!-- DONE -->
                                    <button
                                        t-if="appointment.state == 'consult' and (appointment.doctor_id.user_id.id == request.env.user.id or request.env.user.has_group('hospital_management.group_admin'))"
                                        type="submit"
                                        form="consult_done_form"
                                        class="btn btn-sm btn-success">
                                        Done
                                    </button>

                                    <a t-if="appointment.state == 'request' and appointment.patient_id.user_id.id == request.env.user.id and appointment.doctor_id.user_id.id != request.env.user.id"
                                        t-att-href="'/my/appointment/action/%s/cancel' % appointment.id"
                                        class="btn btn-sm btn-danger">Cancel</a>

                                    <a t-if="appointment.state in ['draft', 'request', 'confirm'] and (appointment.doctor_id.user_id.id == request.env.user.id or request.env.user.has_group('hospital_management.group_admin'))"
                                        href="#"
                                        class="btn btn-sm btn-danger"
                                        data-bs-toggle="modal"
                                        data-bs-target="#cancelModal"> Cancel</a>

                                    <!-- RESET -->
                                    <a t-if="appointment.state == 'cancel' and (
                                                appointment.patient_id.user_id.id == request.env.user.id
                                                or
                                                appointment.doctor_id.user_id.id == request.env.user.id
                                                or
                                                request.env.user.has_group('hospital_management.group_admin')
                                            )"
                                        t-att-href="'/my/appointment/action/%s/reset' % appointment.id"
                                        class="btn btn-sm btn-secondary"> Reset to Draft</a>
                                </div>
                            </div>

                            <!-- Body -->
                            <div class="card-body">
                                <div class="row">
                                    <!-- genral information -->
                                    <div class="col-md-6 border-end">
                                        <h5 class="text-muted border-bottom pb-2 mb-3">
                                            General Information
                                        </h5>
                                        <div class="row mb-3">
                                            <div class="col-5 text-muted">Specialization</div>
                                            <div class="col-7">
                                                <strong>
                                                    <span t-field="appointment.specialization_id" />
                                                </strong>
                                            </div>
                                        </div>
                                        <div class="row mb-3">
                                            <div class="col-5 text-muted">Doctor</div>
                                            <div class="col-7">
                                                <span t-field="appointment.doctor_id" />
                                            </div>
                                        </div>
                                        <div class="row mb-3">
                                            <div class="col-5 text-muted">Patient</div>
                                            <div class="col-7">
                                                <span t-field="appointment.patient_id" />
                                            </div>
                                        </div>
                                        <div class="row mb-3 border-top pt-2">
                                            <div class="col-5 text-muted fw-bold">
                                                Consultation Fee
                                            </div>
                                            <div class="col-7 text-success">
                                                <strong>
                                                    <span t-field="appointment.consultation_fee"
                                                        t-options='{"widget": "monetary", "display_currency": appointment.currency_id}' />
                                                </strong>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- SCHEDULE -->
                                    <div class="col-md-6 ps-4">
                                        <h5 class="text-muted border-bottom pb-2 mb-3">
                                            Schedule Information
                                        </h5>

                                        <div class="row mb-3">
                                            <div class="col-5 text-muted">
                                                Start Datetime
                                            </div>
                                            <div class="col-7">
                                                <i class="fa fa-clock-o me-1 text-muted" />
                                                <span t-field="appointment.start_datetime"
                                                    t-options='{"widget":"datetime"}' />
                                            </div>
                                        </div>

                                        <div class="row mb-3">
                                            <div class="col-5 text-muted">
                                                End Datetime
                                            </div>
                                            <div class="col-7">
                                                <i class="fa fa-clock-o me-1 text-muted" />
                                                <span t-field="appointment.end_datetime"
                                                    t-options='{"widget":"datetime"}' />
                                            </div>
                                        </div>
                                    </div>
                                </div>

                              <!--  DESCRIPTION  -->
                                <div id="description_section"
                                    class="row mt-4"
                                    style="scroll-margin-top:100px;">

                                    <div class="col-12">
                                        <div class="card bg-light border-0">
                                            <div class="card-body">

                                                <!-- Patient Description -->
                                                <t t-if="appointment.description">
                                                    <h6 class="text-uppercase text-muted small fw-bold mb-2">
                                                        <i class="fa fa-file-text-o me-1" /> Patient Description </h6>
                                                    <div
                                                        class="p-3 bg-white border rounded shadow-sm mb-4">
                                                        <p class="card-text text-dark mb-0"
                                                            t-field="appointment.description" />
                                                    </div>
                                                </t>

                                                <!-- Doctor Description -->
                                                <t t-if="appointment.state in ['consult','done']">

                                                    <h6 class="text-uppercase text-success small fw-bold mb-2">
                                                        <i class="fa fa-user-md me-1" /> Doctor Description </h6>

                                                    <t t-if="appointment.state == 'consult'">

                                                        <form id="consult_done_form"
                                                            method="post"
                                                            t-att-action="'/my/appointment/action/%s/done' % appointment.id">

                                                            <input type="hidden"
                                                                name="csrf_token"
                                                                t-att-value="request.csrf_token()" />

                                                            <textarea name="doc_description"
                                                                id="doc_description"
                                                                class="form-control"
                                                                rows="3"
                                                                placeholder="Enter consultation notes..."
                                                                required="1">

                                                                <t t-esc="appointment.doc_description" />
                                                            </textarea>
                                                        </form>
                                                    </t>

                                                    <t t-if="appointment.state == 'done'">
                                                        <div class="p-3 bg-white border-start border-success border-4 rounded shadow-sm mb-4">
                                                            <p class="card-text text-dark mb-0"
                                                                t-field="appointment.doc_description" />
                                                        </div>
                                                    </t>
                                                </t>

                                                <!-- Cancel Reason -->
                                                <t t-if="appointment.state == 'cancel'">

                                                    <h6 class="text-uppercase text-danger small fw-bold mb-2">
                                                        <i class="fa fa-exclamation-circle me-1" /> Cancellation Reason </h6>

                                                    <div class="p-3 bg-white border-start border-danger border-4 rounded shadow-sm">
                                                        <p class="card-text text-danger mb-0"
                                                            t-field="appointment.cancel_reason" />
                                                    </div>
                                                </t>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- communication  -->
                        <div id="communication_section" style="scroll-margin-top:100px;">
                            <h3>Communication History</h3>
                            <t t-call="portal.message_thread">
                                <t t-set="object" t-value="appointment" />
                            </t>
                        </div>
                    </div>
                </div>
            </div>

            <!-- cancel modal  -->
            <div class="modal fade" id="cancelModal" tabindex="-1">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <form method="post" t-att-action="'/my/appointment/action/%s/cancel' % appointment.id">
                            <input type="hidden"  name="csrf_token"  t-att-value="request.csrf_token()" />
                            <div class="modal-header">
                                <h6 class="modal-title fw-bold"> Cancel Appointment</h6>
                                <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="modal" />
                            </div>

                            <div class="modal-body">
                                <label class="form-label">
                                    Cancellation Reason
                                </label>

                                <textarea name="cancel_reason"
                                    class="form-control"
                                    required="1" />
                            </div>

                            <div class="modal-footer">
                                <button type="submit"
                                    class="btn btn-danger btn-sm">
                                    Confirm Cancel
                                </button>
                               <button type="button"
                                    class="btn btn-secondary btn-sm"
                                    data-bs-dismiss="modal">
                                    Close
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>