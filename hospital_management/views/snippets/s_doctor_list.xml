<odoo>
  <template id="s_doctor_list" name="Doctor List">
    <section class="s_doctor_list o_spc_20" data-snippet="hospital_management.doctor_list">
        <div class="container">
            <div class="row o_doctor_container">
                <t t-call="hospital_management.s_doctor_list_preview_data"/>
            </div>
        </div>
    </section>
</template>

    <template id="doctor_card_template" name="Doctor Card Template">
    <t t-if="doctors">
        <div class="d-flex flex-wrap gap-3"> 
            <t t-foreach="doctors" t-as="doctor">
                <div style="width: 300px;"> 
                    <div class="card h-100 shadow-sm border-0 text-center p-3" 
                         style="border-radius: 15px; background: #fff; position: relative; min-height: 250px;">
                        <div style="height: 5px; background: #714B67; position: absolute; top: 0; left: 0; right: 0; border-radius: 15px 15px 0 0;"></div>

                        <h5 class="fw-bold mt-3 mb-1">
                            <t t-out="doctor.name"/>
                        </h5>
                        
                        <span class="badge rounded-pill mb-3 px-3 py-2" 
                              style="background: #f1eef0; color: #714B67; align-self: center;">
                            <t t-out="doctor.specialization_id.name"/>
                        </span>
                        
                        <div class="text-start px-2" style="font-size: 0.85rem; color: #555;">
                            <div class="mb-2">
                                <i class="fa fa-phone me-2 text-primary"></i> 
                                <t t-out="doctor.phone"/>
                            </div>
                            <div class="mb-2 text-truncate">
                                <i class="fa fa-envelope me-2 text-danger"></i> 
                                <t t-out="doctor.email"/>
                            </div>
                            <div class="fw-bold text-dark mt-2 pt-1 border-top">
                                <i class="fa fa-money me-1 text-success"></i>
                                Fees: ₹ <t t-out="doctor.consultation_fee"/>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </div>
    </t>
    <t t-else="">
        <div class="col-12 text-center p-5">
            <h4 class="text-muted">No doctors found for this selection.</h4>
        </div>
    </t>
</template>
</odoo>