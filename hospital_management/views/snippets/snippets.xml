<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="hospital_snippets_register" inherit_id="website.snippets" name="Hospital Snippets Register">
        
        <xpath expr="//snippets[@id='snippet_groups']" position="inside">
            <!-- <t snippet-group="doctors" t-snippet="hospital_management.s_doctor_list"  -->
            <t snippet-group="doctors" t-snippet="hospital_management.s_dynamic_doctors" 

               t-thumbnail="/hospital_management/static/description/icon.png"/>
        </xpath>
        
        <xpath expr="//snippets[@id='snippet_structure']" position="inside">
            <t t-snippet="hospital_management.s_dynamic_doctors" group="doctors"/>
        </xpath>
    </template>

