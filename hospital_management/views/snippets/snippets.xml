<odoo>
    <template id="hospital_snippets_register" inherit_id="website.snippets" name="Hospital Snippets Register">
        <xpath expr="//snippets[@id='snippet_groups']" position="inside">
            <t t-snippet="hospital_management.s_doctor_list" 
            string="Doctor List"
            t-thumbnail="/website/static/src/img/snippets_thumbs/s_three_columns.svg"
            data-snippet="s_doctor_tabs"/>
        </xpath>
    </template>
</odoo> 