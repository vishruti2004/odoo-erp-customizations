<odoo>
    <record id="view_appointment_summary_wizard_form" model="ir.ui.view">
        <field name="name">appointment.summary.wizard.form</field>
        <field name="model">appointment.summary.wizard</field>
        <field name="arch" type="xml">
            <form string="Appointment Summary Report">
                <sheet>
                    <group string="Date Filters">

                        <!-- <group>
                            <field name="name"/>
                        </group> -->
                        <group>
                            <field name="start_date"/>
                        </group>
                        <group>
                            <field name="end_date"/>
                        </group>
                    </group>

                    <group string="Optional Filters">
                        <group>
                            <!-- <field name="doctor_ids" widget="many2many_tags"/> -->.
                             <field name="doctor_ids"
                             widget="many2many_tags"
                               readonly="is_doctor_user == True"/>
                            <field name="patient_ids" widget="many2many_tags"/>

                            
                        </group>
                    </group>
                    
                    <group string="Status">
                        <group>
                            <field name="state"/>
                        </group>
                    </group>

                    <group string="Grouping &amp; Sorting">
                        <group>
                            <field name="group_by"/>
                        </group>
                        <group>
                            <field name="sort_by"/>
                        </group>
                    </group>
                </sheet>

                <footer>
                    <button name="action_view_data"
                            type="object"
                            string="View Data"
                            class="btn-primary"/>

                    <button name="action_generate_pdf"
                            type="object"
                            string="Download PDF"
                             class="btn-danger"/>


                    <button name="action_download_xlsx"
                            type="object"
                            string="Download xls"
                            class="btn-success"/>
                            
                            
                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_appointment_summary_wizard"
            model="ir.actions.act_window">
        <field name="name">Appointment Summary</field>
        <field name="res_model">appointment.summary.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_appointment_summary_wizard_form"/>
    </record>

    <menuitem id="menu_appointment_summary"
              name="Summary Report"
              parent="hospital_management.menu_hospital_root"
              action="action_appointment_summary_wizard"
              sequence="50"
              groups="hospital_management.group_doctor,hospital_management.group_admin"/>
</odoo>