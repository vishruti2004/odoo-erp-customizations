<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="0">

<!-- privilege -->
<record id="res_groups_privilege_hospital" model="res.groups.privilege">
    <field name="name">Hospital</field>
    <field name="sequence">15</field>
    <field name="category_id" ref="base.module_category_hidden"/>
</record>

<!-- groups -->

<record id="group_patient" model="res.groups">
    <field name="name">Patient</field>
    <field name="privilege_id" ref="hospital_management.res_groups_privilege_hospital"/>
</record>

<record id="group_doctor" model="res.groups">
    <field name="name">Doctor</field>
    <field name="privilege_id" ref="hospital_management.res_groups_privilege_hospital"/>
    <field name="implied_ids" eval="[(4, ref('hospital_management.group_patient'))]"/>
</record>

<record id="group_admin" model="res.groups">
    <field name="name">Administrator</field>
    <field name="privilege_id" ref="hospital_management.res_groups_privilege_hospital"/>
    <field name="implied_ids" eval="[(4, ref('hospital_management.group_doctor'))]"/>   
</record>


<!-- Doctor appointment rule -->
<record id="hospital_appointment_doctor_rule" model="ir.rule">
    <field name="name">Doctor: See Own Appointments Only</field>
    <field name="model_id" ref="model_hospital_appointment"/>
    <field name="groups" eval="[(4, ref('hospital_management.group_doctor'))]"/>
    <field name="domain_force">[('doctor_id.user_id', '=', user.id)]</field>
</record>


<!-- Patient appointment rule -->
<record id="hospital_appointment_patient_rule" model="ir.rule">
    <field name="name">Patient Own Appointments</field>
    <field name="model_id" ref="model_hospital_appointment"/>
    <field name="groups" eval="[(4, ref('hospital_management.group_patient'))]"/>
    <field name="domain_force">[('patient_id.user_id', '=', user.id)]</field>
</record>


<!-- Admin appointment rule -->
<record id="hospital_appointment_admin_all_rule" model="ir.rule">
    <field name="name">Administrator: See All Appointments</field>
    <field name="model_id" ref="model_hospital_appointment"/>
    <field name="domain_force">[(1,'=',1)]</field>
    <field name="groups" eval="[(4, ref('hospital_management.group_admin'))]"/>
</record>

</data>
</odoo>