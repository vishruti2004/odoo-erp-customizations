    <!-- Doctor: edit own record -->


   <record id="doctor_read_all_rule" model="ir.rule">
        <field name="name">Doctor: Read All Doctors</field>
        <field name="model_id" ref="model_hospital_doctor"/>
        <field name="groups" eval="[(4, ref('hospital_management.group_doctor'))]"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="doctor_own_record_rule" model="ir.rule">
        <field name="name">Doctor: Manage Own Record Only</field>
        <field name="model_id" ref="model_hospital_doctor"/>
        <field name="groups" eval="[(4, ref('hospital_management.group_doctor'))]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>


    <!-- Patient: See Only Own Appointments -->
    <record id="hospital_appointment_patient_rule" model="ir.rule">
        <field name="name">Patient Own Appointments</field>
        <field name="model_id" ref="model_hospital_appointment"/>
        <field name="groups" eval="[(4, ref('hospital_management.group_patient'))]"/>
        <field name="domain_force">
            [('patient_id.user_id', '=', user.id)]
        </field>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>

<record id="hospital_appointment_admin_all_rule" model="ir.rule">
    <field name="name">Administrator: See All Appointments</field>
    <field name="model_id" ref="model_hospital_appointment"/>
    <field name="domain_force">[(1, '=', 1)]</field>
    <field name="groups" eval="[(4, ref('hospital_management.group_admin'))]"/>
    <field name="perm_read" eval="1"/>
    <field name="perm_write" eval="1"/>
    <field name="perm_create" eval="1"/>
    <field name="perm_unlink" eval="1"/>
</record>



</odoo>