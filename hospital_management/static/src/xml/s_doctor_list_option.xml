<templates xml:space="preserve">
    <t t-name="hospital_management.DoctorListOption">
        <BuilderRow label.translate="Specialization">
            <BuilderSelect classAction="'doctor-filter-'" t-on-change="onChangeFilter">
                <BuilderSelectItem classAction="'doctor-filter-0'">
                    All Doctors
                </BuilderSelectItem>      
                <t t-if="state.specializations">
                    <t t-foreach="state.specializations" t-as="spec" t-key="spec.id">
                        <BuilderSelectItem 
                            classAction="'doctor-filter-' + spec.code">
                            <t t-esc="spec.name"/>
                        </BuilderSelectItem>
                    </t>
                </t>
            </BuilderSelect>
        </BuilderRow>
    </t>
</templates>