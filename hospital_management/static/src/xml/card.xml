<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="hospital_management.Card">
        <div class="col-md-4 mb-3" style="cursor: pointer; min-width: 250px;"
         t-on-click="props.onClick">
            <div class="card shadow-sm border-0 p-3 h-100">
                <div class="d-flex align-items-center">
                    <div t-attf-class="p-3 rounded-circle me-3 #{props.bgClass}">
                        <i t-attf-class="fa #{props.icon} fs-2 text-white"></i>
                    </div>
                    <div>
                        <h6 class="text-muted mb-0"><t t-esc="props.label"/></h6>
                        <h2 class="fw-bold mb-0"><t t-esc="props.value"/></h2>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>