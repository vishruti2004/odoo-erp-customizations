<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_task_form_inherit_stock_alert" model="ir.ui.view">
        <field name="name">project.task.form.inherit.stock.alert</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='project_id']" position="after">
                <field name="is_stock_alert_task" invisible="1"/>
                <field name="alert_product_id" invisible="1"/>
            </xpath>

            <xpath expr="//header" position="inside">
    <button name="action_create_purchase_order" 
            string="Create Purchase Order" 
            type="object" 
            class="oe_highlight oe_right"
            icon="fa-shopping-cart"
            invisible="not is_stock_alert_task"
            style="margin-right: 10px;"/>
</xpath>

        </field>
    </record>
</odoo>