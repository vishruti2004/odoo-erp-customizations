<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="stock_alert_description_template">
        <div style="font-family: Arial, sans-serif; padding: 10px;" contenteditable="false">

            <!-- Product Details + Location Stock -->
            <div style="background:#fff5f5; border-left:4px solid #e74c3c; border-radius:6px; padding:15px; margin-bottom:15px;">
                <h2 style="color:#e74c3c; margin:0 0 5px 0;">
                    Product Details: <t t-esc="product.name"/>
                </h2>
                <p style="color:#666; font-size:13px; margin-bottom:10px;">
                    <b>Alert:</b> Minimum quantity according to config must be
                    <b><t t-esc="min_qty"/> <t t-esc="product.uom_id.name"/></b>.
                </p>
                <table style="width:100%; border-collapse:collapse; background:#fff; border-radius:4px;">
                    <tr style="background:#eee; font-weight:bold;">
                        <td style="padding:8px 12px; border-bottom:2px solid #ddd;">Location Name</td>
                        <td style="padding:8px 12px; border-bottom:2px solid #ddd;">Current Stock</td>
                    </tr>
                    <t t-foreach="location_data" t-as="loc">
                        <tr>
                            <td style="padding:8px 12px; border-bottom:1px solid #f0f0f0;">
                                <t t-esc="loc['name']"/>
                            </td>
                            <td t-attf-style="padding:8px 12px; font-weight:bold; border-bottom:1px solid #f0f0f0; color: {{ '#e74c3c' if loc['qty'] &lt; min_qty else '#27ae60' }};">
                                <t t-esc="loc['qty']"/> <t t-esc="product.uom_id.name"/>
                            </td>
                        </tr>
                    </t>
                </table>
            </div>

            <!-- Vendor Pricing -->
            <div style="background:#f5f8ff; border-left:4px solid #3498db; border-radius:6px; padding:15px; margin-bottom:15px;">
                <h3 style="color:#3498db; margin:0 0 10px 0;">Vendor Pricing</h3>
                <table style="width:100%; border-collapse:collapse;">
                    <thead>
                        <tr>
                            <th style="padding:8px 12px; background:#3498db; color:#fff; text-align:left;">Vendor Name</th>
                            <th style="padding:8px 12px; background:#3498db; color:#fff; text-align:left;">Unit Price</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-if="product.seller_ids">
                            <t t-foreach="product.seller_ids" t-as="seller">
                                <tr>
                                    <td style="padding:8px 12px; border-bottom:1px solid #f0f0f0;">
                                        <t t-esc="seller.partner_id.name"/>
                                    </td>
                                    <td style="padding:8px 12px; border-bottom:1px solid #f0f0f0;">
                                        <t t-esc="seller.currency_id.symbol or seller.currency_id.name"/>
                                        <t t-esc="seller.price"/>
                                    </td>
                                </tr>
                            </t>
                        </t>
                        <t t-else="">
                            <tr>
                                <td colspan="2" style="text-align:center; padding:10px; color:#999;">
                                    No vendors available
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>

            <!-- Last Purchase Order -->
            <t t-if="po_data">
                <div style="background:#f5fff8; border-left:4px solid #27ae60; border-radius:6px; padding:15px; margin-bottom:15px;">
                    <h3 style="color:#27ae60; margin:0 0 10px 0;">Last Purchase Order</h3>
                    <table style="width:100%; border-collapse:collapse;">
                        <tr>
                            <td style="padding:6px 12px; font-weight:bold; border-bottom:1px solid #f0f0f0;">Order Reference</td>
                            <td style="padding:6px 12px; border-bottom:1px solid #f0f0f0;"><t t-esc="po_data['name']"/></td>
                        </tr>
                        <tr>
                            <td style="padding:6px 12px; font-weight:bold; border-bottom:1px solid #f0f0f0;">Vendor</td>
                            <td style="padding:6px 12px; border-bottom:1px solid #f0f0f0;"><t t-esc="po_data['vendor']"/></td>
                        </tr>
                        <tr>
                            <td style="padding:6px 12px; font-weight:bold; border-bottom:1px solid #f0f0f0;">Confirmation Date</td>
                            <td style="padding:6px 12px; border-bottom:1px solid #f0f0f0;"><t t-esc="po_data['date']"/></td>
                        </tr>
                        <tr>
                            <td style="padding:6px 12px; font-weight:bold; border-bottom:1px solid #f0f0f0;">Quantity</td>
                            <td style="padding:6px 12px; border-bottom:1px solid #f0f0f0;"><t t-esc="po_data['qty']"/></td>
                        </tr>
                        <tr>
                            <td style="padding:6px 12px; font-weight:bold; border-bottom:1px solid #f0f0f0;">Unit Price</td>
                            <td style="padding:6px 12px; border-bottom:1px solid #f0f0f0;"><t t-esc="po_data['price_unit']"/></td>
                        </tr>
                        <tr>
                            <td style="padding:6px 12px; font-weight:bold;">Total Untaxed</td>
                            <td style="padding:6px 12px;"><t t-esc="po_data['total']"/></td>
                        </tr>
                    </table>
                </div>
            </t>
            <t t-else="">
                <div style="background:#f9f9f9; padding:10px; border-radius:6px; margin-bottom:15px; color:#666;">
                    No previous purchase history.
                </div>
            </t>

        </div>
    </template>

</odoo>