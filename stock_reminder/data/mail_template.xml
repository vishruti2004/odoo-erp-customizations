<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="mail_template_stock_alert" model="mail.template">
            <field name="name">Stock: Low Stock Notification</field>
            <field name="model_id" ref="stock.model_stock_quant"/>
            <field name="subject">Stock Alert: {{ object.product_id.name }} is Low!</field>
            <field name="email_from">{{ object.company_id.email_formatted }}</field>
            <field name="email_to">{{ user.email }}</field>
            <field name="body_html" type="html">
                <div style="margin:0; padding:0;">
                    <div style="max-width:600px; margin:30px auto; background:#ffffff; border-radius:10px; overflow:hidden; box-shadow:0 2px 8px rgba(0,0,0,0.1);">

                        <!-- Header -->
                        <div style="background-color:#e74c3c; padding:30px; text-align:center;">
                           <h2 style="color:#ffffff; margin:0; font-size:22px; font-family:Arial, sans-serif;">
                                <i class="fa fa-exclamation-triangle" style="margin-right:8px;"></i> Low Stock Alert
                            </h2>
                            <p style="color:#fde8e8; margin:8px 0 0 0; font-size:14px; font-family:Arial, sans-serif;">
                                Immediate Attention Required
                            </p>
                        </div>

                        <!-- Body -->
                        <div style="padding:30px; font-family:Arial, sans-serif;">
                            <p style="font-size:16px; color:#333;">
                                Dear <strong>Stock Manager</strong>,
                            </p>
                            <p style="font-size:14px; color:#555; line-height:1.6;">
                                Product <strong><t t-out="object.product_id.name"/></strong> has reached the minimum stock level.
                                Please review the task and create a Purchase Order immediately.
                            </p>

                            <!-- Product + Location Box -->
                            <div style="background:#fff5f5; border-left:4px solid #e74c3c; border-radius:6px; padding:20px; margin:20px 0;">
                               <h3 style="color:#e74c3c; margin:0 0 5px 0; font-size:16px;">
                                    <i class="fa fa-cube" style="margin-right:8px;"></i> Product Details
                                </h3>
                                <p style="color:#888; font-size:12px; margin:0 0 10px 0;">
                                    Minimum stock required:
                                    <strong><t t-out="ctx.get('min_qty')"/> <t t-out="object.product_id.uom_id.name"/></strong>
                                </p>
                                <table style="width:100%; border-collapse:collapse;">
                                    <tr style="background:#fff;">
                                        <td style="padding:10px 15px; font-size:14px; color:#555; width:50%;">
                                            <strong>Product Name</strong>
                                        </td>
                                        <td style="padding:10px 15px; font-size:14px; color:#333;">
                                            <t t-out="object.product_id.name"/>
                                        </td>
                                    </tr>
                                    <tr style="background:#fafafa;">
                                        <td style="padding:10px 15px; font-size:14px; color:#555;">
                                            <strong>Total Stock</strong>
                                        </td>
                                        <td style="padding:10px 15px; font-size:14px; color:#e74c3c; font-weight:bold;">
                                            <t t-out="ctx.get('total_stock')"/> <t t-out="object.product_id.uom_id.name"/>
                                        </td>
                                    </tr>
                                    <!-- Location rows -->
                                    <t t-foreach="ctx.get('location_data', [])" t-as="loc">
                                        <tr>
                                            <td style="padding:10px 15px; font-size:14px; color:#555;">
                                                 <t t-esc="loc['name']"/>
                                            </td>
                                            <td t-attf-style="padding:10px 15px; font-size:14px; font-weight:bold; color: {{ '#e74c3c' if loc['qty'] &lt; ctx.get('min_qty', 0) else '#27ae60' }};">
                                                <t t-esc="loc['qty']"/> <t t-esc="object.product_id.uom_id.name"/>
                                            </td>
                                        </tr>
                                    </t>
                                </table>
                            </div>

                            <!-- View Task Button -->
                            <div style="text-align:center; margin:30px 0;">
                                <a t-att-href="ctx.get('task_url')"
                                   style="background-color:#e74c3c; color:#ffffff; padding:14px 35px; text-decoration:none; border-radius:25px; font-size:15px; font-weight:bold; display:inline-block;">
                                     View Task
                                </a>
                            </div>

                        </div>

                        <!-- Footer -->
                        <div style="background:#f8f8f8; padding:20px; text-align:center; border-top:1px solid #eee;">
                            <p style="margin:0; font-size:12px; color:#999; font-family:Arial, sans-serif;">
                                This is an automated alert from Stock Alert Manager. Please do not reply.
                            </p>
                            <p style="margin:5px 0 0 0; font-size:12px; color:#e74c3c; font-weight:bold; font-family:Arial, sans-serif;">
                                <t t-out="object.company_id.name"/>
                            </p>
                        </div>

                    </div>
                </div>
            </field>
        </record>
    </data>
</odoo>