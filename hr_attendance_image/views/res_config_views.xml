<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_inherit" model="ir.ui.view">
        <field name="name">res.config.settings.view.from.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_attendance.res_config_settings_view_form"/>

        <field name="arch" type="xml">

            <!-- Allow Attendance with image from backend -->
            <xpath expr="//setting[field[@name='absence_management']]" position="after">
                <setting string="Allow Attendance with image from backend" help="Activate this option to allow attendance check-in/out from backend with employee image." invisible="not attendance_from_systray">
                    <field name="attendance_image_capture"/>
                </setting>
            </xpath>

            <!-- Face Recognition and Face Attendance Locations -->
            <xpath expr="//setting[field[@name='attendance_device_tracking']]" position="after">

                <!-- Face Recognition -->
                <setting string="Face Recognition for Check In/Out" help="Enable face recognition for attendance check-in/out." invisible="not attendance_from_systray">
                    <field name="face_recognition"/>
                    <div class="mt16" invisible="not face_recognition">
                        <div>
                            <field name="face_recognition_backend"/>
                            <label for="face_recognition_backend"/>
                        </div>
                        <div>
                            <field name="face_recognition_kiosk"/>
                            <label for="face_recognition_kiosk"/>
                        </div>
                    </div>
                </setting>

                <!-- Face Attendance Locations -->
                <setting string="Face Attendance Locations"
                        company_dependent="1"
                        invisible="not attendance_device_tracking">

                    <field name="multi_location_ids" widget="many2many_tags"/>

                </setting>
            </xpath>

        </field>
    </record>

</odoo>