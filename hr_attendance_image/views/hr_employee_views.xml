<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_inherited" model="ir.ui.view">
        <field name="name">hr.employee.form</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr_attendance.view_employee_form_inherit_hr_attendance" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='hr_settings']" position="after">
                <page name="attendance_setting" string="Attendance Setting">
                     <group>
                        <group>
                            <field name="allow_without_image_capture" groups="hr.group_hr_manager"/>
                        </group>
                    </group>
                    <group>
                        <group groups="hr.group_hr_manager">
                            <field name="face_image" widget="image" groups="hr.group_hr_manager"/>
                        </group>
                    </group>
                </page>
            </xpath>
            <xpath expr="//header" position="inside">
                <header>
                    <button name="generate_face_encoding_manual"
                            string="Generate Face Encoding"
                            type="object"
                            class="btn-primary"
                            invisible="face_image == False"/>
                </header>
            </xpath>
        </field>
    </record>

</odoo>
