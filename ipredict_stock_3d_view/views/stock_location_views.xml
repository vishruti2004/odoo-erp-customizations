<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_location_form_3d_button" model="ir.ui.view">
        <field name="name">stock.location.form.3d.button</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_location_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet" position="before">
                <header>
                    <button name="%(action_stock_3d_view)d"
                            string="View in 3D Warehouse"
                            type="action"
                            class="btn-primary"
                            icon="fa-cube"/>
                </header>
            </xpath>
        </field>
    </record>

    <record id="view_stock_location_form_3d" model="ir.ui.view">
        <field name="name">stock.location.form.3d</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_location_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet" position="inside">
                <notebook name="3d_properties_notebook" string="3D Properties">

                    <page name="3d_properties" string=" 3D Rack">
                        <group string="3D Configuration">
                            <field name="show_in_3d"/>
                            <field name="code_3d"/>
                        </group>
                        <group string="Position">
                            <field name="pos_x"/>
                            <field name="pos_y"/>
                            <field name="pos_z"/>
                            <field name="rotation_y"/>   
                        </group>
                        <group string="Rack Dimensions">
                            <field name="rack_length"/>
                            <field name="rack_width"/>
                            <field name="rack_height"/>
                            <field name="shelf_levels"/>
                            <field name="bins_per_level"/>
                        </group>
                        <group string="Rack Appearance">
                            <field name="color_upright" widget="color"/>
                            <field name="color_beam" widget="color"/>
                            <field name="color_slat" widget="color"/>
                            <field name="color_box" widget="color"/>
                            <field name="beam_height"/>
                        </group>
                        <group string="Live Stock Data">
                            <field name="on_hand" readonly="1"/>
                            <field name="fill_percentage" readonly="1" widget="progressbar"/>
                            <field name="product_ids" readonly="1" widget="many2many_tags"/>
                        </group>
                    </page>

                    <page name="rack_slots" string="Rack Slots">
                        <group colspan="2">
                            <field name="slot_grid_json"
                                   widget="slot_grid"
                                   nolabel="1"
                                   colspan="2"/>
                        </group>
                    </page>

                </notebook>
            </xpath>
        </field>
    </record>
</odoo>