<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <div t-name="ipredict_stock_3d_view.Stock3DView"
         class="o_stock_3d_view d-flex flex-column h-100 w-100">

        <!-- ⭐ HEADER — Full width -->
        <div class="o_3d_header flex-shrink-0 bg-white border-bottom">
            <div class="o_3d_toolbar_filters d-flex gap-2 flex-wrap align-items-center">
                <select class="form-select form-select-sm"
                        t-att-value="state.selectedWarehouse"
                        t-on-change="onWarehouseChange">
                    <option value="">All Warehouses</option>
                    <t t-foreach="state.warehouses" t-as="wh" t-key="wh.id">
                        <option t-att-value="wh.id" t-esc="wh.name"/>
                    </t>
                </select>

                <div class="o_search_wrap">
                    <input type="text" class="form-control form-control-sm"
                        t-att-value="state.searchQuery"
                        t-on-input="onSearchInput"
                        placeholder="Search Location or Product..."
                        autocomplete="off"
                        autocorrect="off"
                        autocapitalize="off"
                        spellcheck="false"/>
                    <button class="btn btn-sm btn-light o_search_clear_btn"
                            t-if="state.searchQuery"
                            t-on-click="clearSearch"
                            title="Clear search">
                        <i class="fa fa-times"/>
                    </button>
                </div>
            </div>

            <div class="o_3d_toolbar_actions">
                <button class="btn btn-sm btn-outline-primary"
                        t-on-click="toggleHeatmap">
                    <t t-if="state.heatmapEnabled">Heatmap ON</t>
                    <t t-else="">Heatmap OFF</t>
                </button>
                <button class="btn btn-sm btn-outline-success"
                        t-on-click="toggleWalkMode">
                    <t t-if="state.walkMode">Walk Mode ON</t>
                    <t t-else="">Walk Mode OFF</t>
                </button>

                <button t-if="state.editRackMode"
                        class="btn btn-sm btn-primary"
                        t-on-click="toggleAddPanel">
                    <i class="fa fa-plus me-1"/> Add Rack
                </button>

                <button t-if="!state.editRackMode"
                        class="btn btn-sm btn-secondary"
                        t-on-click="toggleEditRackMode"
                        title="Enable drag &amp; drop for racks and boxes">
                    <i class="fa fa-pencil me-1"/> Edit Layout
                </button>

                <button t-if="state.editRackMode"
                        class="btn btn-sm btn-success"
                        t-on-click="saveLayoutChanges"
                        title="Save layout changes and exit edit mode">
                    <i class="fa fa-save me-1"/> Save
                </button>
            </div>
        </div>

        <!-- ⭐ CANVAS WRAPPER -->
        <div class="o_3d_canvas_wrapper flex-grow-1 position-relative">
            <div t-ref="canvas" class="o_3d_canvas w-100 h-100"/>

            <!-- ADD/EDIT RACK PANEL -->
            <div class="o_add_rack_panel" t-if="state.addPanelOpen">
                <div class="o_add_rack_header">
                    <h5>
                        <t t-if="state.editMode">
                            <i class="fa fa-pencil me-2"/> Edit Rack
                        </t>
                        <t t-else="">
                            <i class="fa fa-cube me-2"/> Configure Rack
                        </t>
                    </h5>
                    <button class="btn btn-sm btn-light" t-on-click="toggleAddPanel">
                        <i class="fa fa-times"/>
                    </button>
                </div>

                <div class="o_add_rack_body">
                    <div class="o_form_group">
                        <label>Location <span class="text-danger">*</span></label>
                        <select class="form-select form-select-sm"
                                t-model="state.newRack.locationId"
                                t-att-disabled="state.editMode">
                            <option value="">-- Select a location --</option>
                            <t t-foreach="state.availableLocationsGrouped" t-as="group" t-key="group.wid">
                                <optgroup t-att-label="group.name">
                                    <t t-foreach="group.locations" t-as="loc" t-key="loc.id">
                                        <option t-att-value="loc.id" t-esc="loc.complete_name"/>
                                    </t>
                                </optgroup>
                            </t>
                        </select>
                        <small class="text-muted" t-if="state.editMode">
                            Location cannot be changed while editing.
                        </small>
                        <small class="text-muted" t-if="!state.editMode and state.availableLocations.length === 0">
                            No locations available.
                        </small>
                    </div>

                    <div class="o_form_section">
                        <div class="o_form_section_title">
                            <i class="fa fa-arrows-alt me-1"/> Dimensions (m)
                        </div>
                        <div class="o_form_row">
                            <div class="o_form_group">
                                <label>Length (X)</label>
                                <input type="number" step="0.1" min="0.5"
                                       class="form-control form-control-sm"
                                       t-model.number="state.newRack.rack_length"/>
                            </div>
                            <div class="o_form_group">
                                <label>Width (Z)</label>
                                <input type="number" step="0.1" min="0.3"
                                       class="form-control form-control-sm"
                                       t-model.number="state.newRack.rack_width"/>
                            </div>
                            <div class="o_form_group">
                                <label>Height (Y)</label>
                                <input type="number" step="0.1" min="0.5"
                                       class="form-control form-control-sm"
                                       t-model.number="state.newRack.rack_height"/>
                            </div>
                        </div>
                    </div>

                    <div class="o_form_section">
                        <div class="o_form_section_title">
                            <i class="fa fa-th-large me-1"/> Structure
                        </div>
                        <div class="o_form_row">
                            <div class="o_form_group">
                                <label>Shelf Levels</label>
                                <input type="number" min="1" max="20"
                                       class="form-control form-control-sm"
                                       t-model.number="state.newRack.shelf_levels"/>
                            </div>
                            <div class="o_form_group">
                                <label>Bins per Level</label>
                                <input type="number" min="1" max="20"
                                       class="form-control form-control-sm"
                                       t-model.number="state.newRack.bins_per_level"/>
                            </div>
                        </div>
                    </div>

                    <div class="o_form_section">
                        <div class="o_form_section_title">
                            <i class="fa fa-map-marker me-1"/> Position
                        </div>
                        <div class="o_form_row">
                            <div class="o_form_group">
                                <label>Position X</label>
                                <input type="number" step="0.5"
                                       class="form-control form-control-sm"
                                       t-model.number="state.newRack.pos_x"/>
                            </div>
                            <div class="o_form_group">
                                <label>Position Z</label>
                                <input type="number" step="0.5"
                                       class="form-control form-control-sm"
                                       t-model.number="state.newRack.pos_z"/>
                            </div>
                        </div>
                        <div class="o_form_row">
                            <div class="o_form_group">
                                <label>Rotation (°)</label>
                                <input type="number" step="15" min="0" max="360"
                                       class="form-control form-control-sm"
                                       t-model.number="state.newRack.rotation_y"
                                       placeholder="0 = front, 90 = side"/>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="o_add_rack_footer">
                    <button class="btn btn-sm btn-secondary"
                            t-on-click="toggleAddPanel">Cancel</button>
                    <button class="btn btn-sm btn-primary"
                            t-att-disabled="!state.newRack.locationId"
                            t-on-click="createRackFromPanel">
                        <t t-if="state.editMode">
                            <i class="fa fa-save me-1"/> Save Changes
                        </t>
                        <t t-else="">
                            <i class="fa fa-check me-1"/> Create Rack
                        </t>
                    </button>
                </div>
            </div>

            <!-- Status Legend -->
            <div class="o_3d_legend">
                <div class="rounded shadow-lg p-3"
                     style="background: rgba(15, 23, 42, 0.85); color: #ffffff; font-size: 13px; min-width: 140px;">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="rounded-circle d-inline-block" style="width:10px; height:10px; background:#22c55e;"/>
                        <span>In use</span>
                    </div>
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="rounded-circle d-inline-block" style="width:10px; height:10px; background:#f59e0b;"/>
                        <span>Almost full</span>
                    </div>
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="rounded-circle d-inline-block" style="width:10px; height:10px; background:#ef4444;"/>
                        <span>Overloaded</span>
                    </div>
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="rounded-circle d-inline-block" style="width:10px; height:10px; background:#3b82f6;"/>
                        <span>No capacity</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="rounded-circle d-inline-block" style="width:10px; height:10px; background:#9ca3af;"/>
                        <span>Empty</span>
                    </div>
                </div>
            </div>

            <!-- Rack Detail Panel -->
            <div class="o_3d_detail_panel position-absolute bottom-0 end-0 p-3"
                 t-if="state.selectedLocation and !state.addPanelOpen">
                <div class="bg-white rounded shadow-lg p-3 position-relative o_rack_detail_content"
                         style="width: 420px; max-height: 70vh; overflow-y: auto;">
                    <button class="btn btn-sm btn-light"
                            t-on-click="closeDetail"
                            title="Close"
                            style="position: absolute; top: 8px; right: 8px; width: 30px; height: 30px; border: none; border-radius: 6px; background: #f1f5f9; color: #475569; display: flex; align-items: center; justify-content: center; cursor: pointer; z-index: 100; font-size: 14px; padding: 0;">
                        <i class="fa fa-times"/>
                    </button>
                    <h5 t-esc="state.selectedLocation.complete_name"/>

                    <div class="d-flex justify-content-between small">
                        <span t-esc="'On Hand: ' + state.selectedLocation.on_hand"/>
                        <span t-esc="'Capacity: ' + state.selectedLocation.capacity"/>
                        <span t-esc="'Fill: ' + state.selectedLocation.fill_percentage + '%'"/>
                    </div>

                    <div class="progress mt-1" style="height: 12px;">
                        <div class="progress-bar"
                             t-att-class="state.selectedLocation.fill_percentage >= 100 ? 'bg-danger'
                                 : state.selectedLocation.fill_percentage >= 80 ? 'bg-warning'
                                 : state.selectedLocation.fill_percentage > 0 ? 'bg-success'
                                 : 'bg-secondary'"
                             t-att-style="'width:' + Math.min(state.selectedLocation.fill_percentage, 100) + '%'"/>
                    </div>

                    <hr/>

                    <p class="mb-1"><strong>Rack Configuration:</strong></p>
                    <div class="d-flex flex-wrap gap-2 mb-3 small">
                        <span class="badge bg-light text-dark">L: <t t-esc="state.selectedLocation.rack_length"/> m</span>
                        <span class="badge bg-light text-dark">W: <t t-esc="state.selectedLocation.rack_width"/> m</span>
                        <span class="badge bg-light text-dark">H: <t t-esc="state.selectedLocation.rack_height"/> m</span>
                        <span class="badge bg-light text-dark">Levels: <t t-esc="state.selectedLocation.shelf_levels"/></span>
                        <span class="badge bg-light text-dark">Bins/Level: <t t-esc="state.selectedLocation.bins_per_level"/></span>
                        <span class="badge bg-light text-dark">Rot: <t t-esc="state.selectedLocation.rotation_y"/>°</span>
                    </div>

                    <p class="mb-1"><strong>Products Stored:</strong></p>
                    <t t-if="!state.selectedLocation.products_info or state.selectedLocation.products_info.length === 0">
                        <span class="text-muted small">No products stored.</span>
                    </t>
                    <t t-else="">
                        <table class="table table-sm table-borderless mb-0">
                            <tbody>
                                <t t-foreach="state.selectedLocation.products_info.slice(0, 5)"
                                   t-as="prod" t-key="prod.id">
                                    <tr>
                                        <td class="py-1"><span t-esc="prod.name"/></td>
                                        <td class="py-1 text-end" style="width: 90px;">
                                            <span class="badge bg-secondary" t-esc="prod.qty"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <t t-if="state.selectedLocation.products_info.length > 5">
                            <div class="mt-2">
                                <button class="btn btn-sm btn-link p-0"
                                        t-on-click="openLocationProducts"
                                        style="text-decoration: none;">
                                    <i class="fa fa-external-link me-1"/>
                                    Show more
                                </button>
                            </div>
                        </t>
                    </t>

                    <div class="mt-3 d-flex gap-2 o_detail_actions">
                        <button class="btn btn-sm btn-primary" t-on-click="flyToSelected">
                            <t t-if="state.flying">
                                <i class="fa fa-undo me-1"/> Back
                            </t>
                            <t t-else="">
                                <i class="fa fa-plane me-1"/> Fly To
                            </t>
                        </button>

                        <button t-if="state.editRackMode"
                                class="btn btn-sm btn-warning"
                                t-on-click="openEditPanel">
                            <i class="fa fa-pencil me-1"/> Edit
                        </button>

                        <button t-if="state.editRackMode"
                                class="btn btn-sm btn-danger"
                                t-on-click="deleteRack">
                            <i class="fa fa-trash me-1"/> Delete
                        </button>
                    </div>
                </div>
            </div>

            <!-- Product Detail Panel -->
            <div class="o_3d_detail_panel position-absolute bottom-0 end-0 p-3"
                 t-if="state.selectedProduct">
                <div class="o_product_popup">
                    <div class="o_product_popup_header">
                        <div class="o_product_popup_icon">
                            <img t-att-src="state.selectedProduct.image_url"
                                 t-att-alt="state.selectedProduct.name"
                                 class="o_product_popup_img"/>
                        </div>
                        <div class="o_product_popup_titles">
                            <div class="o_product_popup_label">Product</div>
                            <div class="o_product_popup_title" t-esc="state.selectedProduct.name"/>
                        </div>
                        <button class="btn btn-sm btn-light"
                                t-on-click="closeProductDetail"
                                title="Close">
                            <i class="fa fa-times"/>
                        </button>
                    </div>

                    <div class="o_product_popup_body">
                        <div class="o_product_popup_row">
                            <span class="o_product_popup_key">
                                <i class="fa fa-cubes"/> Quantity
                            </span>
                            <span class="o_product_popup_qty"
                                  t-esc="state.selectedProduct.quantity"/>
                        </div>
                        <div class="o_product_popup_row">
                            <span class="o_product_popup_key">
                                <i class="fa fa-map-marker"/> Location
                            </span>
                            <span class="o_product_popup_loc"
                                  t-esc="state.selectedProduct.location_name"/>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</templates>