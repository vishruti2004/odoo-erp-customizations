<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Assign Workout Plan Wizard Form View -->
    <record id="view_gym_workout_plan_assign_wizard_form" model="ir.ui.view">
        <field name="name">gym.workout.plan.assign.wizard.form</field>
        <field name="model">gym.workout.plan.assign.wizard</field>
        <field name="arch" type="xml">
            <form string="Assign Workout Plan">
                <sheet>
                    <div class="oe_title">
                        <h4>Assign Workout Plan</h4>
                    </div>

                    <group>
                        <field name="plan_id" readonly="1"/>
                        <field name="member_ids" widget="many2many_tags" placeholder="Assign To..."/>
                    </group>

                    <group>
                        <group>
                            <field name="start_date" string="Date From"/>
                        </group>
                        <group>
                            <field name="end_date" string="Date To"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_assign" type="object" string="Assign" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>