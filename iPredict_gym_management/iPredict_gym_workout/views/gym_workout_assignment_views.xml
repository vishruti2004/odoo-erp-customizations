<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View -->
    <record id="view_gym_workout_assignment_tree" model="ir.ui.view">
        <field name="name">gym.workout.assignment.list</field>
        <field name="model">gym.workout.assignment</field>
        <field name="arch" type="xml">
            <list string="Workout Assignments">
                <field name="member_id"/>
                <field name="plan_id"/>
                <field name="trainer_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="days"/>
                <field name="state" widget="badge" decoration-success="state == 'active'" decoration-warning="state == 'expiring'" decoration-danger="state == 'expired'"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_gym_workout_assignment_form" model="ir.ui.view">
        <field name="name">gym.workout.assignment.form</field>
        <field name="model">gym.workout.assignment</field>
        <field name="arch" type="xml">
            <form string="Workout Assignment">
                <sheet>
                    <group>
                        <group>
                            <field name="member_id"/>
                            <field name="plan_id"/>
                            <field name="trainer_id"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="days" readonly="1"/>
                            <field name="state" widget="badge" decoration-success="state == 'active'" decoration-warning="state == 'expiring'" decoration-danger="state == 'expired'"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_gym_workout_assignment_search" model="ir.ui.view">
        <field name="name">gym.workout.assignment.search</field>
        <field name="model">gym.workout.assignment</field>
        <field name="arch" type="xml">
            <search string="Search Workout Assignments">

                <!-- Search Fields -->
                <field name="member_id"/>
                <field name="plan_id"/>
                <field name="trainer_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="state"/>

                <!-- Status Filters -->
                <separator/>
                <filter name="active" string="Active" domain="[('state', '=', 'active')]"/>
                <filter name="expiring" string="Expiring Soon" domain="[('state', '=', 'expiring')]"/>
                <filter name="expired" string="Expired" domain="[('state', '=', 'expired')]"/>

                <!-- Group By-->
                <group>
                    <filter name="group_member" string="Member" context="{'group_by':'member_id'}"/>
                    <filter name="group_plan" string="Workout Plan" context="{'group_by':'plan_id'}"/>
                    <filter name="group_trainer" string="Trainer" context="{'group_by':'trainer_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by':'state'}"/>
                    <filter name="group_start_date" string="Start Date" context="{'group_by':'start_date'}"/>
                    <filter name="group_end_date" string="End Date" context="{'group_by':'end_date'}"/>
                </group>

            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_gym_workout_assignment" model="ir.actions.act_window">
        <field name="name">Workout Assignments</field>
        <field name="res_model">gym.workout.assignment</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>