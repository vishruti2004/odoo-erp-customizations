<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================== -->
    <!-- Form View                      -->
    <!-- ============================== -->
    <record id="view_gym_workout_plan_form" model="ir.ui.view">
        <field name="name">gym.workout.plan.form</field>
        <field name="model">gym.workout.plan</field>
        <field name="arch" type="xml">
            <form string="Workout Plan">
                <sheet>
                    <!-- Stat button must live in button_box, not directly in header -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_assign_wizard"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-users">
                            <div class="o_stat_info">
                                <!-- <span class="o_stat_value"><field name="member_count"/></span> -->
                                <span class="o_stat_text">Assign Members</span>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Plan Name..."/>
                        </h1>
                        <field name="code" readonly="1" class="text-muted"/>
                    </div>

                    <group>
                        <field name="days" string="Workout Days"/>
                    </group>

                    <notebook>
                        <page string="Exercise List">
                            <field name="exercise_line_ids">
                                <list editable="bottom">
                                    <field name="exercise_id"/>
                                    <field name="sets"/>
                                    <field name="reps"/>
                                    <field name="rest"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================== -->
    <!-- List View                      -->
    <!-- ============================== -->
    <record id="view_gym_workout_plan_list" model="ir.ui.view">
        <field name="name">gym.workout.plan.list</field>
        <field name="model">gym.workout.plan</field>
        <field name="arch" type="xml">
            <list string="Workout Plans">
                <field name="code" string="Code"/>
                <field name="name" string="Plan Name"/>
                <field name="days"/>
                <!-- <field name="member_ids" widget="many2many_tags" string="Members"/>
                <field name="start_date"/>
                <field name="end_date"/> -->
            </list>
        </field>
    </record>

    <!-- ============================== -->
    <!-- Action                        -->
    <!-- ============================== -->
    <record id="action_gym_workout_plan" model="ir.actions.act_window">
        <field name="name">Workout Plans</field>
        <field name="res_model">gym.workout.plan</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>