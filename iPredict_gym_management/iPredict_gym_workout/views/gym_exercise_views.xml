<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Exercise Form View -->
    <record id="view_gym_exercise_form" model="ir.ui.view">
        <field name="name">gym.exercise.form</field>
        <field name="model">gym.exercise</field>
        <field name="arch" type="xml">
            <form string="Exercise">
                <sheet>
                    <field name="company_id" invisible="1"/>
                    <field name="image" widget="image" class="oe_avatar" options="{'size': [180, 180]}"/>
                    <field name="name" placeholder="Exercise Name..." class="fs-1 fw-bold mb-3"/>

                    <!-- General Information -->
                    <group>
                        <group>
                            <field name="muscle_group"/>
                            <!-- Company-wise Equipment Dropdown -->
                            <field name="equipment_id" domain="['|', ('company_id', '=', False), ('company_id', '=', company_id)]"/>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="video_url" widget="url" placeholder="https://www.youtube.com/..."/>
                        </group>
                    </group>

                    <group>
                        <field name="description" nolabel="1" placeholder="Exercise description..."/>
                    </group>

                    <!-- Steps -->
                    <notebook>
                        <page string="Steps" name="steps">
                            <field name="step_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="image" string="Step Image" widget="image" options="{'size': [60, 60]}"/>
                                    <field name="name"/>
                                    <field name="description" optional="hide"/>
                                </list>

                                <form string="Exercise Step">
                                    <sheet>
                                        <field name="image" widget="image" class="oe_avatar" options="{'size': [180, 180]}"/>
                                        <group>
                                            <group>
                                                <field name="sequence"/>
                                                <field name="name"/>
                                            </group>
                                            <group>
                                                <field name="description"/>
                                            </group>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Exercise List View -->
    <record id="view_gym_exercise_list" model="ir.ui.view">
        <field name="name">gym.exercise.list</field>
        <field name="model">gym.exercise</field>
        <field name="arch" type="xml">
            <list string="Exercises">
                <field name="name"/>
                <field name="muscle_group"/>
                <field name="equipment_id"/>
                <field name="active"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_gym_exercise" model="ir.actions.act_window">
        <field name="name">Exercises</field>
        <field name="res_model">gym.exercise</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>