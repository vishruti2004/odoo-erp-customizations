<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="rule_maintenance_equipment_company" model="ir.rule">
        <field name="name">Gym Equipment: Current Company</field>
        <field name="model_id" ref="maintenance.model_maintenance_equipment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_maintenance_request_company" model="ir.rule">
        <field name="name">Gym Maintenance Request: Current Company</field>
        <field name="model_id" ref="maintenance.model_maintenance_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_repair_order_company" model="ir.rule">
        <field name="name">Gym Repair Order: Current Company</field>
        <field name="model_id" ref="repair.model_repair_order"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>