<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="maintenance_request_view_form_inherit_repair" model="ir.ui.view">
        <field name="name">maintenance.request.view.form.inherit.repair</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_create_repair_request"
                        string="Create Repair Request"
                        type="object"
                        class="oe_highlight"
                        invisible="is_request_done"
                        groups="iPredict_gym_base.group_gym_admin,iPredict_gym_base.group_gym_user"/>
            </xpath>
        </field>
    </record>

</odoo>