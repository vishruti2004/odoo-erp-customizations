<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_product_template_gym_food_form" model="ir.ui.view">
        <field name="name">product.template.gym.food.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">

            <xpath expr="//label[@for='purchase_ok']" position="after">
                <span class="d-inline-flex">
                    <field name="is_gym_food"/>
                    <label for="is_gym_food" />
                </span>
            </xpath>

            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="uom_id"/>
            </xpath>
                    
            <xpath expr="//notebook" position="inside">
                <page string="Diet Info" name="diet_info" invisible="not is_gym_food">
                    <group>
                        <group>
                            <field name="calories"/>
                            <field name="protein"/>
                        </group>
                        <group>
                            <field name="carbs"/>
                            <field name="fat"/>
                        </group>
                    </group>
                </page>
            </xpath>

        </field>
    </record>
  
    <record id="action_gym_food_product" model="ir.actions.act_window">
        <field name="name">Food</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_gym_food', '=', True)]</field>
        <field name="context">{'default_is_gym_food': True}</field>
    </record>

</odoo>
