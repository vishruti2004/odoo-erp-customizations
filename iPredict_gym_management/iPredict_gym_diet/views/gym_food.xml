<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_gym_food_list" model="ir.ui.view">
        <field name="name">product.template.gym.food.list</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>  
        <field name="arch" type="xml">
            
          
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="calories" string="Calories" optional="show"/>
                <field name="protein" string="Protein (g)" optional="show"/>
                <field name="carbs" string="Carbs (g)" optional="show"/>
                <field name="fat" string="Fat (g)" optional="show"/>
            </xpath>

        </field>
    </record>

    <!-- Action – Gym Food Products -->
    <record id="action_gym_food_product" model="ir.actions.act_window">
        <field name="name">Food</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_gym_food', '=', True)]</field>
        <field name="context">{'default_is_gym_food': True}</field>
        <field name="view_id" ref="view_gym_food_list"/>
    </record>

</odoo>