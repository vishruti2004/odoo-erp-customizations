<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_gym_food_list" model="ir.ui.view">
        <field name="name">gym.food.list</field>
        <field name="model">gym.food</field>
        <field name="arch" type="xml">
            <list string="Food Master" editable="bottom">
                <field name="name"/>
                <field name="meal_category"/>
                <field name="calories"/>
                <field name="protein"/>
                <field name="carbs"/>
                <field name="fat"/>
            </list>
        </field>
    </record>

    <record id="view_gym_food_form" model="ir.ui.view">
        <field name="name">gym.food.form</field>
        <field name="model">gym.food</field>
        <field name="arch" type="xml">
            <form string="Food Item">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Oats"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="meal_category"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="calories"/>
                            <field name="protein"/>
                            <field name="carbs"/>
                            <field name="fat"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_gym_food" model="ir.actions.act_window">
        <field name="name">Food Master</field>
        <field name="res_model">gym.food</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>