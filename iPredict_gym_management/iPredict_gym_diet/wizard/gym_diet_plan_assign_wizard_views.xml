<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_gym_diet_plan_assign_wizard_form" model="ir.ui.view">
        <field name="name">gym.diet.plan.assign.wizard.form</field>
        <field name="model">gym.diet.plan.assign.wizard</field>
        <field name="arch" type="xml">
            <form string="Assign Diet Plan">
                <sheet>
                    <div class="oe_title">
                        <h4>Assign Diet Plan</h4>
                    </div>

                    <group>
                        <field name="plan_id" readonly="1"/>
                    </group>

                    <group>
                        <field name="member_ids" widget="many2many_tags" placeholder="Assign To..."/>
                    </group>

                    <group>
                        <group>
                            <field name="start_date" string="Date From"/>
                        </group>
                        <group>
                            <field name="end_date" string="Date To"/>
                        </group>
                    </group>

                    <footer>
                        <button name="action_assign" type="object" string="Assign" class="btn-primary"/>
                        <button name="action_cancel" type="object" string="Cancel" class="btn-secondary"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

</odoo>