<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================== GROUPS ===================== -->

    <record id="res_groups_privilege_gym" model="res.groups.privilege">
        <field name="name">Gym Management</field>
        <field name="sequence">20</field>
        <field name="category_id" ref="base.module_category_hidden"/>
    </record>

    <!-- Trainer Group -->
    <record id="group_gym_trainer" model="res.groups">
        <field name="name">Trainer</field>
        <field name="privilege_id" ref="res_groups_privilege_gym"/>
    </record>

    <!-- Manager Group -->
    <record id="group_gym_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_gym"/>
        <field name="implied_ids" eval="[(4, ref('group_gym_trainer'))]"/>
    </record>

    <!-- Admin Group -->
    <record id="group_gym_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="res_groups_privilege_gym"/>
        <field name="implied_ids" eval="[(4, ref('group_gym_manager'))]"/>
    </record>

    <!-- ===================== RECORD RULES ===================== -->

    <!-- Manager and Admin see ALL members -->
    <record id="rule_gym_manager_see_all_partners" model="ir.rule">
        <field name="name">Gym Manager: See all members</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_gym_manager'))]"/>
    </record>

    <!-- Trainer sees only their own assigned gym members -->
    <record id="rule_gym_trainer_own_partners" model="ir.rule">
        <field name="name">Gym Trainer: See only own assigned members</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="groups" eval="[(4, ref('group_gym_trainer'))]"/>
    </record>

</odoo>