<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_gym" model="ir.module.category">
        <field name="name">Gym Management</field>
        <field name="description">Access rights for the Gym Management modules</field>
        <field name="sequence">20</field>
    </record>

    <!-- Base level: Receptionist -->
    <record id="group_gym_receptionist" model="res.groups">
        <field name="name">Receptionist</field>
        <field name="category_id" ref="module_category_gym"/>
        <field name="comment">Manages inquiries, members, trial sessions, attendance, locker allocation, and visitor records.</field>
    </record>

    <!-- Base level: Trainer -->
    <record id="group_gym_trainer" model="res.groups">
        <field name="name">Trainer</field>
        <field name="category_id" ref="module_category_gym"/>
        <field name="comment">Views assigned members only. Manages workout plans, diet plans, body measurements, and class attendance.</field>
    </record>

    <!-- Mid level: Manager - automatically includes Receptionist + Trainer access -->
    <record id="group_gym_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_gym"/>
        <field name="implied_ids" eval="[(4, ref('group_gym_receptionist')), (4, ref('group_gym_trainer'))]"/>
        <field name="comment">Manages memberships, trainers, classes, attendance, reports, and billing.</field>
    </record>

    <!-- Top level: Administrator - automatically includes Manager (and everything below it) -->
    <record id="group_gym_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_gym"/>
        <field name="implied_ids" eval="[(4, ref('group_gym_manager'))]"/>
        <field name="comment">Full access to all Gym Management modules and configuration.</field>
    </record>

</odoo>