<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ========================================================= -->
    <!-- 1. GYM BLOCKS ON MY ACCOUNT                               -->
    <!-- ========================================================= -->
  <template id="portal_my_home_gym_blocks" inherit_id="portal.portal_my_home" priority="40">
    <xpath expr="//div[@id='portal_alert_category']" position="before">
        <div class="o_portal_category row g-2 mt-3" id="portal_gym_category">
            <t t-if="request.env.user.has_group('base.group_portal') and not request.env.user.has_group('base.group_user') and request.env.user.partner_id.is_gym_member">
                <t t-set="member" t-value="request.env.user.partner_id"/>
                <t t-set="active_membership" t-value="request.env['gym.membership.history'].sudo().search([('member_id', '=', member.id), ('status', '=', 'active')], limit=1)"/>
                <t t-set="workout_plans" t-value="request.env['gym.workout.assignment'].sudo().search([('member_id', '=', member.id)])"/>
                <t t-set="diet_plans" t-value="request.env['gym.diet.assignment'].sudo().search([('member_id', '=', member.id)])"/>
                <t t-set="measurements" t-value="request.env['gym.member.measurement'].sudo().search([('member_ids', '=', member.id)])"/>

                <t t-if="active_membership">
                        <t t-call="portal.portal_docs_entry">
                            <t t-set="icon" t-value="'/iPredict_gym_portal/static/src/img/membership.png'"/>
                            <t t-set="title">Membership</t>
                            <t t-set="url" t-value="'/my/gym/membership'"/>
                            <t t-set="text">View your active membership</t>
                            <t t-set="config_card" t-value="True"/>
                        </t>
                    </t>

                <t t-if="workout_plans">
                    <t t-call="portal.portal_docs_entry">
                        <t t-set="icon" t-value="'/iPredict_gym_portal/static/src/img/workout.png'"/>
                        <t t-set="title">Workout Plans</t>
                        <t t-set="url" t-value="'/my/gym/workout'"/>
                        <t t-set="text">View your assigned workout plans</t>
                        <t t-set="config_card" t-value="True"/>
                    </t>
                </t>

                <t t-if="diet_plans">
                    <t t-call="portal.portal_docs_entry">
                        <t t-set="icon" t-value="'/iPredict_gym_portal/static/src/img/diet.png'"/>
                        <t t-set="title">Diet Plans</t>
                        <t t-set="url" t-value="'/my/gym/diet'"/>
                        <t t-set="text">View your assigned diet plans</t>
                        <t t-set="config_card" t-value="True"/>
                    </t>
                </t>

                <t t-if="measurements">
                    <t t-call="portal.portal_docs_entry">
                        <t t-set="icon" t-value="'/iPredict_gym_portal/static/src/img/measurement.png'"/>
                        <t t-set="title">Measurement History</t>
                        <t t-set="url" t-value="'/my/gym/measurement'"/>
                        <t t-set="text">View your body measurement history</t>
                        <t t-set="config_card" t-value="True"/>
                    </t>
                </t>
            </t>
        </div>
    </xpath>
</template>
    <!-- ========================================================= -->
    <!-- 2. BREADCRUMBS                                            -->
    <!-- ========================================================= -->
    <template id="portal_gym_breadcrumbs" inherit_id="portal.portal_breadcrumbs" priority="30">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'gym_membership'" class="breadcrumb-item active">Membership</li>
            <li t-if="page_name == 'gym_workout'" class="breadcrumb-item active">Workout Plans</li>
            <li t-if="page_name == 'gym_diet'" class="breadcrumb-item active">Diet Plans</li>
            <li t-if="page_name == 'gym_measurement'" class="breadcrumb-item active">Measurement History</li>
        </xpath>
    </template>
    <!-- ========================================================= -->
    <!-- 3. GYM DASHBOARD                                          -->
    <!-- ========================================================= -->
    <template id="gym_dashboard" name="Gym Management Dashboard">
        <t t-call="portal.portal_layout">
            <div class="container my-5">
                <h2 class="mb-4">Gym Management</h2>
                <div class="row g-4" t-if="member">
                    <div class="col-md-6 col-lg-3">
                        <a href="/my/gym/membership" class="text-decoration-none">
                            <div class="card shadow-sm h-100">
                                <div class="card-body">
                                    <h5 class="card-title">Membership</h5>
                                    <p class="text-muted mb-0">View your membership details</p>
                                </div>
                            </div>
                        </a>
                    </div>
                    <div class="col-md-6 col-lg-3">
                        <a href="/my/gym/workout" class="text-decoration-none">
                            <div class="card shadow-sm h-100">
                                <div class="card-body">
                                    <h5 class="card-title">Workout Plans</h5>
                                    <p class="text-muted mb-0">View your workout plans</p>
                                </div>
                            </div>
                        </a>
                    </div>
                    <div class="col-md-6 col-lg-3">
                        <a href="/my/gym/diet" class="text-decoration-none">
                            <div class="card shadow-sm h-100">
                                <div class="card-body">
                                    <h5 class="card-title">Diet Plans</h5>
                                    <p class="text-muted mb-0">View your diet plans</p>
                                </div>
                            </div>
                        </a>
                    </div>
                    <div class="col-md-6 col-lg-3">
                        <a href="/my/gym/measurement" class="text-decoration-none">
                            <div class="card shadow-sm h-100">
                                <div class="card-body">
                                    <h5 class="card-title">Measurement History</h5>
                                    <p class="text-muted mb-0">View your body measurements</p>
                                </div>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
        </t>
    </template>
    <!-- ========================================================= -->
    <!-- 4. MEMBERSHIP HISTORY                                     -->
    <!-- ========================================================= -->
    <template id="gym_membership" name="Gym Membership History">
        <t t-call="portal.portal_layout">
            <div class="container my-5">
                <h2 class="mb-4">Membership History</h2>
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Membership ID</th>
                                <th>Membership Plan</th>
                                <th>Company</th>
                                <th>Start Date</th>
                                <th>End Date</th>
                                <th>Status</th>
                                <th>Remark</th>
                                <th>Updated By</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="histories" t-as="history">
                                <tr>
                                    <td><t t-esc="history.name or ''"/></td>
                                    <td><t t-esc="history.membership_plan_id.name or ''"/></td>
                                    <td><t t-esc="history.company_id.name or ''"/></td>
                                    <td><t t-esc="history.membership_start_date or ''"/></td>
                                    <td><t t-esc="history.membership_end_date or ''"/></td>
                                    <td>
                                        <span t-if="history.status == 'active'" class="badge rounded-pill bg-success text-white">Active</span>
                                        <span t-elif="history.status == 'frozen'" class="badge rounded-pill bg-info text-dark">Frozen</span>
                                        <span t-elif="history.status == 'expired'" class="badge rounded-pill bg-danger text-white">Expired</span>
                                        <span t-elif="history.status == 'cancelled'" class="badge rounded-pill bg-secondary text-white">Cancelled</span>
                                        <span t-else="" class="badge rounded-pill bg-secondary text-white">
                                            <t t-esc="history.status or ''"/>
                                        </span>
                                    </td>
                                    <td><t t-esc="history.remark or ''"/></td>
                                    <td><t t-esc="history.user_id.name or ''"/></td>
                                </tr>
                            </t>
                            <tr t-if="not histories">
                                <td colspan="8" class="text-center text-muted">No membership records found.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </t>
    </template>
    <!-- ========================================================= -->
    <!-- 5. WORKOUT PLANS                                         -->
    <!-- ========================================================= -->
    <template id="gym_workout" name="Gym Workout Plans">
        <t t-call="portal.portal_layout">
            <div class="container my-5">
                <h2 class="mb-4">Workout Plans</h2>
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Plan</th>
                                <th>Member</th>
                                <th>Trainer</th>
                                <th>Start Date</th>
                                <th>End Date</th>
                                <th>Days</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="workout_plans" t-as="workout">
                                <tr>
                                    <td><t t-esc="workout.plan_id.name or ''"/></td>
                                    <td><t t-esc="workout.member_id.name or ''"/></td>
                                    <td><t t-esc="workout.trainer_id.name or ''"/></td>
                                    <td><t t-esc="workout.start_date or ''"/></td>
                                    <td><t t-esc="workout.end_date or ''"/></td>
                                    <td><t t-esc="workout.days or ''"/></td>
                                    <td>
                                        <span t-if="workout.state == 'active'" class="badge rounded-pill bg-success text-white">Active</span>
                                        <span t-elif="workout.state == 'expired'" class="badge rounded-pill bg-danger text-white">Expired</span>
                                        <span t-elif="workout.state == 'cancelled'" class="badge rounded-pill bg-secondary text-white">Cancelled</span>
                                        <span t-elif="workout.state == 'draft'" class="badge rounded-pill bg-warning text-dark">Draft</span>
                                        <span t-else="" class="badge rounded-pill bg-secondary text-white">
                                            <t t-esc="workout.state or ''"/>
                                        </span>
                                    </td>
                                </tr>
                            </t>
                            <tr t-if="not workout_plans">
                                <td colspan="7" class="text-center text-muted">No workout plans found.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </t>
    </template>
    <!-- ========================================================= -->
    <!-- 6. DIET PLANS                                            -->
    <!-- ========================================================= -->
    <template id="gym_diet" name="Gym Diet Plans">
        <t t-call="portal.portal_layout">
            <div class="container my-5">
                <h2 class="mb-4">Diet Plans</h2>
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Diet Plan</th>
                                <th>Member</th>
                                <th>Start Date</th>
                                <th>End Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="diet_plans" t-as="diet">
                                <tr>
                                    <td><t t-esc="diet.plan_id.name or ''"/></td>
                                    <td><t t-esc="diet.member_id.name or ''"/></td>
                                    <td><t t-esc="diet.start_date or ''"/></td>
                                    <td><t t-esc="diet.end_date or ''"/></td>
                                    <td>
                                        <span t-if="diet.state == 'active'" class="badge rounded-pill bg-success text-white">Active</span>
                                        <span t-elif="diet.state == 'expired'" class="badge rounded-pill bg-danger text-white">Expired</span>
                                        <span t-elif="diet.state == 'cancelled'" class="badge rounded-pill bg-secondary text-white">Cancelled</span>
                                        <span t-elif="diet.state == 'draft'" class="badge rounded-pill bg-warning text-dark">Draft</span>
                                        <span t-else="" class="badge rounded-pill bg-secondary text-white">
                                            <t t-esc="diet.state or ''"/>
                                        </span>
                                    </td>
                                </tr>
                            </t>
                            <tr t-if="not diet_plans">
                                <td colspan="5" class="text-center text-muted">No diet plans found.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </t>
    </template>
    <!-- ========================================================= -->
    <!-- 7. MEASUREMENT HISTORY                                   -->
    <!-- ========================================================= -->
    <template id="gym_measurement" name="Gym Measurement History">
        <t t-call="portal.portal_layout">
            <div class="container my-5">
                <h2 class="mb-4">Measurement History</h2>
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Member</th>
                                <th>Company</th>
                                <th>Weight (kg)</th>
                                <th>Height (cm)</th>
                                <th>BMI</th>
                                <th>BMR</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="measurements" t-as="measurement">
                                <tr>
                                    <td><t t-esc="measurement.measurement_date or ''"/></td>
                                    <td><t t-esc="measurement.member_ids.name or ''"/></td>
                                    <td><t t-esc="measurement.company_id.name or ''"/></td>
                                    <td><t t-esc="'%.2f' % measurement.weight if measurement.weight else ''"/></td>
                                    <td><t t-esc="'%.2f' % measurement.height if measurement.height else ''"/></td>
                                    <td><t t-esc="'%.2f' % measurement.bmi if measurement.bmi else ''"/></td>
                                    <td><t t-esc="'%.2f' % measurement.bmr if measurement.bmr else ''"/></td>
                                </tr>
                            </t>
                            <tr t-if="not measurements">
                                <td colspan="7" class="text-center text-muted">No measurement records found.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </t>
    </template>

    <template id="gym_membership_in_account" inherit_id="portal.side_content">
    <xpath expr="//a[@href='/my/account']" position="after">
        <t t-set="active_membership"
           t-value="request.env['gym.membership.history'].sudo().search([
               ('member_id', '=', user_id.partner_id.id),
               ('status', '=', 'active')
           ], order='membership_start_date desc, id desc', limit=1)"/>
<div t-if="active_membership"
     class="mt-3 p-3"
     style="background-color: #1c8d3e;
            border: 1px solid #e5e7eb;
            border-radius: 10px;
            width: 100%;">
    <div style="font-size: 13px;
                color: #d9e0e7;
                margin-bottom: 4px;">
        <i class="fa fa-id-card-o me-2"/>
        ACTIVE MEMBERSHIP
    </div>

    <div style="font-size: 17px;
                font-weight: 600;
                color: #212529;">
        <span t-esc="active_membership.membership_plan_id.name"/>
    </div>
</div>


    </xpath>
</template>
</odoo>