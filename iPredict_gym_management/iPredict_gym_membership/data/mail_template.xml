<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="mail_template_membership_freeze_request" model="mail.template">

            <field name="name">Membership Freeze Request</field>
            <field name="model_id" ref="base.model_res_partner"/>

            <field name="subject">
                Membership Freeze Request - {{ object.member_code }}
            </field>

            <field name="email_from">{{ user.email_formatted }}</field>
            <field name="email_to"></field>

            <field name="body_html" type="html">

<div style="margin:0;padding:30px;background:#f4f6f9;font-family:Arial,sans-serif;">

    <div style="max-width:700px;margin:0 auto;background:#ffffff;border-radius:10px;overflow:hidden;border:1px solid #e5e5e5;">

        <!-- Header -->
        <div style="background:#714B67;padding:30px;text-align:center;">

            <h2 style="margin:0;color:#ffffff;font-size:26px;">
                Membership Freeze Request
            </h2>

            <p style="margin:10px 0 0;color:#efe5ee;font-size:15px;">
                Approval Required
            </p>

        </div>

        <!-- Body -->
        <div style="padding:35px;">

            <p style="margin-top:0;font-size:15px;color:#444;">
                Dear Manager,
            </p>

            <p style="font-size:14px;color:#666;line-height:24px;">
                A gym member has submitted a request to temporarily freeze their membership.
                Please review the details below before taking further action.
            </p>

            <!-- Member Information -->
            <div style="margin-top:30px;border:1px solid #ececec;border-radius:8px;padding:20px;background:#fafafa;">

                <h3 style="margin:0 0 18px;color:#714B67;font-size:18px;">
                    Member Information
                </h3>

                <p style="margin:8px 0;">
                    <strong>Member Name :</strong>
                    <t t-out="object.name"/>
                </p>

                <p style="margin:8px 0;">
                    <strong>Member Code :</strong>
                    <t t-out="object.member_code"/>
                </p>

                <p style="margin:8px 0;">
                    <strong>Membership Plan :</strong>
                    <t t-out="object.membership_plan_id.name"/>
                </p>

            </div>

            <!-- Current Membership -->
            <div style="margin-top:25px;border-left:5px solid #714B67;background:#f8f9fc;padding:20px;border-radius:6px;">

                <h3 style="margin:0;color:#714B67;font-size:18px;">
                    Current Membership
                </h3>

                <p style="margin:15px 0 0;font-size:17px;font-weight:bold;color:#333;">
                    <t t-out="object.membership_start_date"/>
                    -
                    <t t-out="object.membership_end_date"/>
                </p>

            </div>

            <!-- Freeze Request -->
            <div style="margin-top:20px;border-left:5px solid #f39c12;background:#fff8ee;padding:20px;border-radius:6px;">

                <h3 style="margin:0;color:#d68910;font-size:18px;">
                    Requested Freeze Duration
                </h3>

                <p style="margin:15px 0 8px;font-size:17px;font-weight:bold;color:#333;">
                    <t t-out="object.freeze_start_date"/>
                    -
                    <t t-out="object.freeze_end_date"/>
                </p>

                <p style="margin:0;color:#555;">
                    <strong>Freeze Days :</strong>
                    <t t-out="object.freeze_days"/>
                </p>

            </div>

            <!-- Button -->
            <div style="text-align:center;margin-top:35px;">

                <a t-attf-href="#"
                   style="background:#714B67;
                          color:#ffffff;
                          text-decoration:none;
                          padding:14px 32px;
                          border-radius:6px;
                          display:inline-block;
                          font-size:15px;
                          font-weight:bold;">

                    Review Membership

                </a>

            </div>

            <p style="margin-top:35px;font-size:14px;color:#666;line-height:22px;">
                Thank you for reviewing this request.
            </p>

        </div>

        <!-- Footer -->
        <div style="background:#fafafa;border-top:1px solid #ececec;padding:20px;text-align:center;">

            <p style="margin:0;font-size:12px;color:#999;">
                This is an automated notification generated by Odoo.
            </p>

            <p style="margin-top:8px;font-size:14px;color:#714B67;font-weight:bold;">
                <t t-out="object.company_id.name"/>
            </p>

        </div>

    </div>

</div>

            </field>

        </record>

    </data>
</odoo>