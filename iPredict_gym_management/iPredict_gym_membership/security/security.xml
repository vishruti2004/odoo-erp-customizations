<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--gym.membership.history -->

    <!-- Manager (and Admin) see ALL history -->
    <record id="rule_gym_manager_see_all_history" model="ir.rule">
        <field name="name">Gym Manager: See all membership history</field>
        <field name="model_id" ref="model_gym_membership_history"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('iPredict_gym_base.group_gym_manager'))]"/>
    </record>

    <!-- Trainer: Only own members' history -->
    <record id="rule_gym_trainer_own_history" model="ir.rule">
        <field name="name">Gym Trainer: Own Members History</field>
        <field name="model_id" ref="model_gym_membership_history"/>
        <field name="domain_force">[('member_id.trainer_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('iPredict_gym_base.group_gym_trainer'))]"/>
    </record>

</odoo>