<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Frozen Members List View -->
    <record id="view_gym_frozen_members_list" model="ir.ui.view">
        <field name="name">gym.membership.freeze.frozen.members.list</field>
        <field name="model">gym.membership.freeze</field>
        <field name="arch" type="xml">
            <list string="Frozen Members" create="0">
                <field name="partner_id" string="Member"/>
                <field name="membership_plan_id" string="Membership Plan"/>
                <field name="freeze_start_date" string="Start Date"/>
                <field name="freeze_end_date" string="End Date"/>
                <field name="state"
                       widget="badge"
                       decoration-muted="state == 'draft'"
                       decoration-info="state == 'pending'"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <!-- Frozen Members Action -->
    <record id="action_gym_frozen_members" model="ir.actions.act_window">
        <field name="name">Frozen Members</field>
        <field name="res_model">gym.membership.freeze</field>
        <field name="domain">[]</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_gym_frozen_members_list"/>
    </record>

</odoo>