<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Members -->
    <menuitem
        id="menu_gym_members"
        name="Members"
        parent="iPredict_gym_base.menu_gym_root"
        action="action_gym_members"
        sequence="10"/>

    <!-- Configuration -->
    <menuitem
        id="menu_gym_configuration"
        name="Configuration"
        parent="iPredict_gym_base.menu_gym_root"
        sequence="100"/>

    <!-- Membership Plans -->
    <menuitem
        id="menu_gym_membership_plan"
        name="Membership Plans"
        parent="menu_gym_configuration"
        action="action_gym_membership_plan"
        sequence="10"/>

          <!-- Action -->
    <record id="action_gym_trainers" model="ir.actions.act_window">
        <field name="name">Trainers</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_gym_trainer','=',True)]</field>
        <field name="context">{'default_is_gym_trainer': True}</field>
    </record>

    <!-- Menu -->
    <menuitem
        id="menu_gym_trainers"
        name="Trainers"
        parent="iPredict_gym_base.menu_gym_root"
        action="action_gym_trainers"
        sequence="20"/>

</odoo>