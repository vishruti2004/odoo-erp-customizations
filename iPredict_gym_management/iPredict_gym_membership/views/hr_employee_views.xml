<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Employee Form View-->
    <record id="view_hr_employee_form_inherit_gym" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.gym</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_assigned_members"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-users"
                        invisible="not is_trainer">
                    <div class="o_stat_info">
                        <field name="member_count" string="Members" class="o_stat_value"/>
                    </div>
                </button>
            </xpath>

            <xpath expr="//div[hasclass('oe_title')]" position="after">

                <group col="2" class="mt-2">

                    <field name="is_trainer"/>

                    <field name="trainer_code"
                        readonly="1"
                        invisible="not is_trainer"/>

                    <field name="member_ids"
                        widget="many2many_tags"
                        string="Assigned Members"
                        domain="[
                            ('is_gym_member', '=', True),
                            ('company_id', '=', company_id)
                        ]"
                        options="{'no_create': True}"
                        invisible="not is_trainer"
                        placeholder="Select Members..."/>

                </group>

            </xpath>

        </field>
    </record>

    <!-- Trainers List View -->
    <record id="view_gym_trainers_list" model="ir.ui.view">
        <field name="name">gym.trainers.list</field>
        <field name="model">hr.employee</field>
        <field name="arch" type="xml">
            <list string="Trainers">
                <field name="trainer_code" string="Trainer ID"/>
                <field name="name" string="Trainer Name"/>
                <field name="work_phone" string="Phone"/>
                <field name="work_email" string="Email"/>
                <field name="member_ids" widget="many2many_tags" string="Assigned Members"/>
                <field name="skill_ids" widget="many2many_tags" string="Skills"/>
            </list>
        </field>
    </record>

    <!-- Trainers Action -->
    <record id="action_gym_trainers" model="ir.actions.act_window">
        <field name="name">Trainers</field>
        <field name="res_model">hr.employee</field>
        <field name="domain">[('is_trainer', '=', True)]</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_gym_trainers_list"/>
    </record>

</odoo>