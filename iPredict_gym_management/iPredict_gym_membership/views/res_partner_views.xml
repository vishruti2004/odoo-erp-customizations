<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form_inherit_gym_membership" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.gym.membership</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <!-- Freeze Membership Stat Button -->
            <xpath expr="//div[@name='button_box']/*[1]" position="before">

                <button name="action_freeze_membership"
                type="object"
                class="oe_stat_button"
                icon="fa-pause-circle">
                <span>Freeze Membership</span>
                </button>
            </xpath>

            <!-- Gym Membership Tab -->
            <xpath expr="//notebook" position="inside">
                <page string="Gym Membership"
                      invisible="not is_gym_member">
                    <group>
                        <group>
                            <field name="member_code" readonly="1"/>
                            <field name="membership_plan_id"/>
                            <field name="work_schedule_id"/>
                            <field name="membership_start_date"/>
                            <field name="membership_end_date"/>
                            <field name="remaining_days" readonly="1"/>
                            <field name="trainer_id" widget="many2many_tags" string="Assign Trainer"/>
                            <field name="is_frozen"/>

                        </group>

                        <!-- <group>
                            <field name="auto_renew"/>
                            <field name="freeze_start_date"/>
                            <field name="freeze_end_date"/>
                            <field name="freeze_days" readonly="1"/>
                        </group> -->
                    </group>

                    <separator string="Notes"/>

                    <field name="notes"
                           nolabel="1"
                           placeholder="Enter membership notes here..."/>

                    <separator string="Membership History"/>

                    <field name="membership_history_ids"
                           nolabel="1"
                           mode="list,form"
                           readonly="1">

                        <list default_order="membership_start_date desc"
                              create="0"
                              edit="0"
                              delete="1">
                            <field name="name"/>
                            <field name="membership_plan_id"/>
                            <field name="membership_start_date"/>
                            <field name="membership_end_date"/>
                            <field name="status"
                                   widget="badge"
                                   decoration-success="status == 'active'"
                                   decoration-warning="status == 'frozen'"
                                   decoration-danger="status == 'expired'"
                                   decoration-muted="status == 'cancelled'"/>
                            <field name="remark"/>
                            <field name="user_id"/>
                        </list>

                        <form string="Membership History">
                            <sheet>
                                <group>
                                    <group>
                                        <field name="membership_plan_id" readonly="1"/>
                                        <field name="status" readonly="1"/>
                                        <field name="user_id" readonly="1"/>
                                    </group>

                                    <group>
                                        <field name="membership_start_date" readonly="1"/>
                                        <field name="membership_end_date"/>
                                    </group>
                                </group>

                                <group>
                                    <field name="remark" readonly="1"/>
                                </group>
                            </sheet>
                        </form>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>