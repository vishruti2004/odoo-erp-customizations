<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================================================================== -->
    <!-- MEMBERS LIST VIEW                                                     -->
    <!-- ===================================================================== -->

    <record id="view_gym_members_list" model="ir.ui.view">
        <field name="name">res.partner.gym.members.list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="Gym Members" create="0">
                <field name="member_code" string="Member ID"/>
                <field name="name" string="Member Name"/>
                <field name="membership_plan_id" string="Membership Plan"/>
                <field name="membership_start_date" string="Start Date"/>
                <field name="membership_end_date" string="End Date"/>
                <field name="is_frozen" string="Frozen"/>
                <field name="remaining_days" string="Remaining Days"/>
            </list>
        </field>
    </record>


    <!-- ===================================================================== -->
    <!-- MEMBERS KANBAN VIEW                                                   -->
    <!-- ===================================================================== -->

    <record id="view_gym_members_kanban" model="ir.ui.view">
        <field name="name">res.partner.gym.members.kanban</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile o_kanban_dashboard">
                <!-- Fields used by Kanban -->
                <field name="member_code"/>
                <field name="name"/>
                <field name="membership_plan_id"/>
                <field name="membership_start_date"/>
                <field name="membership_end_date"/>
                <field name="is_frozen"/>
                <field name="remaining_days"/>

                <templates>
                    <t t-name="card">
<div t-attf-class="oe_kanban_global_click o_kanban_card shadow-sm rounded p-3
    #{record.is_frozen.raw_value ? 'border border-info' : record.remaining_days.raw_value &lt;= 0 ? 'border border-danger' : 'border border-success'}">                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <strong class="fs-5 fw-bold text-dark">
                                    <field name="name"/>
                                </strong>
                                <span class="badge text-bg-secondary">
                                    <field name="member_code"/>
                                </span>
                            </div>

                            <div class="border-top mb-2"/>

                            <div class="text-muted small mb-1">
                                <i class="fa fa-credit-card me-1" title="Plan"/>
                                <field name="membership_plan_id"/>
                            </div>

                            <div class="text-muted small">
                                <i class="fa fa-calendar me-1" title="Duration"/>
                                <field name="membership_start_date"/>
                                <span class="mx-1">-</span>
                                <field name="membership_end_date"/>
                            </div>

                            <div class="text-muted small mt-1">
                                <i class="fa fa-clock-o me-1" title="Remaining Days"/>
                                <field name="remaining_days"/>
                                <span class="ms-1">days remaining</span>
                            </div>

                            <div class="d-flex justify-content-end mt-3">
                                <t t-if="record.is_frozen.raw_value">
                                    <span class="badge text-bg-info">Frozen</span>
                                </t>
                                <t t-elif="record.remaining_days.raw_value &lt;= 0">
                                    <span class="badge text-bg-danger">Expired</span>
                                </t>
                                <t t-else="">
                                    <span class="badge text-bg-success">Active</span>
                                </t>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>


    <!-- ===================================================================== -->
    <!-- MEMBERS ACTION                                                        -->
    <!-- ===================================================================== -->

    <record id="action_gym_members" model="ir.actions.act_window">
        <field name="name">Members</field>
        <field name="res_model">res.partner</field>
        <field name="domain">[('is_gym_member', '=', True)]</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {
                'view_mode': 'kanban',
                'view_id': ref('view_gym_members_kanban')
            }),
            (0, 0, {
                'view_mode': 'list',
                'view_id': ref('view_gym_members_list')
            }),
            (0, 0, {
                'view_mode': 'form',
                'view_id': ref('base.view_partner_form')
            })
        ]"/>
    </record>

</odoo>