<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--  Members List View -->
    <record id="view_gym_members_list" model="ir.ui.view">
        <field name="name">gym.membership.history.members.list</field>
        <field name="model">gym.membership.history</field>
        <field name="arch" type="xml">
            <list string="Gym Members" create="0">
                <field name="display_member_id" string="Member ID"/>
                <field name="member_id" string="Member Name"/>
                <field name="membership_plan_id" string="Membership Plan"/>
                <field name="membership_start_date" string="Start Date"/>
                <field name="membership_end_date" string="End Date"/>
                <field name="status"
                       string="Status"
                       widget="badge"
                       decoration-success="status == 'active'"
                       decoration-info="status == 'frozen'"
                       decoration-danger="status == 'expired'"
                       decoration-muted="status == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_gym_members_kanban" model="ir.ui.view">
        <field name="name">gym.membership.history.members.kanban</field>
        <field name="model">gym.membership.history</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile o_kanban_dashboard">
                <field name="member_id"/>
                <field name="display_member_id"/>
                <field name="membership_plan_id"/>
                <field name="membership_start_date"/>
                <field name="membership_end_date"/>
                <field name="status"/>

                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_global_click o_kanban_card shadow-sm rounded p-3 #{
                            record.status.raw_value == 'frozen' ? 'border border-info' :
                            record.status.raw_value == 'expired' ? 'border border-danger' :
                            record.status.raw_value == 'cancelled' ? 'border border-secondary' :
                            'border border-success'
                        }">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <strong class="fs-5 fw-bold text-dark">
                                    <field name="member_id"/>
                                </strong>
                                <field name="display_member_id" class="badge text-bg-secondary"/>
                            </div>

                            <div class="border-top mb-2"></div>

                            <div class="text-muted small mb-1">
                                <i class="fa fa-credit-card me-1"/>
                                <field name="membership_plan_id"/>
                            </div>

                            <div class="text-muted small">
                                <i class="fa fa-calendar me-1"/>
                                <field name="membership_start_date"/>
                                <span class="mx-1">-</span>
                                <field name="membership_end_date"/>
                            </div>

                            <div class="d-flex justify-content-end mt-3">
                                <t t-if="record.status.raw_value == 'frozen'">
                                    <span class="badge text-bg-info">Frozen</span>
                                </t>
                                <t t-elif="record.status.raw_value == 'expired'">
                                    <span class="badge text-bg-danger">Expired</span>
                                </t>
                                <t t-elif="record.status.raw_value == 'cancelled'">
                                    <span class="badge text-bg-secondary">Cancelled</span>
                                </t>
                                <t t-else="">
                                    <span class="badge text-bg-success">Active</span>
                                </t>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- #Action                 -->
    <record id="action_gym_members" model="ir.actions.act_window">
        <field name="name">Members</field>
        <field name="res_model">gym.membership.history</field>
        <field name="domain">[('status', '=', 'active')]</field>
        <field name="view_mode">kanban,list</field>
        <field name="view_id" ref="view_gym_members_list"/>
    </record>

</odoo>