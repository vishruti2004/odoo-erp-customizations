<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Assign Locker Wizard Form View -->
    <record id="view_gym_member_locker_wizard_form" model="ir.ui.view">
        <field name="name">gym.member.locker.wizard.form</field>
        <field name="model">gym.member.locker.wizard</field>
        <field name="arch" type="xml">
            <form string="Assign Locker">
                <sheet>
                    <group>
                        <group>
                            <field name="member_id" readonly="1"/>
                            <field name="locker_id"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_assign_locker" type="object" string="Assign Locker" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>