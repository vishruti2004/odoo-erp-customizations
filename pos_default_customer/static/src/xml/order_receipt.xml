<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.ReceiptHeader" t-inherit-mode="extension">
        <xpath expr="//div[contains(@class, 'cashier')]/div" position="after">
            <t t-if="this.deliveryDate">
                <div style="text-align:center; margin-top:2px; font-size:11px;">
                    <div>Estimated Delivery On: <t t-esc="this.deliveryDate"/></div>          
                </div>
            </t>
        </xpath>
    </t>
</templates>
