<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="point_of_sale.OrderReceipt" t-inherit-mode="replace">
        <div class="receipt order-receipt">
            <ReceiptHeader header="header"/>
            <div class="cashier">
                <t t-esc="header.cashier"/>
            </div>
            <div t-if="deliveryEstimate" class="delivery" style="text-align:center; margin-top:5px;">
                <strong>Estimated Delivery:</strong> <t t-esc="deliveryEstimate"/>
            </div>
            <OrderDisplay order="order"/>
            <div class="tax" t-if="order.payment_ids.length">
                <t t-foreach="paymentLines" t-as="payment" t-key="payment.id">
                    <div class="paymentline">
                        <span><t t-esc="payment.payment_method_id.name"/></span>
                        <span><t t-esc="formatCurrency(payment.amount)"/></span>
                    </div>
                </t>
            </div>
            <div class="total" t-if="order.lines.length">
                <strong>Total:</strong> <t t-esc="formatCurrency(order.priceIncl)"/>
            </div>
        </div>
    </t>
</templates>