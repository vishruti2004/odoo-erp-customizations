<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="point_of_sale.DeliveryBoyList">
        <Dialog bodyClass="'partner-list p-0'" title="'Select Delivery Boy'">
            <div class="h-100">
                <table class="table table-hover">
                    <tbody>
                        <t t-foreach="state.deliveryBoys" t-as="boy" t-key="boy.id">
                           <tr class="partner-line" t-on-click="() => this.clickDeliveryBoy(boy)">
                                <td class="p-3">
                                    <span class="fw-bold" t-esc="boy.name"/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-secondary" t-on-click="props.close">Discard</button>
            </t>
        </Dialog>
    </t>
</templates>