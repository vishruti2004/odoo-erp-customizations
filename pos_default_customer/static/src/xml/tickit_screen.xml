<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.TicketScreen" t-inherit-mode="extension">
        
        <xpath expr="//table/tbody/t/tr/td[3]" position="after">
            <td class="align-middle">
                <div class="small text-muted">Estimate Delivery On</div>
                <div class="fw-bolder">
                    <t t-if="order.estimated_delivery_final">
                        <t t-esc="order.estimated_delivery_final.toFormat('dd/MM/yyyy')"/>
                        <t t-esc="' '"/> 
                        <t t-esc="order.estimated_delivery_final.toFormat('HH:mm')"/>
                    </t>
                    <t t-else="">-</t>
                </div>
            </td>
        </xpath>

    </t>
</templates>