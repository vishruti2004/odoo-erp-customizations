<odoo>
    <record id="view_pos_order_tree_inherit" model="ir.ui.view">
        <field name="name">pos.order.list.inherit</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_order']" position="after">
                
                <field name="estimated_delivery_final" 
                       widget="datetime" 
                       options="{'timezone': 'user'}"
                       string="Estimated Delivery Date"
                       optional="hide"/>

                <field name="delivery_boy_id" widget="many2one_avatar_user" string="Delivery Boy"/>

            </xpath>
        </field>
    </record>

    <record id="view_pos_order_form_inherit" model="ir.ui.view">
        <field name="name">pos.order.form.inherit</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_order']" position="after">
                
                <field name="estimated_delivery_final" readonly="1"
                       string="Estimated Delivery Date"/>
                <field name="delivery_boy_id" widget="many2one_avatar_user" readonly="1" string="Delivery Boy"/>

            </xpath>
        </field>
    </record>
</odoo>