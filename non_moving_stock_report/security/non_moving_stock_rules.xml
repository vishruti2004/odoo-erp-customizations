<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="rule_non_moving_stock_company" model="ir.rule">
        <field name="name">Non-Moving Stock: allowed companies</field>
        <field name="model_id" ref="model_non_moving_stock_report"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>
</odoo>
