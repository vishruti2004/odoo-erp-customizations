<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Attendance vs Timesheet Discrepancy Email Template -->
        <record id="email_template_timesheet" model="mail.template">
            <field name="name">Attendance Notification: Hours Discrepancy</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="subject">Attendance Notification: Daily Working Hours Update</field>
            <field name="email_from">{{ object.company_id.email_formatted }}</field>
            <field name="email_to">{{ object.work_email }}</field>            
            <field name="body_html" type="html">
                <div style="margin:0; padding:0;">
                    <div style="max-width:600px; margin:30px auto; background:#ffffff; border-radius:10px; overflow:hidden; box-shadow:0 2px 8px rgba(0,0,0,0.1);">

                        <div style="background-color:#875A7B; padding:30px; text-align:center;">
                            <p style="color:#f0e0ff; margin:0; font-size:14px; font-family:Arial, sans-serif;">
                                Daily Working Hours Update
                            </p>
                        </div>

                        <div style="padding:30px; font-family:Arial, sans-serif;">
                            <p style="font-size:16px; color:#333;">
                                Dear <strong><t t-out="object.name"/></strong>,
                            </p>
                            <p style="font-size:14px; color:#555; line-height:1.6;">
                                We noticed a difference between your <strong>attendance hours</strong> and
                                <strong>timesheet hours</strong> for <strong><t t-out="ctx.get('target_date')"/></strong>.
                                Please review and update your timesheet accordingly.
                            </p>

                            <!-- Summary Box -->
                            <div style="background:#f9f4fb; border-left:4px solid #875A7B; border-radius:6px; padding:20px; margin:20px 0;">
                                <h3 style="color:#875A7B; margin:0 0 15px 0; font-size:16px;">
                                    <i class="fa fa-bar-chart" style="margin-right:8px;"></i> Attendance Summary
                                </h3>
                                <table style="width:100%; border-collapse:collapse;">
                                    <!-- Attendance Row -->
                                    <tr style="background:#fff;">
                                        <td style="padding:10px 15px; font-size:14px; color:#555; width:60%;">
                                            <i class="fa fa-clock-o" style="margin-right:6px; color:#875A7B;"></i> Attendance Hours (Check-in/out)
                                        </td>
                                        <td style="padding:10px 15px; font-size:14px; font-weight:bold; color:#27ae60; text-align:right;">
                                            <t t-out="ctx.get('attendance_hours')"/> hrs
                                        </td>
                                    </tr>
                                    <!-- Timesheet Row -->
                                    <tr style="background:#fff3f3;">
                                        <td style="padding:10px 15px; font-size:14px; color:#555;">
                                            <i class="fa fa-pencil-square-o" style="margin-right:6px; color:#e74c3c;"></i> Timesheet Hours
                                        </td>
                                        <td style="padding:10px 15px; font-size:14px; font-weight:bold; color:#e74c3c; text-align:right;">
                                            <t t-out="ctx.get('timesheet_hours')"/> hrs
                                        </td>
                                    </tr>
                                    <!-- Difference Row -->
                                    <tr style="background:#fffbe6;">
                                        <td style="padding:10px 15px; font-size:14px; color:#555;">
                                            <i class="fa fa-exclamation-triangle" style="margin-right:6px; color:#f39c12;"></i> Difference
                                        </td>
                                        <td style="padding:10px 15px; font-size:14px; font-weight:bold; color:#f39c12; text-align:right;">
                                            <t t-out="ctx.get('hour_diff_display')"/>
                                        </td>
                                    </tr>
                                </table>
                            </div>

                            <!-- Warning Message Logic -->
                            <p style="font-size:14px; color:#e74c3c; font-weight:bold; line-height:1.6;">
                                <t t-if="ctx.get('is_short')">
                                    Your timesheet is short by <t t-out="ctx.get('hour_diff_display')"/>. Please update it as soon as possible.
                                </t>
                                <t t-else="">
                                    Your timesheet hours (<t t-out="ctx.get('timesheet_hours')"/> hrs) exceed your attendance hours (<t t-out="ctx.get('attendance_hours')"/> hrs) by <t t-out="ctx.get('hour_diff_display')"/>. Please review and keep it updated.
                                </t>
                            </p>

                            <!-- Call to Action Button -->
                            <div style="text-align:center; margin:25px 0;">
                                <a t-att-href="object.get_base_url() + '/web#action=hr_timesheet.act_hr_timesheet_line&amp;model=account.analytic.line&amp;view_type=list'"
                                   style="background-color:#875A7B; color:#ffffff; padding:14px 30px; text-decoration:none; border-radius:25px; font-size:14px; font-weight:bold; display:inline-block;">
                                    <i class="fa fa-calendar-check-o" style="margin-right:8px;"></i> Update My Timesheet
                                </a>
                            </div>
                        </div>

                        <!-- Footer Section -->
                        <div style="background:#f8f8f8; padding:20px; text-align:center; border-top:1px solid #eee;">
                            <p style="margin:0; font-size:12px; color:#999; font-family:Arial, sans-serif;">
                                This is an automated message from HR Department. Please do not reply to this email.
                            </p>
                            <p style="margin:5px 0 0 0; font-size:12px; color:#875A7B; font-weight:bold; font-family:Arial, sans-serif;">
                                <t t-out="object.company_id.name"/>
                            </p>
                        </div>

                    </div>
                </div>
            </field>
        </record>
    </data>
</odoo>