<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_form_location" model="ir.ui.view">
        <field name="name">sale.order.form.location</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list//field[@name='product_template_id']" position="after">               
             <field name="location_id" invisible="1" optional="hide"/>
                <field name="location_domain_ids" invisible="1" optional="hide"/>
                <field name="location_ids"
                       string="Locations"
                       domain="[('id', 'in', location_domain_ids)]"
                       context="{'show_location_qty': True, 'product_id': product_id}"
                       options="{'no_create': True}"
                       widget="many2many_tags"
                       optional="show"/>
            </xpath>           
        </field>
    </record>
    
    <record id="view_order_form_inherit_commission" model="ir.ui.view">
    <field name="name">sale.order.form.inherit.commission</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="arch" type="xml">
        <xpath expr="//field[@name='order_line']/list/field[@name='price_subtotal']" position="after">
            <field name="sp_commission_amount" sum="Total Commission"/>
        </xpath>
    </field>
</record>
</odoo>