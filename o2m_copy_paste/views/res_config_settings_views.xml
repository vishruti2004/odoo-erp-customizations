<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form_o2m_copy_paste" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.o2m.copy.paste</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//block[@name='users_setting_container']" position="after">

                <block title="O2M Copy/Paste"
                       name="o2m_copy_paste_setting_container">

                    <setting string="Preserve Field Values on Copy/Paste"
                            help="Preserve the current values of fields marked with copy=False when copying and pasting One2many lines.">
                        <field name="o2m_copy_false_fields"/>
                    </setting>

                </block>

            </xpath>

        </field>
    </record>
</odoo>