<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form_o2m_copy_paste" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.o2m.copy.paste</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//block[@name='users_setting_container']" position="after">

                <block title="O2M Copy/Paste"
                       name="o2m_copy_paste_setting_container">

                   <setting string="Enable One2many Copy/Paste"
                            help="Allows copying and pasting One2many lines from List View using Ctrl+C and Ctrl+V.">
                        <field name="o2m_copy_paste_enabled"/>
                    </setting>

                    <setting string="Preserve Copied Field Values"
                            help="Keeps the current values of fields marked as copy=False when pasting One2many lines."
                            invisible="not o2m_copy_paste_enabled">
                        <field name="o2m_copy_false_fields"/>
                    </setting>

                </block>

            </xpath>

        </field>
    </record>
</odoo>