<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--form view-->

    <record id="hr_attendance_view_form_inherit_wwb" model="ir.ui.view">
        <field name="name">hr.attendance.form.inherit.work.hours.without.break</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_view_form"/>
        <field name="arch" type="xml">
            <field name="worked_hours" position="before">
                <field name="work_hours_without_break" widget="float_time"/>
            </field>
        </field>
    </record>

    <!--list view -->
  
    <record id="view_attendance_tree_inherit_wwb" model="ir.ui.view">
        <field name="name">hr.attendance.list.inherit.work.hours.without.break</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.view_attendance_tree"/>
        <field name="arch" type="xml">
            <field name="worked_hours" position="after">
                <field name="work_hours_without_break" string="Work Hours Without Break" optional="show" widget="float_time"/>
            </field>
        </field>
    </record>

</odoo>