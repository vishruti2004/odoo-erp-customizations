<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ipredict_dynamic_split_view.SplitViewContainer">
        <div class="o_ipredict_split_divider"
             t-ref="divider"
             title="Drag to resize (double click to reset)"
             t-on-pointerdown="onDividerPointerDown"
             t-on-dblclick="onDividerDblClick"/>
        <div class="o_ipredict_split_panel">
            <div class="o_ipredict_split_form">
                <View t-key="props.resId"
                      type="'form'"
                      resModel="props.resModel"
                      resId="props.resId"
                      preventCreate="true"/>
            </div>
        </div>
    </t>
</templates>