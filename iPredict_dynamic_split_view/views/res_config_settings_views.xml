<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form_dynamic_split_view" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.dynamic.split.view</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='users_setting_container']" position="after">
                <block title="Dynamic Split View" name="dynamic_split_view_setting_container">
                    <!-- 1. Enable Split View -->
                    <setting string="Enable Split View"
                             help="Choose the preferred Split View orientation — Horizontal, Vertical, or Both.">
                        <field name="enable_split_view"/>
                        <div class="o_ipredict_split_direction" invisible="not enable_split_view">
                            <field name="split_direction" widget="radio" options="{'horizontal': true}"/>
                        </div>
                    </setting>
                    <!-- 2. Split View Type -->
                    <setting string="Split View Type"
                             help="Enable Split View functionality across supported List and Kanban views."
                             invisible="not enable_split_view">
                        <field name="enable_split_view_type"/>
                        <div class="d-flex align-items-center gap-4" invisible="not enable_split_view_type">
                            <div class="d-flex align-items-center gap-2">
                                <field name="enable_list_split_view" class="oe_inline"/>
                                <label for="enable_list_split_view" string="List View" class="mb-0"/>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <field name="enable_kanban_split_view" class="oe_inline"/>
                                <label for="enable_kanban_split_view" string="Kanban View" class="mb-0"/>
                            </div>
                        </div>
                    </setting>
                    <!-- 3. Default Value -->
                    <setting string="Allow Split View by Default"
                             help="Open supported List and Kanban views in Split View by default."
                             invisible="not enable_split_view">
                        <field name="split_view_default"/>
                    </setting>
                    <!-- 4. New Button Flow -->
                    <setting string="Allow New Records in Split View Screen"
                             help="Open newly created records directly in the Split View panel instead of a full-page form."
                             invisible="not enable_split_view">
                        <field name="enable_new_split_view"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>