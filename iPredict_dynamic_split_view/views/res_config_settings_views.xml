<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form_dynamic_split_view" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.dynamic.split.view</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='users_setting_container']" position="after">
                <block title="Dynamic Split View" name="dynamic_split_view_setting_container">
                    <div class="row">
                        <div class="col-12 col-lg-6">
                            <setting id="enable_split_view_setting"
                                     string="Enable Split View"
                                     help="Enable Split View across the application for this company.">
                                <field name="enable_split_view"/>
                            </setting>
                        </div>
                        <div class="col-12 col-lg-6">
                            <setting id="default_split_view_setting"
                                     string="Default Split View"
                                     help="Automatically open supported List and Kanban views in Split View.">
                                <field name="split_view_default"/>
                            </setting>
                        </div>
                    </div>

                    <div class="row mt-3" invisible="not enable_split_view">
                        <div class="col-12 col-lg-6">
                            <setting id="list_split_view_setting"
                                     string="Enable List View"
                                     help="Allow records in List views to be opened in the Split View panel.">
                                <field name="enable_list_split_view"/>
                            </setting>
                        </div>

                        <div class="col-12 col-lg-6">
                            <setting id="kanban_split_view_setting"
                                     string="Enable Kanban View"
                                     help="Allow records in Kanban views to be opened in the Split View panel.">
                                <field name="enable_kanban_split_view"/>
                            </setting>
                        </div>
                    </div>

                    <div class="row mt-3" invisible="not enable_split_view">
                        <div class="col-12 col-lg-6">
                            <setting id="new_record_split_view_setting"
                                     string="Enable New Record in Split View"
                                     help="Open new records directly in the Split View panel instead of a full-page form.">
                                <field name="enable_new_split_view"/>
                            </setting>
                        </div>

                        <div class="col-12 col-lg-6"
                             invisible="not (enable_list_split_view or enable_kanban_split_view)">
                            <setting id="split_direction_setting"
                                     string="Split Direction">
                                <div class="d-flex align-items-center">
                                    <div class="d-flex align-items-center me-4">
                                        <field name="split_horizontal" class="oe_inline"/>
                                        <label for="split_horizontal"
                                               string="Horizontal"
                                               class="ms-2 mb-0"/>
                                    </div>
                                    <div class="d-flex align-items-center">
                                        <field name="split_vertical" class="oe_inline"/>
                                        <label for="split_vertical"
                                               string="Vertical"
                                               class="ms-2 mb-0"/>
                                    </div>
                                </div>
                            </setting>
                        </div>
                    </div>
                </block>
            </xpath>
        </field>
    </record>
</odoo>