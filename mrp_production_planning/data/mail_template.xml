<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="mail_template_phase_material_shortage" model="mail.template">
            <field name="name">Phase Material Shortage Alert</field>
            <field name="model_id" ref="model_mrp_phase_material_shortage"/>
            <field name="subject">[{{ object.company_id.name }}] Material Shortage Alert - {{ object.workorder_id.name }}</field>
            <field name="email_from">{{ object.company_id.email_formatted }}</field>
            <field name="email_to"></field>
            <field name="body_html" type="html">
                <div class="email-container">
                    <div class="email-wrapper">
                        <!-- Header -->
                        <div class="email-header">
                            <h2>
                                <span class="fa fa-exclamation-triangle icon"></span>
                                Material Shortage Alert
                            </h2>
                            <p>Action Required Before Planned Operation Date</p>
                        </div>

                        <!-- Body -->
                        <div class="email-body">
                            <p class="greeting">Dear Purchase Manager,</p>
                            <p class="message">Component shortages have been detected for a planned manufacturing operation.</p>

                            <!-- Info Box -->
                            <div class="email-info-box">
                                <p>
                                    <strong>Work Order:</strong> <t t-out="object.workorder_id.name"/>
                                    <span class="separator">|</span>
                                    <strong>Manufacturing Order:</strong> <t t-out="object.production_id.name"/>
                                </p>
                            </div>

                            <!-- Table -->
                            <div class="email-table-wrapper">
                                <table class="email-table">
                                    <thead>
                                        <tr>
                                            <th>No</th>
                                            <th>Component</th>
                                            <th>Shortage</th>
                                            <th>RFQ</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-set="shortages" t-value="object.workorder_id.phase_shortage_line_ids"/>
                                        <tr t-foreach="shortages" t-as="s" t-attf-class="#{s_index % 2 == 0 and 'bg-light' or ''}">
                                            <td class="col-no" t-esc="s_index + 1"/>
                                            <td class="col-product"><t t-out="s.product_id.display_name"/></td>
                                            <td class="col-shortage"><t t-out="s.shortage_qty"/> <t t-out="s.uom_id.name"/></td>
                                            <td class="col-rfq">
                                                <t t-if="s.purchase_order_id">
                                                    <t t-out="s.purchase_order_id.name"/>
                                                </t>
                                                <t t-else="">
                                                    <span class="not-created">Not Created</span>
                                                </t>
                                            </td>
                                        </tr>
                                    </tbody>
                                    <tfoot>
                                        <tr>
                                            <td colspan="2">Total Components</td>
                                            <td colspan="2" class="total-value" t-esc="len(shortages)"/>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>

                            <p class="email-closing">Please arrange the required materials before the planned operation date.</p>
                        </div>

                        <!-- Footer -->
                        <div class="email-footer">
                            <p class="footer-text">This is an automated notification generated by Odoo.</p>
                            <p class="company-name"><t t-out="object.company_id.name"/></p>
                        </div>
                    </div>
                </div>
            </field>
        </record>
    </data>
</odoo>