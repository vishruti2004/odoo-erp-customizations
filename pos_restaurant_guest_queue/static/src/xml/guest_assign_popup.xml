<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_restaurant_guest_queue.GuestAssignPopup">
        <Dialog title="'Assign Guest'" size="'lg'">
            <div class="p-4">

                <div class="alert alert-info mb-4">
                    <h5 class="mb-1">Next Guest</h5>
                    <p class="mb-0 fs-5">
                        <strong t-esc="props.bestGuest.waiting_list_id"/> — 
                        <t t-esc="props.bestGuest.guest_name"/> (<t t-esc="props.bestGuest.party_size"/> Guests)
                    </p>
                </div>

                <t t-if="!isCombination">
                    <label class="form-label fw-bold fs-5 mb-2">Available Tables</label>
                    <select t-ref="tableSelect" class="form-select form-select-lg">
                        <t t-foreach="props.availableTables" t-as="table" t-key="table.id">
                            <option t-att-value="table.id">
                                Table <t t-esc="table.table_number"/> (<t t-esc="table.seats"/> seats) — <t t-esc="table.floor_name"/>
                            </option>
                        </t>
                    </select>
                </t>

                <t t-if="isCombination">
                    <div class="alert alert-warning mb-3">
                        <strong>Multiple tables needed!</strong>
                        <p class="mb-0">
                            Guest party: <strong t-esc="props.bestGuest.party_size"/> — Select tables
                        </p>
                    </div>
                    <select t-ref="tableSelect"
                            class="form-select form-select-lg"
                            multiple="multiple"
                            style="height: 200px;"
                            t-on-mousedown="handleSelection">
                        <t t-foreach="props.availableTables" t-as="table" t-key="table.id">
                            <option t-att-value="table.id">
                                Table <t t-esc="table.table_number"/> (<t t-esc="table.seats"/> seats) — <t t-esc="table.floor_name"/>
                            </option>
                        </t>
                    </select>
                </t>

            </div>

            <t t-set-slot="footer">
                <button class="btn btn-primary btn-lg px-5" t-on-click="assignGuest">
                    Assign Table
                </button>
                <button class="btn btn-danger btn-lg px-4" t-on-click="() => props.close()">
                    Close
                </button>
            </t>
        </Dialog>
    </t>
</templates>