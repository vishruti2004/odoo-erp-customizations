<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_guest_queue_list" model="ir.ui.view">
        <field name="name">pos.guest.queue.list</field>
        <field name="model">pos.guest.queue</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="guest_name"/>
                <field name="phone"/>
                <field name="party_size"/>
                <field name="pos_session_id" string="Restaurant"/>
                <field name="arrival_time"/>
                <field name="state" widget="badge"
                    decoration-warning="state == 'waiting'"
                    decoration-info="state == 'notified'"
                    decoration-success="state == 'seated'"
                    decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_pos_guest_queue_form" model="ir.ui.view">
        <field name="name">pos.guest.queue.form</field>
        <field name="model">pos.guest.queue</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"
                        statusbar_visible="waiting,notified,seated,cancelled"/>
                </header>
                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="guest_name" required="1"/>
                        <field name="phone" required="1"/>
                        <field name="party_size" required="1"/>
                        <field name="arrival_time" readonly="1"/>
                        <field name="pos_session_id" 
                                   options="{'no_create': True, 'no_create_edit': True}"
                                   readonly="has_multiple_sessions == False"
                                   domain="[('state', '=', 'opened')]"/>
                            <field name="has_multiple_sessions" invisible="1"/>
                     
                    </group>
                    <group string="Assigned Tables" invisible="state == 'waiting'">
                        <field name="table_ids" widget="many2many_tags" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_pos_guest_queue_search" model="ir.ui.view">
        <field name="name">pos.guest.queue.search</field>
        <field name="model">pos.guest.queue</field>
        <field name="arch" type="xml">
            <search>
                <field name="guest_name" string="Guest Name"/>
                <field name="party_size" string="Party Size"/>
                <field name="state" string="Status"/>
                <field name="pos_session_id" string="Restaurant"/>
                <separator/>
                <filter string="Waiting" name="waiting" domain="[('state','=','waiting')]"/>
                <filter string="Notified" name="notified" domain="[('state','=','notified')]"/>
                <filter string="Seated" name="seated" domain="[('state','=','seated')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state','=','cancelled')]"/>
            </search>
        </field>
    </record>
</odoo>