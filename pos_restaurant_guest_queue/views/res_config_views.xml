<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_inherit_guest_queue" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.guest.queue</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <setting id="iface_splitbill" position="after">
                <setting string="Auto Assign Waiting Guest" help="Automatically assign the first eligible guest when a table becomes available." invisible="not pos_module_pos_restaurant or is_kiosk_mode">
                    <field name="auto_assign_waiting_guest"/>
                    <div class="mt-3" invisible="not auto_assign_waiting_guest">
                        <label for="waiting_duration" string="Waiting Duration (minutes)"/>
                        <field name="waiting_duration" class="o_field_integer"/>
                        <div class="text-muted">Time in minutes before moving to the next guest.</div>
                    </div>
                </setting>
            </setting>
        </field>
    </record>

</odoo>