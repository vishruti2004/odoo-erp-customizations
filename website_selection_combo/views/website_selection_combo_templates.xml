<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Add is_combo attribute on Add to Cart button -->
    <template id="product_selection_combo_button" inherit_id="website_sale.product" name="Add Combo Attribute">
        <xpath expr="//button[hasclass('add-to-cart')]" position="attributes">
            <attribute name="t-att-data-is-combo">
                product.selection_combo or False
            </attribute>
        </xpath>
    </template>
</odoo>