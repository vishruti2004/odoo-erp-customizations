<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="website_selection_combo.ComboConfiguratorDialog">
        <Dialog
            title="props.displayName"
            contentClass="'combo-configurator-dialog'"
            bodyClass="'d-flex flex-column gap-3 p-3'"
        >
            <t t-foreach="props.combos" t-as="combo" t-key="combo.id">
                <div class="combo-category-section border-bottom pb-3 mb-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="h5 mb-0">
                            <t t-esc="combo.category_name"/>
                        </span>
                        <span class="badge bg-secondary">
                            <t t-esc="getComboTotalQty(combo.id)"/> / <t t-esc="combo.maximum_selection"/>
                        </span>
                    </div>
                    <div class="text-muted small mb-2">
                        <t t-if="combo.minimum_selection > 0 and combo.maximum_selection > 0">
                            Select <t t-esc="combo.minimum_selection"/> - <t t-esc="combo.maximum_selection"/> products
                        </t>
                        <t t-elif="combo.maximum_selection > 0">
                            Maximum <t t-esc="combo.maximum_selection"/> products
                        </t>
                    </div>
                    <div class="row g-2 mt-2">
                        <t t-foreach="combo.combo_items" t-as="item" t-key="item.id">
                            <div class="col-12 col-md-6 col-lg-4">
                                <ProductCard
                                    comboId="combo.id"
                                    item="item"
                                    quantity="state.selectedQuantities.get(combo.id)[item.id] or 0"
                                    onIncrease.bind="() => this.increaseQty(combo.id, item.id, combo.maximum_selection)"
                                    onDecrease.bind="() => this.decreaseQty(combo.id, item.id)"
                                    maxQty="combo.maximum_selection"
                                />
                            </div>
                        </t>
                    </div>
                    <div t-if="!isComboValid(combo)" class="text-danger small mt-2">
                        <i class="fa fa-exclamation-circle"/>
                        <t t-if="getComboTotalQty(combo.id) &lt; combo.minimum_selection">
                            Please select at least <t t-esc="combo.minimum_selection"/> product(s)
                        </t>
                        <t t-elif="getComboTotalQty(combo.id) &gt; combo.maximum_selection">
                            Maximum <t t-esc="combo.maximum_selection"/> product(s) allowed
                        </t>
                    </div>
                </div>
            </t>
            <t t-set-slot="footer">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-center w-100 gap-2">
                    <div class="d-flex gap-2">
                        <button
                            class="btn btn-primary"
                            t-att-disabled="!areAllCombosValid || state.isAdding"
                            t-on-click="addToCart"
                        >
                            <i class="fa fa-shopping-cart me-2"/>
                            <t t-if="state.isAdding">Adding...</t>
                            <t t-else="">Add to Cart</t>
                        </button>
                        <button class="btn btn-secondary" t-on-click="cancel">
                            Cancel
                        </button>
                    </div>
                    <div class="h5 mb-0">
                        Total: <t t-esc="formattedTotal"/>
                    </div>
                </div>
            </t>
        </Dialog>
    </t>
</templates>