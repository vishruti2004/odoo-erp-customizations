<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="website_selection_combo.CartSummaryCombo" 
       t-inherit="website_sale.cart_lines" 
       t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_cart_product')]" position="inside">
            <t t-foreach="website_sale_order.website_order_line" t-as="line">
                <t t-if="line.is_combo_line">
                    <div class="row w-100 mt-1">
                        <div class="col-12">
                            <div class="combo-child-items" style="margin-left: 20px; font-size: 13px; color: #666; padding: 5px 0; border-top: 1px dashed #eee;">
                                <t t-foreach="line.get_combo_child_items()" t-as="child">
                                    <div style="padding: 2px 0;">
                                        <i class="fa fa-circle" style="font-size: 6px; vertical-align: middle; margin-right: 8px;"></i>
                                        <t t-esc="child.product_name"/>
                                        (<t t-esc="child.quantity"/>)
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </xpath>
    </t>
</templates>