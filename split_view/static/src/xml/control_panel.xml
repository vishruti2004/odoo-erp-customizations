<?xml version="1.0" encoding="UTF-8"?>

<templates xml:space="preserve">

    <t t-inherit="web.ControlPanel" t-inherit-mode="extension">

        <xpath expr="//nav[contains(@class, 'o_cp_switch_buttons')]" position="inside">

            <button
                t-if="splitViewEnabled"
                type="button"
                class="btn btn-secondary o_switch_view o_ipredict_split_view_button"
                t-att-class="{active: splitViewState.active}"
                data-tooltip="Split View"
                aria-label="Split View"
                t-on-click="toggleSplitView"
            >
                <i class="oi-fw oi-view-list"/>
            </button>

        </xpath>

    </t>

</templates>