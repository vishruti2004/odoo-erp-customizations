<?xml version="1.0" encoding="utf-8"?>
<templates id="template" xml:space="preserve">

    <!-- Extend KanbanRenderer to add split view container as a sibling -->
    <t t-inherit="web.KanbanRenderer" t-inherit-mode="extension">

        <!-- Add SplitviewContainer after the o_kanban_renderer div (as sibling) -->
        <xpath expr="//div[hasclass('o_kanban_renderer')]" position="after">
            <SplitviewContainer t-if="splitViewState and splitViewState.show" t-props="getSplitviewContainerProps()"/>
        </xpath>

    </t>

</templates>
