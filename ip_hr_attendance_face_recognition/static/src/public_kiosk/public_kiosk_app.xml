<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="ip_hr_attendance_face_recognition.public_kiosk_app" t-inherit="hr_attendance.public_kiosk_app" t-inherit-mode="extension">
        <xpath expr="//div[contains(@class,'o_hr_kiosk_mode_main')]" position="attributes">
            <attribute name="class">o_hr_kiosk_mode_main d-flex flex-lg-row flex-column gap-3 m-auto</attribute>
        </xpath>
        <xpath expr="//KioskBarcodeScanner" position="after">
            <t t-if="state.isFaceRecognitionEnabled">
                <FaceRecognitionButton
            token="props.token"
            onSuccess="(result) => { this.employeeData = result; this.switchDisplay('greet'); }"
            onFailure="(result) => this.displayNotification(result)"
            attendance_image_capture="state.isImageCaptureEnabled"
        />
            </t>
        </xpath>
    </t>
    <t t-name="ip_hr_attendance_face_recognition.BarcodeScanner" t-inherit="hr_attendance.BarcodeScanner" t-inherit-mode="extension">

        <xpath expr="//div[contains(@class,'o_hr_attendance_kiosk')]" position="replace">
            <div class="o_hr_attendance_kiosk d-flex justify-content-center gap-5">

                <div class="position-relative">
                    <button t-if="isBarcodeScannerSupported" t-on-click="openMobileScanner" class="o_mobile_barcode btn btn-light btn-lg p-5 rounded-3">
                        <i class="fa fa-3x fa-barcode mb-3" />
                        <span class="d-block">Scan your badge</span>
                    </button>

                    <a t-if="!isDisplayStandalone"
                       class="btn btn-secondary position-absolute"
                       style="top: 2px; right: 6px; z-index: 10; padding: 4px 8px; font-size: 15px;"
                       t-att-href="installURL"
                       target="_blank">
                    Install
                    </a>

                </div>

            </div>
        </xpath>
    </t>
</templates>