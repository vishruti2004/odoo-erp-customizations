<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_users_form_inherit_face_image" model="ir.ui.view">
        <field name="name">res.users.form.face.image</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="hr.res_users_view_form_preferences"/>

        <field name="arch" type="xml">

            <xpath expr="//notebook" position="inside">

                <page
                    string="Face Recognition"
                    name="face_recognition_user"
                    invisible="allow_without_image_capture">

                    <group>
                        <field name="allow_without_image_capture" invisible="1"/>

                        <field name="face_image"
                               string="Face Image"
                               widget="image"
                               options="{'size': [90, 90]}"/>
                    </group>

                </page>

            </xpath>

        </field>
    </record>

</odoo>