<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_employee_form_inherited" model="ir.ui.view">
        <field name="name">hr.employee.form</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr_attendance.view_employee_form_inherit_hr_attendance"/>

        <field name="arch" type="xml">

            <!-- Attendance Settings -->
            <xpath expr="//field[@name='ruleset_id']" position="after">
                <field name="allow_without_image_capture" string="Allow Attendance Without Image &amp; Face Recognition" groups="hr.group_hr_manager"/>
                <field name="face_image" widget="image" string="Face Image" options="{'size': [90, 90]}" groups="hr.group_hr_manager" invisible="allow_without_image_capture"/>
            </xpath>

            <!-- Generate Face Encoding Button -->
            <xpath expr="//header" position="inside">
                <button name="generate_face_encoding_manual" string="Generate Face Encoding" type="object" class="btn-primary" groups="hr.group_hr_manager" invisible="not face_image or allow_without_image_capture"/>
            </xpath>

        </field>
    </record>

</odoo>