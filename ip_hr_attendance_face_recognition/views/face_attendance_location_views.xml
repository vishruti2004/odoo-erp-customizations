<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View -->
    <record id="multi_location_hr_attendance_face_detection_list" model="ir.ui.view">
        <field name="name">multi.location.hr.attendance.face.detection.list</field>
        <field name="model">multi.location</field>
        <field name="arch" type="xml">
            <list string="Face Attendance Locations">
                <field name="name"/>
                <field name="face_attendance_latitude"/>
                <field name="face_attendance_longitude"/>
                <field name="face_attendance_radius"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="multi_location_hr_attendance_face_detection" model="ir.ui.view">
        <field name="name">multi.location.hr.attendance.face.detection.form</field>
        <field name="model">multi.location</field>
        <field name="arch" type="xml">
            <form string="Face Attendance Location">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id"/>
                    </group>
                    <group>
                        <field name="face_attendance_latitude"/>
                        <field name="face_attendance_longitude"/>
                        <field name="face_attendance_radius"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_face_attendance_locations" model="ir.actions.act_window">
        <field name="name">Face Attendance Locations</field>
        <field name="res_model">multi.location</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu -->
    <menuitem
        id="menu_face_attendance_locations"
        name="Face Attendance Locations"
        parent="hr_attendance.menu_hr_attendance_configuration"
        action="action_face_attendance_locations"
        sequence="30"/>

</odoo>