<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_approval_inherit" model="ir.ui.view">
        <field name="name">account.move.form.approval.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <xpath expr="//button[@name='button_draft']" position="attributes">
                <attribute name="invisible">not show_reset_to_draft_button and state != 'rejected'</attribute>
            </xpath>

            <xpath expr="(//header/button[@name='action_post'])[2]" position="after">

                <field name="is_current_user_approver" invisible="1"/>
                <field name="is_approval_manager" invisible="1"/>

                <button name="action_approve"
                        string="Approve"
                        type="object"
                        class="btn-success"
                        invisible="state not in ('waiting', 'partially_approved') or not is_current_user_approver"/>
                <button name="action_reject"
                        string="Reject"
                        type="object"
                        class="btn-danger"
                        invisible="state not in ('waiting', 'partially_approved') or not is_current_user_approver"/>

            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Approval History">

                    <!-- Manager-only: rule name + current level -->
                    <group invisible="not is_approval_manager">
                        <field name="approval_rule_id" readonly="1" invisible="not approval_rule_id"/>
                        <field name="current_approval_level" readonly="1" invisible="not approval_rule_id"/>
                    </group>

                    <field name="approval_history_display_ids" nolabel="1">
                        <list string="Approval History">
                            <field name="user_id" string="Approver"/>
                            <field name="approval_level" string="Level" column_invisible="not parent.is_approval_manager"/>
                            <field name="status" widget="badge"
                                   decoration-success="status == 'approved'"
                                   decoration-danger="status == 'rejected'"
                                   decoration-warning="status == 'pending'"/>
                            <field name="comment" string="Comments"/>
                            <field name="create_date" string="Date"/>
                        </list>
                    </field>

                </page>
            </xpath>

        </field>
    </record>

</odoo>