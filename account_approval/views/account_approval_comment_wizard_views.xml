<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_approval_comment_wizard_form" model="ir.ui.view">
        <field name="name">account.approval.comment.wizard.form</field>
        <field name="model">account.approval.comment.wizard</field>
        <field name="arch" type="xml">
            <form string="Add Comment">
                <field name="invoice_id" invisible="1"/>
                <field name="action_type" invisible="1"/>
                <group>
                    <field name="comment" nolabel="1" placeholder="Write your comment here..."/>
                </group>
                <footer>
                    <button name="action_confirm" string="Submit" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>