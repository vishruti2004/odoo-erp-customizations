<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- 1. Approval Notification Email Template -->
        <record id="email_template_approval_notification" model="mail.template">
            <field name="name">Invoice Approval Notification</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="subject">[{{ object.company_id.name }}] Invoice {{ object.name or 'Pending Approval' }}</field>
            <field name="body_html" type="html">
                <div class="container-fluid bg-light p-4 font-sans">
                    <div class="card mx-auto shadow-sm" style="max-width: 650px; border-radius: 8px; overflow: hidden;">
                        
                        <div class="p-4 text-center text-white" style="background-color: #714B67;">
                            <h2 class="m-0 font-weight-bold" style="font-size: 22px;">Invoice Approval Required</h2>
                            <p class="small text-white-50 mt-2 mb-0">Please review and approve the invoice</p>
                        </div>
                        
                        <!-- Body -->
                        <div class="card-body p-4 text-dark">
                            <p class="lead">Dear Approver,</p>
                            <p class="text-muted">An invoice has been submitted for your approval. Details below:</p>
                            
                            <table class="table table-sm table-bordered mt-4 text-left">
                                <thead class="text-white" style="background-color: #714B67;">
                                    <tr>
                                        <th class="p-2">Invoice Reference</th>
                                        <th class="p-2">Partner</th>
                                        <th class="p-2">Invoice Date</th>
                                        <th class="p-2 text-right">Total Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr class="bg-white">
                                        <td class="p-2 font-weight-bold text-dark">
                                            <t t-out="object.name or object.invoice_origin or ('#%s' % object.id)"/>
                                        </td>
                                        <td class="p-2 "><t t-out="object.partner_id.name"/></td>
                                        <td class="p-2 "><t t-out="object.invoice_date or '-'"/></td>
                                        <td class="p-2 font-weight-bold text-right" style="color: #714B67;">
                                            <t t-out="object.currency_id.symbol"/><t t-out="object.amount_total"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                            
                            <div class="text-center my-4">
                                <a class="btn btn-lg text-white font-weight-bold px-4 py-2" 
                                   style="background-color: #714B67; border-radius: 4px; text-decoration: none;"
                                   t-attf-href="#{object.get_base_url()}/web#id=#{object.id}&amp;model=account.move&amp;view_type=form">
                                    View &amp; Approve Invoice
                                </a>
                            </div>
                        </div>
                        
                        <!-- Footer -->
                        <div class="card-footer bg-light p-3 text-center border-top">
                            <p class="small text-muted m-0">This is an automated notification generated by Odoo.</p>
                            <p class="small font-weight-bold mt-1 mb-0" style="color: #714B67;"><t t-out="object.company_id.name"/></p>
                        </div>
                        
                    </div>
                </div>
            </field>
        </record>

        <!-- 2. Approval Decision Notification Email Template (For Other Approvers) -->
        <record id="email_template_approval_decision" model="mail.template">
            <field name="name">Invoice Approval Decision Notification</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="subject">[{{ object.company_id.name }}] Invoice {{ object.name or 'Decision' }}</field>
            <field name="body_html" type="html">
                <div class="container-fluid bg-light p-4 font-sans">
                    <div class="card mx-auto shadow-sm" style="max-width: 650px; border-radius: 8px; overflow: hidden;">
                        
                        <!-- Header -->
                        <div class="p-4 text-center text-white" style="background-color: #714B67;">
                            <h2 class="m-0 font-weight-bold" style="font-size: 22px;">
                                <t t-if="ctx.get('action_text') == 'approved'">Invoice Approved</t>
                                <t t-else="">Invoice Rejected</t>
                            </h2>
                        </div>
                        
                        <!-- Body -->
                        <div class="card-body p-4">
                            <p class="lead">Dear Approver,</p>
                            <p class="text-dark">
                                <span class="font-weight-bold"><t t-out="ctx.get('approver_name', 'A user')"/></span> has 
                                <t t-if="ctx.get('action_text') == 'approved'">
                                    <span class="font-weight-bold text-success">approved</span>
                                </t>
                                <t t-else="">
                                    <span class="font-weight-bold text-danger">rejected</span>
                                </t>
                                the invoice.
                            </p>
                        </div>
                        
                        <!-- Footer -->
                        <div class="card-footer bg-light p-3 text-center border-top">
                            <p class="small font-weight-bold m-0" style="color: #714B67;"><t t-out="object.company_id.name"/></p>
                        </div>
                        
                    </div>
                </div>
            </field>
        </record>

    </data>
</odoo>
