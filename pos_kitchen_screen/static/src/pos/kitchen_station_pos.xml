<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_kitchen_screen.KitchenStationDialog">
        <Dialog title="props.title" size="'md'">
            <div class="d-flex flex-column gap-2">
                <button t-foreach="props.stations" t-as="station" t-key="station.id" type="button"
                        class="btn btn-lg text-start"
                        t-att-class="state.selected === station.id ? 'btn-primary' : 'btn-outline-secondary'"
                        t-on-click="() => this.select(station.id)">
                    <t t-esc="station.name" />
                </button>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary btn-lg" t-on-click="onConfirm">Apply</button>
                <button class="btn btn-secondary btn-lg" t-on-click="props.close">Cancel</button>
            </t>
        </Dialog>
    </t>

    <t t-name="pos_kitchen_screen.KitchenPriorityDropdown">
        <span class="o_kitchen_priority_dropdown d-inline-flex" t-on-click.stop="() => {}">
            <Dropdown position="'bottom-end'" menuClass="'o_kitchen_priority_menu'">
                <button type="button"
                        t-att-class="(props.buttonClass || 'btn btn-sm') + ' o_kitchen_priority_' + priority"
                        t-att-title="'Kitchen priority: ' + current.label">
                    <span class="o_kitchen_prio_dot me-2" />
                    <span t-esc="label" />
                    <i class="fa fa-angle-down ms-2" />
                </button>
                <t t-set-slot="content">
                    <DropdownItem t-foreach="options" t-as="opt" t-key="opt.id"
                                  class="'o_kitchen_priority_item o_kitchen_priority_' + opt.id + (opt.id === priority ? ' active' : '')"
                                  onSelected="() => this.select(opt.id)">
                        <span class="o_kitchen_prio_dot me-2" />
                        <span class="fw-semibold" t-esc="opt.label" />
                        <i t-if="opt.id === priority" class="fa fa-check ms-auto ps-3" />
                    </DropdownItem>
                </t>
            </Dropdown>
        </span>
    </t>

    <t t-name="pos_kitchen_screen.ProductScreen" t-inherit="point_of_sale.ProductScreen" t-inherit-mode="extension">
        <xpath expr="//OrderSummary" position="before">
            <div t-if="currentOrder?.kitchenLocked" class="o_kitchen_lock_banner d-flex align-items-center gap-2 mx-2 mt-2 px-3 py-2 rounded">
                <i class="fa fa-lock" />
                <span>Order is ready in the kitchen and cannot be changed.</span>
            </div>
        </xpath>
    </t>

    <t t-name="pos_kitchen_screen.Navbar" t-inherit="point_of_sale.Navbar" t-inherit-mode="extension">
        <xpath expr="//Dropdown//div[hasclass('pos-burger-menu-items')]//DropdownItem" position="before">
            <DropdownItem t-if="kitchenOverrideAvailable" onSelected="() => this.onKitchenStationClick()">
                <span>Kitchen station for selected line</span>
            </DropdownItem>
        </xpath>
    </t>

   
    <t t-name="pos_kitchen_screen.ControlButtons" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('more-btn')]" position="before">
            <KitchenPriorityDropdown t-if="kitchenPriorityAvailable and !props.showRemainingButtons and !pos.getOrder()?.isRefund"
                                     order="pos.getOrder()"
                                     buttonClass="buttonClass + ' o_kitchen_priority_control'"
                                     withPrefix="true"
                                     onSelect="(priority) => this.onKitchenPriority(priority)" />
        </xpath>
    </t>

    <t t-name="pos_kitchen_screen.TicketScreen" t-inherit="point_of_sale.TicketScreen" t-inherit-mode="extension">
        <xpath expr="//tr[hasclass('order-row')]/td[last()]" position="before">
            <td class="align-middle text-center o_kitchen_priority_cell">
                <KitchenPriorityDropdown t-if="kitchenPriorityAvailable"
                                         order="order"
                                         buttonClass="'btn btn-sm o_kitchen_priority_btn'"
                                         onSelect="(priority) => this.onKitchenPriority(order, priority)" />
            </td>
        </xpath>
    </t>

</templates>