<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_kitchen_screen.ControlButtons" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('more-btn')]" position="before">
            <KitchenPriorityDropdown t-if="kitchenPriorityAvailable and !props.showRemainingButtons and !pos.getOrder()?.isRefund"
                                     order="pos.getOrder()"
                                     buttonClass="buttonClass + ' o_kitchen_priority_control'"
                                     withPrefix="true"
                                     onSelect="(priority) => this.onKitchenPriority(priority)" />
        </xpath>
    </t>
</templates>
