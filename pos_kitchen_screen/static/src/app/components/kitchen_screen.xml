<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!--  Dialogs -->
    <t t-name="pos_kitchen_screen.SelectDialog">
        <Dialog title="props.title" size="'md'">
            <div class="o_kitchen_select list-group">
                <button t-foreach="props.options" t-as="opt" t-key="opt.id" type="button"
                        class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-2"
                        t-att-class="{ 'active': state.selected === opt.id }"
                        t-att-disabled="opt.disabled"
                        t-on-click="() => this.select(opt.id)">
                    <span class="flex-grow-1" t-esc="opt.label" />
                    <small t-if="opt.sub" class="opacity-75" t-esc="opt.sub" />
                    <i t-if="state.selected === opt.id" class="fa fa-check" />
                </button>
            </div>
            <textarea t-if="props.withReason"
                      t-model="state.reason"
                      class="form-control mt-3"
                      rows="2"
                      placeholder="Reason (optional)" />
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-att-disabled="state.selected === null or state.busy" t-on-click="onConfirm">Confirm</button>
                <button class="btn btn-light" t-on-click="props.close">Cancel</button>
            </t>
        </Dialog>
    </t>

    <t t-name="pos_kitchen_screen.InfoDialog">
        <Dialog title="props.title" size="'md'">
            <p t-if="props.intro" class="mb-2" t-esc="props.intro" />
            <ul class="list-group">
                <li t-foreach="props.rows" t-as="row" t-key="row_index" class="list-group-item d-flex justify-content-between align-items-center py-2">
                    <span t-esc="row.label" />
                    <small class="text-muted" t-esc="row.sub" />
                </li>
            </ul>
            <p t-if="props.summary" class="mt-3 mb-0 fw-bold" t-esc="props.summary" />
            <t t-set-slot="footer">
                <button t-if="props.confirm"
                        class="btn"
                        t-att-class="props.confirmClass or 'btn-primary'"
                        t-on-click="onConfirm"
                        t-esc="props.confirmLabel" />
                <button class="btn btn-light" t-on-click="props.close">Close</button>
            </t>
        </Dialog>
    </t>

    <t t-name="pos_kitchen_screen.ReprepareDialog">
        <Dialog title="props.title" size="'md'">
            <p class="text-muted mb-2">Why does this item need to be prepared again?</p>
            <div class="o_kitchen_reasons list-group">
                <label t-foreach="reasons"
                       t-as="reason"
                       t-key="reason.id"
                       class="list-group-item d-flex align-items-center gap-3 py-2 cursor-pointer"
                       t-att-class="{ 'active': state.reason === reason.id }">
                    <input type="radio" class="form-check-input mt-0" name="kitchen_reprep_reason"
                           t-att-value="reason.id" t-att-checked="state.reason === reason.id"
                           t-on-change="() => state.reason = reason.id" />
                    <span class="flex-grow-1" t-esc="reason.label" />
                </label>
            </div>
            <textarea t-if="state.reason === 'other'"
                      t-model="state.other"
                      class="form-control mt-3"
                      rows="3"
                      placeholder="Write the reason" />
            <t t-set-slot="footer">
                <button class="btn btn-danger" t-att-disabled="!canConfirm" t-on-click="onConfirm">Re-prepare</button>
                <button class="btn btn-light" t-on-click="props.close">Cancel</button>
            </t>
        </Dialog>
    </t>

    <t t-name="pos_kitchen_screen.ChefDialog">
        <Dialog title="'Who is cooking?'" size="'md'">
            <div class="o_kitchen_select list-group">
                <button t-foreach="props.chefs" t-as="chef" t-key="chef.id" type="button"
                        class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-2"
                        t-att-class="{ 'active': props.current and props.current.id === chef.id }"
                        t-on-click="() => this.pick(chef)">
                    <span class="flex-grow-1" t-esc="chef.name" />
                    <i t-if="props.current and props.current.id === chef.id" class="fa fa-check" />
                </button>
            </div>
            <div t-if="!props.chefs.length" class="text-muted">No chef of this screen is on shift now.</div>
            <t t-set-slot="footer">
                <button t-if="props.current" class="btn btn-outline-danger" t-on-click="onLogout">Log out</button>
                <button class="btn btn-light" t-on-click="props.close">Close</button>
            </t>
        </Dialog>
    </t>

    <!-- Main screen -->
    <t t-name="pos_kitchen_screen.PrepDisplay" t-inherit="pos_enterprise.PrepDisplay" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_pdis_main_screen')]" position="attributes">
            <attribute name="t-att-class">this.kitchenRootClass</attribute>
        </xpath>

        <xpath expr="//div[hasclass('top-buttons')]" position="before">
            <div class="d-flex align-items-center h-100">

                <button t-if="prepDisplay.kitchenAdvanced"
                class="btn btn-light btn-lg h-100 px-4 rounded-0 border-start"
                t-on-click="() => this.prepDisplay.openChefLogin()">
                    <i class="fa fa-user-circle pe-0 pe-lg-2" aria-hidden="true" />
                    <span class="d-none d-lg-inline-block" t-esc="kitchenChefLabel" />
                </button>
            </div>
        </xpath>

        <!-- sidebar: priority, chef and station filters -->
        <xpath expr="//div[hasclass('o_pdis_time')]" position="after">
            <div t-if="prepDisplay.kitchenAdvanced" class="o_kitchen_filter_priority">
                <section class="o_pdis_name_quantity d-flex justify-content-between mt-3 pt-2 pb-1 fs-4 fw-bold">
                    <span class="name category-name">Priority</span>
                </section>
                <hr class="mt-1 mb-2 me-n2" />
                <t t-foreach="[['all', 'All'], ['high', 'High'], ['medium', 'Medium'], ['low', 'Low']]" t-as="f" t-key="f[0]">
                    <div class="d-flex justify-content-between m-0 py-2 border-bottom border-light cursor-pointer"
                         t-att-class="{ 'product-selected bg-info bg-opacity-25 px-2 me-n2': kitchen.priorityFilter === f[0] }"
                         t-on-click="() => this.setPriorityFilter(f[0])">
                        <span class="pe-2" t-esc="f[1]" />
                    </div>
                </t>
            </div>
            <div t-if="prepDisplay.kitchenAdvanced" class="o_kitchen_filter_chef">
                <section class="o_pdis_name_quantity d-flex justify-content-between mt-3 pt-2 pb-1 fs-4 fw-bold">
                    <span class="name category-name">Chef</span>
                </section>
                <hr class="mt-1 mb-2 me-n2" />
                <t t-foreach="[['all', 'All'], ['mine', 'My tickets'], ['unassigned', 'Unassigned']]" t-as="f" t-key="f[0]">
                    <div class="d-flex justify-content-between m-0 py-2 border-bottom border-light cursor-pointer"
                         t-att-class="{ 'product-selected bg-info bg-opacity-25 px-2 me-n2': kitchen.chefFilter === f[0] }"
                         t-on-click="() => this.setChefFilter(f[0])">
                        <span class="pe-2" t-esc="f[1]" />
                    </div>
                </t>
            </div>
            <div t-if="showStationFilter" class="o_kitchen_filter_station">
                <section class="o_pdis_name_quantity d-flex justify-content-between mt-3 pt-2 pb-1 fs-4 fw-bold">
                    <span class="name category-name">Station</span>
                </section>
                <hr class="mt-1 mb-2 me-n2" />
                <t t-foreach="prepDisplay.ownStations" t-as="station" t-key="station.id">
                    <div class="d-flex justify-content-between m-0 py-2 border-bottom border-light cursor-pointer"
                         t-att-class="{ 'product-selected bg-info bg-opacity-25 px-2 me-n2': kitchen.stationFilter.includes(station.id) }"
                         t-on-click="() => this.toggleStationFilter(station.id)">
                        <span class="pe-2" t-esc="station.name" />
                    </div>
                </t>
            </div>
        </xpath>

        <!-- workload bar above the tickets -->
        <xpath expr="//div[hasclass('o_pdis_orders')]" position="before">
            <div t-if="prepDisplay.posHasProducts and prepDisplay.kitchenAdvanced and prepDisplay.workloadView.length" class="o_kitchen_workload d-flex gap-3 px-3 py-2 overflow-auto bg-100 border-bottom">
                <div t-foreach="prepDisplay.workloadView"
                     t-as="w"
                     t-key="w.id"
                     class="o_kitchen_workload_item flex-shrink-0"
                     t-att-class="{ 'opacity-75': !w.isOwn }">
                    <div class="d-flex justify-content-between fw-bold small gap-3">
                        <span>
                            <i t-if="w.overloaded" class="fa fa-exclamation-triangle text-danger me-1" />
                            <t t-esc="w.name" />
                        </span>
                        <span t-att-class="w.overloaded ? 'text-danger' : 'text-muted'" t-esc="(w.limit ? w.value + ' / ' + w.limit : w.value) + ' ' + w.unit" />
                    </div>
                    <div class="progress o_kitchen_workload_bar">
                        <div class="progress-bar" role="progressbar"
                             t-att-class="w.overloaded ? 'bg-danger' : (w.percent >= 80 ? 'bg-warning' : 'bg-success')"
                             t-attf-style="width: {{ w.limit ? w.percent : 0 }}%"/>
                    </div>
                    <button t-if="w.isOwn and w.overloaded" type="button" class="btn btn-sm btn-danger mt-1 w-100"
                            t-on-click="() => this.prepDisplay.openOverflowMenu(w)">
                        <i class="fa fa-share me-1" />
                        <t t-if="w.metric === 'time'">Over by 
                            <t t-esc="w.excess" /> min: move items to another station
                        </t>
                        <t t-else="">Overflow, 
                            <t t-esc="w.overflow_orders" /> waiting: move to another station
                        </t>
                    </button>
                </div>
            </div>
        </xpath>
    </t>

    <!--  Ticket card -->
    <t t-name="pos_kitchen_screen.Order" t-inherit="pos_enterprise.Order" t-inherit-mode="extension">

        <xpath expr="//div[hasclass('o_pdis_tracking_number')]" position="after">
            <div t-if="kitchenShowPriority" class="o_kitchen_priority badge rounded-pill" t-att-class="this.order.priority === 'high' ? 'text-bg-danger' : 'text-bg-secondary'">
                <i class="fa fa-flag me-1" />
                <t t-esc="kitchenPriorityLabel" />
            </div>
        </xpath>

        <xpath expr="//div[hasclass('o_pdis_order_card_header')]" position="after">
            <div t-if="kitchenReprepare" class="o_kitchen_ribbon o_kitchen_ribbon_reprep">
                <i class="fa fa-repeat me-1" />RE-PREPARE
            </div>
            <div t-if="kitchenOrderChanged" class="o_kitchen_ribbon">
                <i class="fa fa-exclamation-triangle me-1" />ORDER CHANGED
            </div>
            <div t-if="kitchenShowToolbar" class="o_kitchen_toolbar d-flex flex-wrap align-items-center gap-1 px-2 py-1 bg-100 border-top">
                <span t-if="kitchenIsOverflow" class="badge text-bg-dark">
                    <i class="fa fa-hourglass-half me-1" />Overflow, waiting
                </span>
                <span t-if="kitchenReadiness" class="badge rounded-pill" t-att-class="kitchenReadiness.cls"
                      t-att-title="kitchenReadiness.stations.map((s) => s.name + ' ' + s.ready + '/' + s.total).join(' · ')">
                    <i class="fa fa-cutlery me-1" />
                    <t t-esc="kitchenReadiness.text" />
                </span>
            </div>
        </xpath>
    </t>

    <t t-name="pos_kitchen_screen.Orderline" t-inherit="pos_enterprise.Orderline" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_pdis_orderline_infos')]" position="inside">
            <button t-if="kitchenCanMove"
                    class="btn btn-sm btn-outline-secondary ms-2 align-self-start"
                    type="button"
                    title="Move this item to another station"
                    t-on-click.stop="kitchenMove">
                <i class="fa fa-exchange" />
            </button>
        </xpath>
        <xpath expr="//div[hasclass('o_pdis_orderline_infos')]" position="after">
            <div t-if="kitchenChangeText" class="o_kitchen_change d-flex align-items-center gap-2 ms-4 me-2 mb-1 px-2 py-1 rounded" t-att-class="kitchenChangeText.cls">
                <i class="fa fa-exclamation-circle" />
                <span class="fw-bold" t-esc="kitchenChangeText.text" />
            </div>
            <div t-if="kitchenMetaVisible" class="o_kitchen_line_meta d-flex flex-wrap align-items-center gap-1 ms-4 mb-1">
                <span t-if="kitchenMovedFrom" class="badge text-bg-dark">
                    <i class="fa fa-share me-1" />from 
                    <t t-esc="kitchenMovedFrom" />
                </span>
                <span t-if="kitchenStationName" class="badge text-bg-secondary" t-esc="kitchenStationName" />
                <button t-if="kitchenCanReprepare"
                        class="o_kitchen_reprepare btn btn-sm btn-danger py-0"
                        type="button"
                        title="Send this item back to the kitchen"
                        t-on-click.stop="kitchenReprepareClick">
                    <i class="fa fa-repeat me-1" />Re-prepare
                </button>
                <t t-if="kitchenCanAssign">
                    <button t-if="kitchenChef"
                            class="o_kitchen_chef_chip"
                            type="button"
                            title="Change chef"
                            t-on-click.stop="kitchenAssign">
                        <i class="fa fa-user-circle" />
                        <span t-esc="kitchenChef.name" />
                    </button>
                    <t t-else="">
                        <button class="o_kitchen_take" type="button" t-on-click.stop="kitchenTake">Take</button>
                        <button class="o_kitchen_chef_chip" type="button" title="Assign chef" t-on-click.stop="kitchenAssign">
                            <i class="fa fa-user-plus" />
                        </button>
                    </t>
                </t>
            </div>
        </xpath>
    </t>
</templates>