<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_kitchen" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos_kitchen_screen</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="20"/>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_bills_and_receipts_section']" position="after">
                <block title="Advanced Kitchen" id="pos_kitchen_advanced_section">
                    <setting id="pos_kitchen_advanced_setting" string="Advanced Kitchen Screen"
                             help="Station routing, order priority, chef assignment, table readiness, delay analytics and workload balancing on the preparation displays.">
                        <field name="pos_kitchen_advanced"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
