<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Root App Menu -->
    <menuitem
        id="menu_locker_root"
        name="Locker Management"
        web_icon="iPredict_locker_management,static/description/icon.png"
        sequence="50"/>

    <!-- Transactions -->
    <menuitem
        id="menu_locker_allocation"
        name="Locker Allocations"
        parent="menu_locker_root"
        action="action_locker_allocation"
        sequence="10"/>

    <!-- Configuration -->
    <menuitem
        id="menu_locker_configuration"
        name="Configuration"
        parent="menu_locker_root"
        sequence="100"/>

    <menuitem
        id="menu_locker_profile"
        name="Locker Profiles"
        parent="menu_locker_configuration"
        action="action_locker_profile"
        sequence="10"/>

    <menuitem
        id="menu_locker"
        name="Lockers"
        parent="menu_locker_configuration"
        action="action_locker"
        sequence="20"/>

    <menuitem id="menu_locker_3d_view"
              name="3D View"
              parent="menu_locker_root"
              action="action_locker_3d_view"
              sequence="5"/>

</odoo>