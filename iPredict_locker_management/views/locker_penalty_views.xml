<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Locker Penalty List -->
    <record id="view_locker_penalty_list" model="ir.ui.view">
        <field name="name">locker.penalty.list</field>
        <field name="model">locker.penalty</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id"/>
                <field name="amount" widget="monetary"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="period"/>
                <field name="start_after_days"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>


    <!-- Locker Penalty Form -->
    <record id="view_locker_penalty_form" model="ir.ui.view">
        <field name="name">locker.penalty.form</field>
        <field name="model">locker.penalty</field>
        <field name="arch" type="xml">
            <form string="Locker Penalty">
                <sheet>

                    <div class="oe_title">
                        <h1>
                            <field name="name"
                                   placeholder="Locker Penalty"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="company_id"/>
                            <field name="active"/>
                        </group>

                        <group>
                            <field name="amount"/>
                            <field name="currency_id"
                                   invisible="1"/>
                            <field name="period"/>
                            <field name="start_after_days"/>
                        </group>
                    </group>

                    <separator string="Description"/>

                    <field name="description"
                           placeholder="Add description..."/>

                </sheet>
            </form>
        </field>
    </record>


    <!-- Locker Penalty Search -->
    <record id="view_locker_penalty_search" model="ir.ui.view">
        <field name="name">locker.penalty.search</field>
        <field name="model">locker.penalty</field>
        <field name="arch" type="xml">
            <search>

                <field name="name"/>
                <field name="company_id"/>
                <field name="period"/>

                <separator/>

                <filter
                    name="active"
                    string="Active"
                    domain="[('active', '=', True)]"/>

                <filter
                    name="inactive"
                    string="Inactive"
                    domain="[('active', '=', False)]"/>

                <separator/>

                <group>
                    <filter
                        name="group_company"
                        string="Company"
                        context="{'group_by': 'company_id'}"/>

                    <filter
                        name="group_period"
                        string="Period"
                        context="{'group_by': 'period'}"/>
                </group>

            </search>
        </field>
    </record>


    <!-- Locker Penalty Action -->
    <record id="action_locker_penalty" model="ir.actions.act_window">
        <field name="name">Locker Penalty</field>
        <field name="res_model">locker.penalty</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id"
               ref="view_locker_penalty_search"/>
    </record>


</odoo>