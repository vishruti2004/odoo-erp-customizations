<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Return Reason List -->
    <record id="view_locker_return_reason_list" model="ir.ui.view">
        <field name="name">locker.return.reason.list</field>
        <field name="model">locker.return.reason</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Return Reason Form -->
    <record id="view_locker_return_reason_form" model="ir.ui.view">
        <field name="name">locker.return.reason.form</field>
        <field name="model">locker.return.reason</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active" widget="boolean_toggle"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Return Reason Action -->
    <record id="action_locker_return_reason" model="ir.actions.act_window">
        <field name="name">Return Reasons</field>
        <field name="res_model">locker.return.reason</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>