<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_locker_profile_list" model="ir.ui.view">
        <field name="name">locker.profile.list</field>
        <field name="model">locker.profile</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="access_method"/>
                <field name="allocation_type"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_locker_profile_form" model="ir.ui.view">
        <field name="name">locker.profile.form</field>
        <field name="model">locker.profile</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <!-- Stat Buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_view_lockers" class="oe_stat_button" icon="fa-archive">
                            <field name="locker_count" widget="statinfo" string="Lockers"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Profile Name"/>
                        </h1>
                    </div>

                    <!-- Profile Configuration -->
                    <group>
                        <group>
                            <field name="company_id"/>
                            <field name="access_method"/>
                            <field name="allocation_type"/>
                            <!-- <field name="color" widget="color_picker"/> -->
                            <field name="color" widget="color"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="rental_product_id" required="allocation_type == 'paid'"/>
                            <field name="deposit_required" invisible="allocation_type != 'paid'"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="deposit_amount" widget="monetary" invisible="allocation_type != 'paid' or not deposit_required" required="allocation_type == 'paid' and deposit_required"/>
                        </group>
                    </group>

                    <!-- Additional Details -->
                    <notebook>
                        <page string="Notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>

                <!-- Chatter -->
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_locker_profile" model="ir.actions.act_window">
        <field name="name">Locker Profiles</field>
        <field name="res_model">locker.profile</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>