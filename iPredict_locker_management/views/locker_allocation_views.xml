<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_locker_allocation_list" model="ir.ui.view">
        <field name="name">locker.allocation.list</field>
        <field name="model">locker.allocation</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="locker_id"/>
                <field name="partner_id"/>
                <field name="profile_id"/>
                <field name="access_method"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'allocated'" decoration-warning="state == 'returned'" decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_locker_allocation_form" model="ir.ui.view">
        <field name="name">locker.allocation.form</field>
        <field name="model">locker.allocation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_create_invoice" type="object" string="Create Invoice" class="btn-primary" invisible="allocation_type != 'paid' or invoice_id or state != 'draft'"/>
                    <button name="action_allocate" type="object" string="Allocate" class="btn-primary" invisible="state != 'draft' or (allocation_type == 'paid' and not invoice_id)"/>
                    <button name="action_return" type="object" string="Return" invisible="state != 'allocated'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state not in ('draft', 'allocated')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,allocated,returned,cancelled"/>
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_invoice" type="object" class="oe_stat_button" icon="fa-file-text-o" invisible="not invoice_id">
                            <field name="invoice_count" widget="statinfo" string="Invoice"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="locker_id" readonly="state != 'draft'"/>
                            <field name="profile_id" readonly="1"/>
                            <field name="access_method" readonly="1"/>
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="authorized_partner_ids" widget="many2many_tags" readonly="state != 'draft'"/>
                            <field name="company_id" readonly="state != 'draft'"/>
                            <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'allocated'" decoration-warning="state == 'returned'" decoration-danger="state == 'cancelled'" readonly="1"/>
                        </group>

                        <group>
                            <field name="start_date" readonly="state != 'draft'"/>
                            <field name="end_date" readonly="state != 'draft'"/>
                            <field name="allocation_type" readonly="1"/>
                            <field name="invoice_id" readonly="1"/>
                            <field name="payment_state" readonly="1"/>
                        </group>
                    </group>

                    <separator string="Authentication / Identity"/>

                    <field name="credential_ids" nolabel="1" options="{'no_open': True}">
                        <list editable="bottom" create="0" delete="0">
                            <field name="partner_id" readonly="1"/>
                            <field name="access_method" readonly="1"/>
                            <field name="pin_code" readonly="1" column_invisible="parent.access_method != 'pin'"/>
                            <field name="rfid_uid" readonly="1" column_invisible="parent.access_method != 'rfid'"/>
                            <field name="qr_token" readonly="1" column_invisible="parent.access_method != 'qr'"/>
                            <field name="qr_code" widget="image" readonly="1" column_invisible="parent.access_method != 'qr'" width="60px" height="60px"/>
                            <field name="biometric_id" readonly="1" column_invisible="parent.access_method != 'biometric'"/>
                            <button name="action_generate_credential" type="object" string="Generate" class="btn-primary" invisible="parent.access_method in ('physical_key', 'biometric')"/>
                        </list>
                    </field>

                    <notebook>
                        <page string="Notes">
                            <field name="note" readonly="state != 'draft'"/>
                        </page>
                    </notebook>
                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_locker_allocation" model="ir.actions.act_window">
        <field name="name">Locker Allocations</field>
        <field name="res_model">locker.allocation</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>