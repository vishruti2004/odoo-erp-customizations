<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_locker_management" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.locker.management</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Locker Management" name="iPredict_locker_management" logo="/iPredict_locker_management/static/description/icon.png">

                    <!-- LOCKER SETTINGS -->

                    <block title="Locker Settings">
                        <setting string="Available Locker Color" help="Set the color used for available lockers in the 3D view.">
                            <field name="available_locker_color" widget="color" />
                        </setting>

                        <setting string="Allocated Locker Color" help="Set the color used for allocated lockers in the 3D view.">
                            <field name="allocated_locker_color" widget="color" />
                        </setting>

                        <setting string="Reserved Locker Color" help="Set the color used for reserved lockers in the 3D view.">
                            <field name="reserved_locker_color" widget="color" />
                        </setting>

                        <setting string="Locker Reservation Hours" help="A reserved locker (draft allocation) is released automatically after these hours.">
                            <field name="locker_reservation_hours" />
                        </setting>

                        <setting string="Renewal Reminder Days" help="Number of days before locker expiry when renewal becomes pending.">
                            <field name="renewal_reminder_days" />
                        </setting>

                        <setting string="Kiosk Authentication Lock Time" help="Seconds a person stays locked after 3 wrong authentication attempts in the kiosk (maximum 300 seconds).">
                            <field name="locker_auth_lock_seconds" />
                        </setting>

                        <setting string="Enable 3D Locker View" help="Enable 3D view configuration for locker locations.">
                            <field name="enable_3d_locker_view" />
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

</odoo>