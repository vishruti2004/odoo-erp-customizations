<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_locker_list" model="ir.ui.view">
        <field name="name">locker.locker.list</field>
        <field name="model">locker.locker</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="profile_id"/>
                <field name="company_id"/>
                <field name="status"/>
                <field name="allocation_count"/>
            </list>
        </field>
    </record>

    <!-- Form View -->

    <record id="view_locker_form" model="ir.ui.view">
        <field name="name">locker.locker.form</field>
        <field name="model">locker.locker</field>
        <field name="arch" type="xml">
            <form>

                <header>
                    <field name="status" widget="statusbar" statusbar_visible="available,allocated"/>
                </header>

                <sheet>
                    <!-- Smart Button -->
                    <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_view_allocations" class="oe_stat_button" icon="fa-history">
                            <field name="allocation_count" widget="statinfo" string="Allocations"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Locker Number"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="profile_id"/>
                            <field name="company_id"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="status" readonly="1"/>
                            <field name="current_allocation_id" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Notes">
                            <field name="note"/>
                        </page>

                        <page string="Allocation History">
                            <field name="allocation_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>

                </sheet>

                <chatter/>

            </form>
        </field>
    </record>

    <!-- Action -->

    <record id="action_locker" model="ir.actions.act_window">
        <field name="name">Lockers</field>
        <field name="res_model">locker.locker</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>