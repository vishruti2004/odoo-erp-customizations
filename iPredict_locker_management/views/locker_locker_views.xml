<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_locker_list" model="ir.ui.view">
        <field name="name">locker.locker.list</field>
        <field name="model">locker.locker</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="profile_id"/>
                <field name="locker_location_id"/>
                <!-- <field name="location_id"/> -->
                <field name="status" widget="badge" decoration-success="status == 'available'" decoration-danger="status == 'allocated'"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_locker_form" model="ir.ui.view">
        <field name="name">locker.locker.form</field>
        <field name="model">locker.locker</field>
        <field name="arch" type="xml">
            <form>
                <sheet>

                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_allocations"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-history">
                            <span class="o_stat_text">History</span>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Locker Number"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="profile_id"/>
                            <field name="locker_location_id"/>
                            <!-- <field name="location_id"/> -->
                            <field name="active" widget="boolean_toggle"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="status" widget="badge" readonly="1" decoration-success="status == 'available'" decoration-danger="status == 'allocated'"/>
                        </group>
                    </group>

                    <!-- Additional Details -->
                    <notebook>
                        <page string="Notes">
                            <field name="note"/>
                        </page>

                        <page string="3D Configuration">
                            <group>
                                <group string="Position">
                                    <field name="pos_x"/>
                                    <field name="pos_y"/>
                                    <field name="pos_z"/>
                                </group>
                                <group string="Dimension">
                                    <field name="width"/>
                                    <field name="height"/>
                                    <field name="depth"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>

                <!-- <chatter/> -->
            </form>
        </field>
    </record>

    <record id="action_locker_3d_view" model="ir.actions.client">
        <field name="name">3D Locker View</field>
        <field name="tag">locker_3d_view</field>
    </record>

    <record id="action_locker" model="ir.actions.act_window">
        <field name="name">Lockers</field>
        <field name="res_model">locker.locker</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>