<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_locker_access_credential_list" model="ir.ui.view">
        <field name="name">locker.access.credential.list</field>
        <field name="model">locker.access.credential</field>
        <field name="arch" type="xml">
            <list>
                <field name="allocation_id"/>
                <field name="partner_id"/>
                <field name="access_method"/>
                <field name="pin_code" password="True"/>
                <field name="rfid_uid"/>
                <field name="qr_token"/>
                <field name="biometric_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_locker_access_credential_form" model="ir.ui.view">
        <field name="name">locker.access.credential.form</field>
        <field name="model">locker.access.credential</field>
        <field name="arch" type="xml">
            <form string="Authentication Credential">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="partner_id" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <field name="allocation_id" readonly="1"/>
                        <field name="partner_id" readonly="1"/>
                        <field name="access_method" readonly="1"/>
                        <field name="active"/>
                    </group>

                    <separator string="Authentication"/>

                    <group>
                        <field name="pin_code" password="True" readonly="1" invisible="access_method != 'pin'"/>
                        <field name="rfid_uid" readonly="1" invisible="access_method != 'rfid'"/>
                        <field name="qr_token" readonly="1" invisible="access_method != 'qr'"/>
                        <field name="biometric_id" readonly="1" invisible="access_method != 'biometric'"/>
                    </group>

                    <div class="text-center">
                        <button name="action_generate_credential" type="object" string="Generate" class="btn btn-primary" icon="fa-refresh" invisible="not active"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_locker_access_credential" model="ir.actions.act_window">
        <field name="name">Authentication Credentials</field>
        <field name="res_model">locker.access.credential</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>