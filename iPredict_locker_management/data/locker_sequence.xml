<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Locker Sequence -->

    <record id="seq_locker" model="ir.sequence">
        <field name="name">Locker</field>
        <field name="code">locker.locker</field>
        <field name="prefix">LK/%(year)s/</field>
        <field name="padding">5</field>
        <field name="number_increment">1</field>
    </record>

    <!-- Locker Allocation Sequence -->

    <record id="seq_locker_allocation" model="ir.sequence">
        <field name="name">Locker Allocation</field>
        <field name="code">locker.allocation</field>
        <field name="prefix">LA/%(year)s/</field>
        <field name="padding">5</field>
        <field name="number_increment">1</field>
    </record>

</odoo>