<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_locker_return_wizard_form" model="ir.ui.view">
        <field name="name">locker.return.wizard.form</field>
        <field name="model">locker.return.wizard</field>
        <field name="arch" type="xml">
            <form string="Return Locker">

                <group>
                    <field name="allocation_id" invisible="1"/>
                    <field name="locker_id" readonly="1"/>
                    <field name="return_date"/>
                    <field name="return_reason_id" options="{'no_create': True, 'no_open': True}"/>
                </group>

                <footer>
                    <button name="action_confirm_return"
                            type="object"
                            string="Return"
                            class="btn-primary"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>

            </form>
        </field>
    </record>

</odoo>