<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="iPredict_locker_management.Locker3DView">
        <div class="o_locker_3d_container">

            <div class="o_locker_header">
                <div class="o_locker_filters" t-if="state.isAdmin">
                    <div class="filter_item">
                        <label class="fw-bold text-muted small">Company</label>
                        <select class="form-select form-select-sm" t-on-change="onCompanyChange">
                            <option value="">All Companies</option>
                            <t t-if="state.companies and state.companies.length">
                                <t t-foreach="state.companies" t-as="company" t-key="company.id">
                                    <option t-att-value="company.id"
                                            t-att-selected="company.id === state.selectedCompanyId">
                                        <t t-esc="company.name"/>
                                    </option>
                                </t>
                            </t>
                        </select>
                    </div>
                    <div class="filter_item">
                        <label class="fw-bold text-muted small">Locker Location</label>
                        <select class="form-select form-select-sm" t-on-change="onLockerLocationChange">
                            <option value="">All Locations</option>
                            <t t-if="state.lockerLocations and state.lockerLocations.length">
                                <t t-foreach="state.lockerLocations" t-as="location" t-key="location.id">
                                    <option t-att-value="location.id"
                                            t-att-selected="location.id === state.selectedLockerLocationId">
                                        <t t-esc="location.name"/>
                                    </option>
                                </t>
                            </t>
                        </select>
                    </div>
                </div>

                <!-- CENTER: Search Bar -->
                <div class="o_locker_search" t-if="state.hasLockers">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white border-end-0">
                            <i class="fa fa-search text-muted"/>
                        </span>
                        <input type="text" class="form-control form-control-sm border-start-0" 
                               placeholder="Search Locker Number..." 
                               t-model="state.searchQuery" 
                               t-on-input="apply3DFilters"/>
                        <button class="btn btn-outline-secondary btn-sm border-start-0" 
                                t-if="state.searchQuery" 
                                t-on-click="clearSearch">
                            <i class="fa fa-times-circle"/>
                        </button>
                    </div>
                </div>

                <div class="o_locker_header_right">
                    <button t-if="state.hasLockers and state.isAdmin" 
                            class="btn btn-sm btn-primary" 
                            t-on-click="toggleEditMode">
                        <t t-if="state.isEditMode">Save</t>
                        <t t-else="">Edit</t>
                    </button>
                </div>
            </div>

            <div class="locker_canvas_wrapper">
                <div t-ref="canvas" class="locker_canvas"/>

                <!-- Legend Box -->
                <div class="o_locker_canvas_legend" t-if="state.hasLockers">
                    <div class="legend_section">
                        <div class="o_legend_title">Status</div>
                        <div class="o_legend_items">
                            <div class="o_legend_item clickable" 
                                 t-att-class="{'active-filter': state.activeStatusFilter === 'available'}"
                                 t-on-click="() => this.toggleStatusFilter('available')">
                                <span class="o_legend_color" t-attf-style="border: 2px solid {{state.statusColors.available}}; background: transparent;"></span>
                                <span>Available</span>
                            </div>
                            <div class="o_legend_item clickable" 
                                 t-att-class="{'active-filter': state.activeStatusFilter === 'allocated'}"
                                 t-on-click="() => this.toggleStatusFilter('allocated')">
                                <span class="o_legend_color" t-attf-style="border: 2px solid {{state.statusColors.allocated}}; background: transparent;"></span>
                                <span>Allocated</span>
                            </div>
                        </div>
                    </div>

                    <div class="legend_divider"></div>

                    <div class="legend_section">
                        <div class="o_legend_title">Locker Types</div>
                        <div class="o_legend_items">
                            <t t-if="state.profilesList and state.profilesList.length">
                                <t t-foreach="state.profilesList" t-as="prof" t-key="prof.id">
                                    <div class="o_legend_item clickable"
                                         t-att-class="{'active-filter': state.activeProfileFilter === prof.id}"
                                         t-on-click="() => this.toggleProfileFilter(prof.id)">
                                        <span class="o_legend_color" t-attf-style="background-color: {{prof.color}};"></span>
                                        <span><t t-esc="prof.name"/></span>
                                    </div>
                                </t>
                            </t>
                        </div>
                    </div>
                </div>

                <!-- Popup -->
                <t t-if="state.selectedLocker">
                    <div class="locker_info_popup">
                        <div class="popup_header">
                            <span>Locker Detail</span>
                            <button class="popup_close btn btn-link p-0 text-muted" t-on-click="closePopup" aria-label="Close">
                                <i class="fa fa-times"/>
                            </button>
                        </div>

                        <div class="popup_body">
                            <table>
                                <tbody>
                                    <tr>
                                        <td class="label">Locker No</td>
                                        <td class="value"><t t-esc="state.selectedLocker.name"/></td>
                                    </tr>
                                    <tr>
                                        <td class="label">Profile</td>
                                        <td class="value"><t t-esc="state.selectedLocker.profile"/></td>
                                    </tr>
                                    <tr>
                                        <td class="label">Location</td>
                                        <td class="value"><t t-esc="state.selectedLocker.locker_location"/></td>
                                    </tr>
                                    <tr>
                                        <td class="label">Status</td>
                                        <td class="value">
                                            <t t-if="state.selectedLocker.status === 'allocated'">
                                                <span class="badge rounded-pill bg-danger">
                                                    Allocated
                                                </span>
                                            </t>
                                            <t t-else="">
                                                <span class="badge rounded-pill bg-success">
                                                    Available
                                                </span>
                                            </t>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </t>
            </div>
        </div>
    </t>
</templates>