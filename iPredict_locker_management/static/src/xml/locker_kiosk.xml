<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="iPredict_locker_management.LockerKiosk">
        <div class="locker-kiosk">
            <div class="locker-kiosk-header">
                <t t-if="state.mode === 'person_search'">
                    <h1>Locker Check In / Check Out</h1>
                    <p>Enter Name, Email or Phone Number</p>
                </t>
                <!-- <t t-elif="state.mode === 'person_selection'">
                    <h1>Select Person</h1>
                    <p>Select the person who wants to access the locker</p>
                </t> -->
                <t t-elif="state.mode === 'credential'">
                    <h1>Authenticate</h1>
                    <p>Verify the selected person's identity</p>
                </t>
                <t t-elif="state.mode === 'qr_verification'">
                    <h1>Choose Authentication</h1>
                    <p>QR code verified. Continue with OTP verification.</p>
                </t>
                <t t-elif="state.mode === 'otp'">
                    <h1>OTP Verification</h1>
                    <p>Enter the OTP sent to the registered email address.</p>
                </t>
                <t t-elif="state.mode === 'locked'">
                    <h1>Authentication Locked</h1>
                    <p>Too many incorrect OTP attempts</p>
                </t>
                <!-- <t t-elif="state.mode === 'companion_selection'">
                    <h1>People With You</h1>
                    <p>How many additional people are entering with you?</p>
                </t> -->
                <t t-elif="state.mode === 'result'">
                    <h1>Identity Verified</h1>
                    <p>Authentication successful</p>
                </t>
            </div>
            <div class="locker-checkin-layout">
                <div class="locker-checkin-column">
                    <t t-if="state.mode === 'person_search'">
                        <div class="locker-authentication-card locker-checkin-card">
                            <div class="locker-auth-icon">
                                <i class="fa fa-user"/>
                            </div>
                            <h2>Find Person</h2>
                            <p>
                                Search for the person using Name, Email or Phone Number
                            </p>
                            <input type="text"
                                   class="locker-person-search-input"
                                   placeholder="Enter Name / Email / Phone"
                                   t-att-value="state.personSearch"
                                   t-on-input="onPersonSearchChange"
                                   t-on-keyup="(ev) => ev.key === 'Enter' &amp;&amp; findPerson()"
                                   autocomplete="off"/>
                            <button type="button"
                                    class="btn btn-primary locker-authenticate-button"
                                    t-on-click="findPerson"
                                    t-att-disabled="state.loading">
                                <t t-if="state.loading">
                                    Searching...
                                </t>
                                <t t-else="">
                                    Find Person
                                </t>
                            </button>
                            <div class="locker-access-info">
                                <div class="locker-access-info-title">
                                    <i class="fa fa-shield me-2"/>
                                    Secure Locker Access
                                </div>
                                <div class="locker-access-info-text">
                                    Your identity will be verified before locker access.
                                </div>
                                <div class="locker-access-features">
                                    <span>
                                        <i class="fa fa-check me-1"/>
                                        Identity Verification
                                    </span>
                                    <span>
                                        <i class="fa fa-check me-1"/>
                                        Secure Authentication
                                    </span>
                                    <span>
                                        <i class="fa fa-check me-1"/>
                                        Access Recorded
                                    </span>
                                </div>
                            </div>
                            <t t-if="state.message">
                                <div t-att-class="'locker-message ' + state.messageType">
                                    <t t-esc="state.message"/>
                                </div>
                            </t>
                        </div>
                    </t>
                    <t t-elif="state.mode === 'person_selection'">
                        <div class="locker-authentication-card locker-person-selection-card locker-checkin-card">
                            <div class="locker-auth-icon">
                                <i class="fa fa-users"/>
                            </div>
                            <h2>Authorized Persons</h2>
                            <div class="locker-person-list">
                                <t t-foreach="state.persons"
                                   t-as="person"
                                   t-key="person.partner_id + '-' + person.allocation_id">
                                    <button type="button"
                                            class="locker-person-option"
                                            t-on-click="() => selectPerson(person)">
                                        <div class="locker-person-option-icon">
                                            <i class="fa fa-user"/>
                                        </div>
                                        <div class="locker-person-option-info">
                                            <strong>
                                                <t t-esc="person.partner_name"/>
                                            </strong>
                                            <span>
                                                Locker:
                                                <t t-esc="person.locker_name"/>
                                            </span>
                                            <span>
                                                Access:
                                                <t t-esc="person.access_method"/>
                                            </span>
                                        </div>
                                        <div class="locker-person-option-arrow">
                                            <i class="fa fa-chevron-right"/>
                                        </div>
                                    </button>
                                </t>
                            </div>
                            <t t-if="state.message">
                                <div t-att-class="'locker-message ' + state.messageType">
                                    <t t-esc="state.message"/>
                                </div>
                            </t>
                            <button type="button"
                                    class="btn btn-link locker-reset-button"
                                    t-on-click="backToPersonSearch">
                                Back to Search
                            </button>
                        </div>
                    </t>
                    <t t-elif="state.mode === 'credential'">
                        <div class="locker-result-card locker-credential-card locker-checkin-card">
                            <div class="locker-success-icon">
                                <i class="fa fa-user"/>
                            </div>
                            <h2>
                                <t t-esc="state.selectedPerson.partner_name"/>
                            </h2>
                            <div class="locker-information">
                                <div class="locker-info-row">
                                    <span>Locker</span>
                                    <strong>
                                        <t t-esc="state.selectedPerson.locker_name"/>
                                    </strong>
                                </div>
                                <div class="locker-info-row">
                                    <span>Locker Profile</span>
                                    <strong>
                                        <t t-esc="state.selectedPerson.profile_name"/>
                                    </strong>
                                </div>
                                <div class="locker-info-row">
                                    <span>Access Method</span>
                                    <strong>
                                        <t t-esc="state.selectedPerson.access_method"/>
                                    </strong>
                                </div>
                            </div>
                            <div class="locker-credential-section">
                                <t t-if="state.selectedPerson.access_method === 'pin'">
                                    <p>Enter your PIN</p>
                                    <input type="password"
                                           class="locker-authentication-input"
                                           placeholder="Enter 6 Digit PIN"
                                           maxlength="6"
                                           inputmode="numeric"
                                           t-att-value="state.authentication"
                                           t-on-input="onInputChange"
                                           t-on-keyup="(ev) => ev.key === 'Enter' &amp;&amp; authenticate()"
                                           autocomplete="off"/>
                                    <button type="button"
                                            class="btn btn-primary locker-action-button"
                                            t-on-click="authenticate"
                                            t-att-disabled="state.loading">
                                        <t t-if="state.loading">
                                            Authenticating...
                                        </t>
                                        <t t-else="">
                                            Authenticate PIN
                                        </t>
                                    </button>
                                </t>
                                <t t-elif="state.selectedPerson.access_method === 'rfid'">
                                    <div class="locker-method-icon">
                                        <i class="fa fa-credit-card"/>
                                    </div>
                                    <h3 class="locker-method-title">
                                        Scan RFID Card
                                    </h3>
                                    <p>
                                        Please scan your RFID card on the reader
                                    </p>
                                    <input type="text"
                                           class="locker-authentication-input locker-rfid-input"
                                           placeholder="Scan RFID Card"
                                           t-att-value="state.authentication"
                                           t-on-input="onInputChange"
                                           t-on-keyup="(ev) => ev.key === 'Enter' &amp;&amp; authenticate()"
                                           autocomplete="off"/>
                                    <button type="button"
                                            class="btn btn-primary locker-action-button"
                                            t-on-click="authenticate"
                                            t-att-disabled="state.loading">
                                        <t t-if="state.loading">
                                            Authenticating...
                                        </t>
                                        <t t-else="">
                                            Authenticate RFID
                                        </t>
                                    </button>
                                </t>
                                <t t-elif="state.selectedPerson.access_method === 'qr'">
                                    <h3 class="locker-method-title">
                                        Scan QR Code
                                    </h3>
                                    <p>
                                        Place your QR code inside the scanner
                                    </p>
                                    <div class="locker-qr-scanner">
                                        <video class="locker-qr-video"
                                               autoplay="autoplay"
                                               muted="muted"
                                               playsinline="playsinline"/>
                                        <div class="locker-qr-frame">
                                            <span class="qr-corner qr-top-left"/>
                                            <span class="qr-corner qr-top-right"/>
                                            <span class="qr-corner qr-bottom-left"/>
                                            <span class="qr-corner qr-bottom-right"/>
                                            <div class="qr-scan-line"/>
                                        </div>
                                        <t t-if="!state.qrScanning">
                                            <div class="locker-qr-overlay">
                                                <i class="fa fa-qrcode"/>
                                                <span>Starting Camera...</span>
                                            </div>
                                        </t>
                                    </div>
                                    <div class="locker-qr-status">
                                        <t t-if="state.qrScanning">
                                            <i class="fa fa-camera me-1"/>
                                            Scanning QR code...
                                        </t>
                                        <t t-else="">
                                            <i class="fa fa-spinner fa-spin me-1"/>
                                            Starting camera...
                                        </t>
                                    </div>
                                    <t t-if="state.loading">
                                        <button type="button"
                                                class="btn btn-primary locker-action-button"
                                                disabled="disabled">
                                            Verifying QR...
                                        </button>
                                    </t>
                                </t>
                                <t t-elif="state.selectedPerson.access_method === 'biometric'">
                                    <div class="locker-method-icon">
                                        <i class="fa fa-camera"/>
                                    </div>
                                    <h3 class="locker-method-title">
                                        Face Recognition
                                    </h3>
                                    <p>
                                        Look at the camera to verify your identity
                                    </p>
                                    <div class="locker-face-scanner">
                                        <video class="locker-face-video"
                                               autoplay="autoplay"
                                               muted="muted"
                                               playsinline="playsinline"/>
                                        <div class="locker-face-frame">
                                            <div class="locker-face-corner face-top-left"/>
                                            <div class="locker-face-corner face-top-right"/>
                                            <div class="locker-face-corner face-bottom-left"/>
                                            <div class="locker-face-corner face-bottom-right"/>
                                        </div>
                                        <t t-if="!state.faceScanning">
                                            <div class="locker-face-overlay">
                                                <i class="fa fa-camera"/>
                                                <span>Starting Camera...</span>
                                            </div>
                                        </t>
                                    </div>
                                    <div class="locker-face-status">
                                        <t t-if="state.faceScanning">
                                            <i class="fa fa-camera me-1"/>
                                            Looking for your face...
                                        </t>
                                        <t t-else="">
                                            <i class="fa fa-spinner fa-spin me-1"/>
                                            Starting camera...
                                        </t>
                                    </div>
                                    <t t-if="state.faceVerifying">
                                        <button type="button"
                                                class="btn btn-primary locker-action-button"
                                                disabled="disabled">
                                            Verifying Face...
                                        </button>
                                    </t>
                                    <t t-else="">
                                        <button type="button"
                                                class="btn btn-primary locker-action-button"
                                                t-on-click="verifyFace"
                                                t-att-disabled="state.loading || !state.faceScanning">
                                            <i class="fa fa-user me-2"/>
                                            Verify Face
                                        </button>
                                    </t>
                                </t>
                                <t t-else="">
                                    <p>Authenticate your identity</p>
                                    <input type="text"
                                           class="locker-authentication-input"
                                           placeholder="Scan / Enter Credential"
                                           t-att-value="state.authentication"
                                           t-on-input="onInputChange"
                                           t-on-keyup="(ev) => ev.key === 'Enter' &amp;&amp; authenticate()"
                                           autocomplete="off"/>
                                    <button type="button"
                                            class="btn btn-primary locker-action-button"
                                            t-on-click="authenticate"
                                            t-att-disabled="state.loading">
                                        <t t-if="state.loading">
                                            Authenticating...
                                        </t>
                                        <t t-else="">
                                            Authenticate
                                        </t>
                                    </button>
                                </t>
                            </div>
                            <t t-if="state.message">
                                <div t-att-class="'locker-message ' + state.messageType">
                                    <t t-esc="state.message"/>
                                </div>
                            </t>
                            <button type="button"
                                    class="btn btn-link locker-reset-button"
                                    t-on-click="backToPersonSearch">
                                Back to Person Selection
                            </button>
                        </div>
                    </t>
                    <t t-elif="state.mode === 'qr_verification'">
                        <div class="locker-result-card locker-qr-auth-card locker-checkin-card">
                            <div class="locker-success-icon">
                                <i class="fa fa-check-circle"/>
                            </div>
                            <h2>QR Code Verified</h2>
                            <p>
                                Verify your identity using the OTP sent to your registered email address.
                            </p>
                            <div class="locker-qr-auth-options">
                                <button type="button"
                                        class="btn btn-primary locker-action-button"
                                        t-if="state.qrHasOTP"
                                        t-on-click="chooseOTP"
                                        t-att-disabled="state.loading">
                                    <i class="fa fa-envelope me-2"/>
                                    Send OTP
                                </button>
                                <t t-if="!state.qrHasOTP">
                                    <div class="locker-message danger">
                                        OTP authentication is not configured for this person.
                                    </div>
                                </t>
                            </div>
                            <t t-if="state.message">
                                <div t-att-class="'locker-message ' + state.messageType">
                                    <t t-esc="state.message"/>
                                </div>
                            </t>
                            <button type="button"
                                    class="btn btn-link locker-reset-button"
                                    t-on-click="backToPersonSearch">
                                Back to Person Search
                            </button>
                        </div>
                    </t>
                    <t t-elif="state.mode === 'otp'">
                        <div class="locker-result-card locker-qr-auth-card locker-checkin-card">
                            <div class="locker-auth-icon">
                                <i class="fa fa-mobile"/>
                            </div>
                            <h2>Verify OTP</h2>
                            <p>
                                A 6-digit OTP has been sent to the registered email address.
                            </p>
                            <input type="text"
                                   class="locker-authentication-input locker-otp-input"
                                   placeholder="Enter 6 Digit OTP"
                                   maxlength="6"
                                   inputmode="numeric"
                                   t-att-value="state.otp"
                                   t-on-input="onOTPChange"
                                   t-on-keyup="(ev) => ev.key === 'Enter' &amp;&amp; verifyOTP()"
                                   autocomplete="off"/>
                            <button type="button"
                                    class="btn btn-primary locker-action-button"
                                    t-on-click="verifyOTP"
                                    t-att-disabled="state.loading">
                                <t t-if="state.loading">
                                    Verifying OTP...
                                </t>
                                <t t-else="">
                                    Verify OTP
                                </t>
                            </button>
                            <t t-if="state.message">
                                <div t-att-class="'locker-message ' + state.messageType">
                                    <t t-esc="state.message"/>
                                </div>
                            </t>
                            <button type="button"
                                    class="btn btn-link locker-reset-button"
                                    t-on-click="backToQRAuthentication">
                                Back to Authentication Options
                            </button>
                        </div>
                    </t>
                    <t t-elif="state.mode === 'locked'">
                        <div class="locker-result-card locker-qr-auth-card locker-checkin-card">
                            <div class="locker-auth-icon">
                                <i class="fa fa-lock"/>
                            </div>
                            <h2>Access Temporarily Locked</h2>
                            <p>
                                You have already used the maximum number of OTP attempts.
                            </p>
                            <div class="locker-message danger">
                                <t t-esc="state.message or 'Please try again after 10 minutes.'"/>
                            </div>
                            <p>
                                Please wait until the lock period ends before trying again.
                            </p>
                            <button type="button"
                                    class="btn btn-link locker-reset-button"
                                    t-on-click="backToPersonSearch">
                                Back to Person Search
                            </button>
                        </div>
                    </t>
                    <t t-elif="state.mode === 'companion_selection'">
                        <div class="locker-result-card locker-companion-card locker-checkin-card">
                            <div class="locker-success-icon locker-companion-icon">
                                <i class="fa fa-users"/>
                            </div>
                            <h2>People With You</h2>
                            <p class="locker-companion-description">
                                How many additional people are entering with you?
                            </p>
                            <div class="locker-companion-counter">
                                <button type="button"
                                        class="locker-companion-btn"
                                        t-on-click="decreaseCompanionCount"
                                        t-att-disabled="state.companionCount === 0">
                                    <i class="fa fa-minus"/>
                                </button>
                                <div class="locker-companion-count">
                                    <strong>
                                        <t t-esc="state.companionCount"/>
                                    </strong>
                                    <span>Additional People</span>
                                </div>
                                <button type="button"
                                        class="locker-companion-btn"
                                        t-on-click="increaseCompanionCount">
                                    <i class="fa fa-plus"/>
                                </button>
                            </div>
                            <div class="locker-companion-total">
                                <i class="fa fa-users"/>
                                <span>Total People</span>
                                <strong>
                                    <t t-esc="state.companionCount + 1"/>
                                </strong>
                            </div>
                            <button type="button"
                                    class="btn btn-primary locker-action-button locker-companion-confirm"
                                    t-on-click="confirmCompanionCount"
                                    t-att-disabled="state.loading">
                                <i class="fa fa-check"/>
                                <span>OK</span>
                            </button>
                            <t t-if="state.message">
                                <div t-att-class="'locker-message ' + state.messageType">
                                    <t t-esc="state.message"/>
                                </div>
                            </t>
                            <button type="button"
                                    class="btn btn-link locker-reset-button locker-companion-cancel"
                                    t-on-click="backToPersonSearch">
                                Cancel
                            </button>
                        </div>
                    </t>
                    <t t-elif="state.mode === 'result'">
                        <div class="locker-result-card locker-result-compact locker-checkin-card">
                            <div class="locker-success-icon">
                                <i class="fa fa-check-circle"/>
                            </div>
                            <div class="locker-authenticated-person">
                                <span>Authenticated Person</span>
                                <h2>
                                    <t t-esc="state.allocation.authenticated_partner_name"/>
                                </h2>
                            </div>
                            <div class="locker-information">
                                <div class="locker-info-row">
                                    <span>Allocation Partner</span>
                                    <strong>
                                        <t t-esc="state.allocation.partner_name"/>
                                    </strong>
                                </div>
                                <div class="locker-info-row">
                                    <span>Locker</span>
                                    <strong>
                                        <t t-esc="state.allocation.locker_name"/>
                                    </strong>
                                </div>
                                <div class="locker-info-row">
                                    <span>Locker Profile</span>
                                    <strong>
                                        <t t-esc="state.allocation.profile_name"/>
                                    </strong>
                                </div>
                                <div class="locker-info-row">
                                    <span>Access Method</span>
                                    <strong>
                                        <t t-esc="state.allocation.access_method"/>
                                    </strong>
                                </div>
                            </div>
                            <div class="locker-check-actions">
                                <button type="button"
                                        class="btn btn-primary locker-check-button"
                                        t-on-click="checkIn"
                                        t-if="state.allocation.can_check_in"
                                        t-att-disabled="state.loading">
                                    <i class="fa fa-sign-in me-2"/>
                                    <t t-if="state.loading">
                                        Processing...
                                    </t>
                                    <t t-else="">
                                        Check In
                                    </t>
                                </button>
                                <button type="button"
                                        class="btn btn-danger locker-check-button"
                                        t-on-click="checkOut"
                                        t-if="state.allocation.can_check_out"
                                        t-att-disabled="state.loading">
                                    <i class="fa fa-sign-out me-2"/>
                                    <t t-if="state.loading">
                                        Processing...
                                    </t>
                                    <t t-else="">
                                        Check Out
                                    </t>
                                </button>
                            </div>
                            <t t-if="state.message">
                                <div t-att-class="'locker-message ' + state.messageType">
                                    <t t-esc="state.message"/>
                                </div>
                            </t>
                            <button type="button"
                                    class="btn btn-link locker-reset-button"
                                    t-on-click="resetScreen">
                                Start New Authentication
                            </button>
                        </div>
                    </t>
                </div>
                <div class="locker-checkin-column locker-current-column">
                    <div class="locker-result-card locker-checkin-card locker-current-card">
                        <div class="locker-current-header">
                            <div>
                                <h2>Currently Checked In</h2>
                                <p>
                                    People who have not checked out yet
                                </p>
                            </div>
                            <div class="locker-current-count">
                                <t t-esc="getFilteredCurrentCheckedIn().length"/>
                            </div>
                        </div>
                        <input type="text"
                               class="locker-current-search"
                               placeholder="Search person or locker"
                               t-att-value="state.currentCheckedInSearch"
                               t-on-input="onCurrentCheckedInSearchChange"
                               autocomplete="off"/>
                        <div class="locker-current-list">
                            <t t-if="state.currentCheckedInLoading">
                                <div class="locker-current-empty">
                                    <i class="fa fa-spinner fa-spin"/>
                                    <strong>
                                        Loading...
                                    </strong>
                                </div>
                            </t>
                            <t t-elif="!getFilteredCurrentCheckedIn().length">
                                <div class="locker-current-empty">
                                    <i class="fa fa-check-circle"/>
                                    <strong>
                                        No one is currently checked in.
                                    </strong>
                                    <span>
                                        Everyone has checked out.
                                    </span>
                                </div>
                            </t>
                            <t t-else="">
                                <t t-foreach="getFilteredCurrentCheckedIn()"
                                   t-as="person"
                                   t-key="person.access_id">
                                    <div class="locker-current-person">
                                        <div class="locker-current-person-main">
                                            <div class="locker-current-person-icon">
                                                <i class="fa fa-user"/>
                                            </div>
                                            <div class="locker-current-person-info">
                                                <div class="locker-current-person-name">
                                                    <t t-esc="person.partner_name"/>
                                                    <span class="locker-current-total">
                                                        (<t t-esc="person.total_people or 1"/>)
                                                    </span>
                                                </div>
                                                <div class="locker-current-person-locker">
                                                    <i class="fa fa-lock me-1"/>
                                                    <t t-esc="person.locker_name"/>
                                                </div>
                                            </div>
                                            <span class="locker-access-badge">
                                                <t t-if="person.access_method === 'qr'">
                                                    <i class="fa fa-qrcode me-1"/>
                                                </t>
                                                <t t-elif="person.access_method === 'rfid'">
                                                    <i class="fa fa-credit-card me-1"/>
                                                </t>
                                                <t t-elif="person.access_method === 'biometric'">
                                                    <i class="fa fa-camera me-1"/>
                                                </t>
                                                <t t-elif="person.access_method === 'pin'">
                                                    <i class="fa fa-lock me-1"/>
                                                </t>
                                                <t t-elif="person.access_method === 'physical_key'">
                                                    <i class="fa fa-key me-1"/>
                                                </t>
                                                <t t-else="">
                                                    <i class="fa fa-shield me-1"/>
                                                </t>
                                                <t t-esc="person.access_method_label"/>
                                            </span>
                                            <span class="locker-checkin-time">
                                                <i class="fa fa-clock-o me-1"/>
                                                <t t-esc="person.formatted_check_in_time"/>
                                            </span>
                                            <button type="button"
                                                    class="locker-current-checkout-button"
                                                    t-on-click="() => checkOutCurrentPerson(person)"
                                                    t-att-disabled="state.loading">
                                                <i class="fa fa-sign-out me-1"/>
                                                Check Out
                                            </button>
                                        </div>
                                    </div>
                                </t>
                            </t>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>