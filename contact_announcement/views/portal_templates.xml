<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Portal Home: Display active announcements as alert banners -->
    <template id="portal_home_banner" inherit_id="portal.portal_my_home">
        <xpath expr="//div[@id='portal_common_category']" position="before">

            <t t-set="partner" t-value="request.env.user.partner_id"/>
            <t t-set="announcements" t-value="request.env['contact.announcement'].sudo().search([
                ('active', '=', True),
                ('partner_ids', 'in', partner.id),
            ])"/>

            <t t-foreach="announcements" t-as="announcement">

                <t t-set="alert_class" t-value="'alert-info'"/>
                <t t-if="announcement.priority == 'warning'" t-set="alert_class" t-value="'alert-warning'"/>
                <t t-if="announcement.priority == 'important'" t-set="alert_class" t-value="'alert-danger'"/>

                <div t-attf-class="alert {{ alert_class }} mt-2 mb-2">
                    <strong><t t-esc="announcement.name"/></strong>
                    <div t-field="announcement.content"/>
                </div>

            </t>
        </xpath>
    </template>

    <!-- Portal Layout: notification message icon into top navigation -->
    <template id="portal_notification_message" inherit_id="portal.frontend_layout">
        <xpath expr="//t[@t-call='portal.user_dropdown']" position="before">
            <t t-if="request.session.uid">

                <li class="nav-item dropdown o_no_autohide_item me-3">

                    <!--  unread count badge -->
                    <a href="#"
                       class="nav-link d-flex align-items-center justify-content-center"
                       data-bs-toggle="dropdown"
                       style="height: 100%;">
                        <div class="position-relative">
                            <i class="fa fa-comments" style="font-size: 22px; color: #4b5563;"/>
                            <span id="portal_notification_count"
                                  class="position-absolute top-0 start-100 translate-middle badge rounded-pill shadow-sm bg-success"
                                  style="font-size: 10px; color: white; min-width: 18px; height: 18px; padding: 3px 0; border: 2px solid #fff; margin-top: -2px;">
                                0
                            </span>
                        </div>
                    </a>

                    <!-- Notification dropdown panel -->
                    <div class="dropdown-menu dropdown-menu-end p-0 shadow-lg border-0 mt-3"
                         style="width: 340px; border-radius: 12px; overflow: hidden; animation: slideIn 0.3s ease;">

                        <!-- Dropdown header -->
                        <div class="px-3 py-3 d-flex justify-content-between align-items-center"
                             style="background: #ffffff; border-bottom: 1px solid #f3f4f6;">
                            <h6 class="mb-0 fw-bold" style="color: #111827;">Notifications</h6>
                        </div>

                        <!-- Scrollable notification list -->
                        <div id="portal_notification_list"
                             style="max-height: 380px; overflow-y: auto; background: #ffffff;">

                            <!-- Empty state — shown when no notifications exist -->
                            <div class="p-5 text-center text-muted">
                                <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                                     style="width: 50px; height: 50px; background: #f9fafb;">
                                    <i class="fa fa-comments" style="font-size: 20px; color: #d1d5db;"/>
                                </div>
                                <p class="small mb-0">No new updates right now.</p>
                            </div>

                        </div>

                        <!-- Dropdown footer -->
                        <div class="p-2 text-center border-top" style="background: #f9fafb;">
                            <small class="text-muted">Stay updated with latest announcements</small>
                        </div>

                    </div>
                </li>

            </t>
        </xpath>
    </template>

</odoo>