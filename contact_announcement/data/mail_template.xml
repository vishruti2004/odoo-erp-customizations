<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="email_template_contact_announcement" model="mail.template">
            <field name="name">Contact Announcement Email</field>
            <field name="model_id" ref="model_contact_announcement"/>
            <field name="subject">Announcement: {{ object.name }}</field>
            <field name="email_from">{{ object.company_id.email_formatted }}</field>
            <field name="body_html" type="html">
                <div style="margin:0; padding:0;">
                    <div style="max-width:600px; margin:30px auto; background:#ffffff; border-radius:10px; overflow:hidden; box-shadow:0 2px 8px rgba(0,0,0,0.1);">

                        <!-- Header: color changes based on announcement priority -->
                        <t t-if="object.priority == 'important'">
                            <div style="background-color:#e74c3c; padding:30px; text-align:center;">
                                <h2 style="color:#ffffff; margin:0; font-size:22px; font-family:Arial, sans-serif;">
                                    <t t-out="object.name"/>
                                </h2>
                                <p style="color:#fde8e8; margin:8px 0 0 0; font-size:14px; font-family:Arial, sans-serif;">
                                    Immediate Attention Required
                                </p>
                            </div>
                        </t>

                        <t t-if="object.priority == 'warning'">
                            <div style="background-color:#f39c12; padding:30px; text-align:center;">
                                <h2 style="color:#ffffff; margin:0; font-size:22px; font-family:Arial, sans-serif;">
                                    <t t-out="object.name"/>
                                </h2>
                                <p style="color:#fef9e7; margin:8px 0 0 0; font-size:14px; font-family:Arial, sans-serif;">
                                    Please Review This Notice
                                </p>
                            </div>
                        </t>

                        <t t-if="object.priority == 'info'">
                            <div style="background-color:#3498db; padding:30px; text-align:center;">
                                <h2 style="color:#ffffff; margin:0; font-size:22px; font-family:Arial, sans-serif;">
                                    <t t-out="object.name"/>
                                </h2>
                                <p style="color:#eaf4fc; margin:8px 0 0 0; font-size:14px; font-family:Arial, sans-serif;">
                                    For Your Information
                                </p>
                            </div>
                        </t>

                        <!-- Email body -->
                        <div style="padding:30px; font-family:Arial, sans-serif;">

                            <!-- Recipient greeting — uses context partner name if available -->
                            <p style="font-size:16px; color:#333;">
                                Dear <strong>
                                    <t t-out="env.context.get('current_partner') and env.context.get('current_partner').name or (object.partner_ids[0].name if object.partner_ids else 'Customer')"/>
                                </strong>,
                            </p>

                            <p style="font-size:14px; color:#555; line-height:1.6;">
                                We have an important announcement for you. Please review the details below.
                            </p>

                            <!-- Announcement content block -->
                            <t t-if="object.content">
                                <div style="padding:20px; background:#f9f9f9; border-left:4px solid #3498db; margin:20px 0; border-radius:0 5px 5px 0;">
                                    <t t-out="object.content"/>
                                </div>
                            </t>

                        </div>

                        <!-- Footer -->
                        <div style="background:#f8f8f8; padding:20px; text-align:center; border-top:1px solid #eee;">
                            <p style="margin:0; font-size:12px; color:#999; font-family:Arial, sans-serif;">
                                This is an automated announcement. Please do not reply.
                            </p>
                            <p style="margin:5px 0 0 0; font-size:12px; font-weight:bold; font-family:Arial, sans-serif; color:#555;">
                                <t t-out="object.company_id.name"/>
                            </p>
                        </div>

                    </div>
                </div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

    </data>
</odoo>