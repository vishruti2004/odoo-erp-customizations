<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="mail.Chatter" t-inherit-mode="extension">

        <xpath expr="//div[contains(@class, 'o-mail-Chatter-topbar')]" position="inside">
            <button type="button"
                    class="btn btn-link text-action"
                    title="Advanced Filters"
                    aria-label="Advanced Filters"
                    t-on-click="toggleAdvancedFilters">
                <i class="fa fa-filter" role="img"/>
            </button>
        </xpath>

        <xpath expr="//div[contains(@class, 'o-mail-Chatter-content')]" position="before">
            <div t-if="advancedFilterState.showAdvancedFilters"
                 class="o-advanced-chatter-filter-panel mx-2 mb-2 p-3 border rounded">
                <div class="row g-2 mb-3">
                    <div class="col-md-6">
                        <label class="form-label">From Date</label>
                        <input type="date"
                               class="form-control form-control-sm"
                               t-model="advancedFilterState.filters.dateFrom"
                               t-on-change="applyAdvancedFilters"/>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">To Date</label>
                        <input type="date"
                               class="form-control form-control-sm"
                               t-model="advancedFilterState.filters.dateTo"
                               t-on-change="applyAdvancedFilters"/>
                    </div>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-md-4">
                        <label class="form-label">User / Author</label>
                        <select class="form-select form-select-sm"
                                t-model="advancedFilterState.filters.userId"
                                t-on-change="applyAdvancedFilters">
                            <option value="">All Users</option>
                            <option t-foreach="conversationAuthors"
                                    t-as="user"
                                    t-key="user.id"
                                    t-att-value="user.id">
                                <t t-esc="user.name"/>
                            </option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Message Type</label>
                        <select class="form-select form-select-sm"
                                t-model="advancedFilterState.filters.messageType"
                                t-on-change="applyAdvancedFilters">
                            <option value="">All Types</option>
                            <option t-foreach="conversationMessageTypes"
                                    t-as="type"
                                    t-key="type.value"
                                    t-att-value="type.value">
                                <t t-esc="type.label"/>
                            </option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Message Subtype</label>
                        <select class="form-select form-select-sm"
                                t-model="advancedFilterState.filters.subtypeId"
                                t-on-change="applyAdvancedFilters">
                            <option value="">All Subtypes</option>
                            <option t-foreach="conversationSubtypes"
                                    t-as="subtype"
                                    t-key="subtype.id"
                                    t-att-value="subtype.id">
                                <t t-esc="subtype.name"/>
                            </option>
                        </select>
                    </div>
                </div>

                <div t-if="conversationActivities.length" class="row g-2 mb-3">
                    <div class="col-md-4">
                        <label class="form-label">Activity Type</label>
                        <select class="form-select form-select-sm"
                                t-model="advancedFilterState.filters.activityTypeId"
                                t-on-change="applyAdvancedFilters">
                            <option value="">All Activity Types</option>
                            <option t-foreach="conversationActivityTypes"
                                    t-as="activityType"
                                    t-key="activityType.id"
                                    t-att-value="activityType.id">
                                <t t-esc="activityType.name"/>
                            </option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Activity User</label>
                        <select class="form-select form-select-sm"
                                t-model="advancedFilterState.filters.activityUserId"
                                t-on-change="applyAdvancedFilters">
                            <option value="">All Activity Users</option>
                            <option t-foreach="conversationActivityUsers"
                                    t-as="activityUser"
                                    t-key="activityUser.id"
                                    t-att-value="activityUser.id">
                                <t t-esc="activityUser.name"/>
                            </option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Activity Status</label>
                        <select class="form-select form-select-sm"
                                t-model="advancedFilterState.filters.activityState"
                                t-on-change="applyAdvancedFilters">
                            <option value="">All Activity Statuses</option>
                            <option t-foreach="conversationActivityStates"
                                    t-as="activityState"
                                    t-key="activityState.value"
                                    t-att-value="activityState.value">
                                <t t-esc="activityState.label"/>
                            </option>
                        </select>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <button type="button"
                            class="btn btn-sm btn-outline-secondary"
                            t-on-click="clearAdvancedFilters">
                        <i class="fa fa-times me-1"/>
                        Clear Filters
                    </button>

                    <button type="button"
                            class="btn btn-sm btn-outline-secondary"
                            t-on-click="exportAdvancedResults">
                        <i class="fa fa-download me-1"/>
                        Export Results
                    </button>
                </div>
            </div>
        </xpath>
    </t>

    <t t-inherit="mail.Thread" t-inherit-mode="extension">
        <xpath expr="//t[@t-set='messages' and @t-value='orderedMessages']"
               position="replace">
            <t t-set="messages"
               t-value="filteredMessages"/>
        </xpath>
    </t>

    <t t-inherit="mail.SearchMessageInput" t-inherit-mode="extension">

        <xpath expr="//input[hasclass('o_searchview_input')]" position="attributes">
            <attribute name="t-on-input">onKeywordSync</attribute>
            <attribute name="t-on-focus">onKeywordFocusSync</attribute>
            <attribute name="t-on-blur">onKeywordBlurSync</attribute>
        </xpath>

        <xpath expr="//div[hasclass('o-mail-SearchMessageInput')]" position="after">

            <div t-if="env.advancedChatterSearch
                        and env.advancedChatterSearch.advancedFilterState.showSuggestions
                        and env.advancedChatterSearch.advancedFilterState.filters.keyword.trim()"
                 class="o-advanced-chatter-search-dropdown">

                <t t-foreach="env.advancedChatterSearch.searchSuggestionGroups" t-as="group" t-key="group.key">

                    <div t-if="group.key === 'message'"
                         class="o-advanced-chatter-search-suggestion"
                         t-on-mousedown.prevent="() => this.selectSuggestionAndSync(group)">
                        Search <b t-esc="group.label"/> for:
                        <span class="text-primary fst-italic"
                              t-esc="env.advancedChatterSearch.advancedFilterState.filters.keyword"/>
                    </div>

                    <t t-else="">

                        <t t-if="group.items.length === 1">
                            <div class="o-advanced-chatter-search-suggestion"
                                 t-on-mousedown.prevent="() => this.selectSuggestionAndSync(group, group.items[0])">
                                Search <b t-esc="group.label"/> for:
                                <span class="text-primary fst-italic"
                                      t-esc="env.advancedChatterSearch.advancedFilterState.filters.keyword"/>
                            </div>
                        </t>

                        <t t-else="">
                            <div class="o-advanced-chatter-search-suggestion o-advanced-chatter-search-group"
                                 t-on-mousedown.prevent="() => this.toggleAdvancedGroup(group.key)">
                                <i t-att-class="advancedDropdownState.expandedGroup === group.key
                                    ? 'fa fa-caret-down me-2'
                                    : 'fa fa-caret-right me-2'"/>
                                Search <b t-esc="group.label"/> for:
                                <span class="text-primary fst-italic"
                                      t-esc="env.advancedChatterSearch.advancedFilterState.filters.keyword"/>
                            </div>

                            <t t-if="advancedDropdownState.expandedGroup === group.key">
                                <div t-foreach="group.items"
                                     t-as="item"
                                     t-key="item.id || item.value || item.name"
                                     class="o-advanced-chatter-search-suggestion ps-4"
                                     t-on-mousedown.prevent="() => this.selectSuggestionAndSync(group, item)">
                                    <t t-esc="item.label || item.name"/>
                                    <t t-if="item.default_code">
                                        <span class="text-muted ms-1">
                                            [<t t-esc="item.default_code"/>]
                                        </span>
                                    </t>
                                </div>
                            </t>
                        </t>
                    </t>
                </t>
            </div>
        </xpath>
    </t>
</templates>