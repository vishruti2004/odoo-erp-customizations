<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="mail.SearchMessageInput" t-inherit-mode="extension">

        <xpath expr="//input[hasclass('o_searchview_input')]" position="attributes">
            <attribute name="t-on-input">onKeywordSync</attribute>
            <attribute name="t-on-focus">onKeywordFocusSync</attribute>
            <attribute name="t-on-blur">onKeywordBlurSync</attribute>
        </xpath>

        <xpath expr="//Dropdown[@t-if='env.inChatter']" position="attributes">
            <attribute name="state">filterDropdownState</attribute>
        </xpath>

        <xpath expr="//Dropdown[@t-if='env.inChatter']//button" position="attributes">
            <attribute name="t-att-class">
                env.advancedChatterSearch and env.advancedChatterSearch.activeAdvancedFilterCount > 0 ? 'o-advanced-chatter-filter-active' : ''
            </attribute>
        </xpath>

        <xpath expr="//Dropdown[@t-if='env.inChatter']//button" position="inside">
            <span t-if="env.advancedChatterSearch and env.advancedChatterSearch.activeAdvancedFilterCount > 0"
                  class="o-advanced-chatter-filter-count"
                  t-esc="env.advancedChatterSearch.activeAdvancedFilterCount"/>
        </xpath>

        <xpath expr="//div[hasclass('o-mail-SearchMessageInput')]" position="after">
            <div t-if="env.advancedChatterSearch
                and env.advancedChatterSearch.hasAdvancedChatterAccess
                and env.advancedChatterSearch.showAdvancedSearch
                and env.advancedChatterSearch.advancedFilterState.showSuggestions
                and state.searchTerm.trim()"
                 class="o-advanced-chatter-search-dropdown">

                <t t-foreach="env.advancedChatterSearch.searchSuggestionGroups"
                   t-as="group"
                   t-key="group.key">

                    <div t-if="group.key === 'message'"
                         class="o-advanced-chatter-search-suggestion"
                         t-on-mousedown.prevent="() => this.selectSuggestionAndSync(group)">
                        Search <b t-esc="group.label"/> for:
                        <span class="text-primary fst-italic" t-esc="state.searchTerm"/>
                    </div>

                    <t t-else="">
                        <t t-if="group.items.length === 1">
                            <div class="o-advanced-chatter-search-suggestion"
                                 t-on-mousedown.prevent="() => this.selectSuggestionAndSync(group, group.items[0])">
                                Search <b t-esc="group.label"/> for:
                                <span class="text-primary fst-italic"
                                      t-esc="group.items[0].displayName"/>
                            </div>
                        </t>

                        <t t-else="">
                            <div class="o-advanced-chatter-search-suggestion o-advanced-chatter-search-group"
                                 t-on-mousedown.prevent="() => this.toggleAdvancedGroup(group.key)">
                                <i t-att-class="advancedDropdownState.expandedGroup === group.key
                                    ? 'fa fa-caret-down me-2'
                                    : 'fa fa-caret-right me-2'"/>
                                Search <b t-esc="group.label"/> for:
                                <span class="text-primary fst-italic" t-esc="state.searchTerm"/>
                            </div>

                            <t t-if="advancedDropdownState.expandedGroup === group.key">
                                <div t-foreach="group.items"
                                     t-as="item"
                                     t-key="item.displayName"
                                     class="o-advanced-chatter-search-suggestion ps-4"
                                     t-on-mousedown.prevent="() => this.selectSuggestionAndSync(group, item)">
                                    <t t-esc="item.displayName"/>
                                </div>
                            </t>
                        </t>
                    </t>

                </t>

            </div>
        </xpath>

        <xpath expr="//t[@t-foreach='searchFilters']" position="after">
            <div t-if="env.advancedChatterSearch
                       and env.advancedChatterSearch.hasAdvancedChatterAccess
                       and env.advancedChatterSearch.showAdvancedFilters"
                 class="o-advanced-chatter-filter-panel p-2"
                 style="min-width: 620px;">

                <hr class="my-2"/>

                <div class="row g-2 mb-2">
                    <div class="col-6">
                        <label class="form-label small mb-1">From Date</label>
                        <DateTimeInput
                            type="'date'"
                            value="env.advancedChatterSearch.dateFromValue"
                            placeholder="'Select date'"
                            onChange="(date) => env.advancedChatterSearch.setDateFilter('dateFrom', date)"/>
                    </div>
                    <div class="col-6">
                        <label class="form-label small mb-1">To Date</label>
                        <DateTimeInput
                            type="'date'"
                            value="env.advancedChatterSearch.dateToValue"
                            placeholder="'Select date'"
                            onChange="(date) => env.advancedChatterSearch.setDateFilter('dateTo', date)"/>
                    </div>
                </div>

                <div class="row g-2 mb-2">
                    <div class="col-4">
                        <label class="form-label small mb-1">User / Author</label>
                        <select class="form-select form-select-sm"
                                t-model="env.advancedChatterSearch.advancedFilterState.filters.userId"
                                t-on-change="() => env.advancedChatterSearch.onMessageFilterChanged()">
                            <option value="">All Users</option>
                            <option t-foreach="env.advancedChatterSearch.conversationAuthors"
                                    t-as="user" t-key="user.id" t-att-value="user.id"
                                    t-att-selected="user.id == env.advancedChatterSearch.advancedFilterState.filters.userId">
                                <t t-esc="user.name"/>
                            </option>
                        </select>
                    </div>
                    <div class="col-4">
                        <label class="form-label small mb-1">Message Type</label>
                        <select class="form-select form-select-sm"
                                t-model="env.advancedChatterSearch.advancedFilterState.filters.messageType"
                                t-on-change="() => env.advancedChatterSearch.onMessageFilterChanged()">
                            <option value="">All Types</option>
                            <option t-foreach="env.advancedChatterSearch.conversationMessageTypes"
                                    t-as="type" t-key="type.value" t-att-value="type.value"
                                    t-att-selected="type.value === env.advancedChatterSearch.advancedFilterState.filters.messageType">
                                <t t-esc="type.label"/>
                            </option>
                        </select>
                    </div>
                    <div class="col-4">
                        <label class="form-label small mb-1">Message Subtype</label>
                        <select class="form-select form-select-sm"
                                t-model="env.advancedChatterSearch.advancedFilterState.filters.subtypeId"
                                t-on-change="() => env.advancedChatterSearch.onMessageFilterChanged()">
                            <option value="">All Subtypes</option>
                            <option t-foreach="env.advancedChatterSearch.conversationSubtypes"
                                    t-as="subtype" t-key="subtype.id" t-att-value="subtype.id"
                                    t-att-selected="subtype.id == env.advancedChatterSearch.advancedFilterState.filters.subtypeId">
                                <t t-esc="subtype.name"/>
                            </option>
                        </select>
                    </div>
                </div>

                <t t-if="env.advancedChatterSearch.showActivityFilters and env.advancedChatterSearch.conversationActivities.length">
                    <div class="row g-2 mb-2">
                        
                        <div class="col-4">
                            <label class="form-label small mb-1">Activity User</label>
                            <select class="form-select form-select-sm"
                                    t-model="env.advancedChatterSearch.advancedFilterState.filters.activityUserId"
                                    t-on-change="() => env.advancedChatterSearch.onActivityFilterChanged()">
                                <option value="">All Activity Users</option>
                                <option t-foreach="env.advancedChatterSearch.conversationActivityUsers"
                                        t-as="activityUser" t-key="activityUser.id" t-att-value="activityUser.id"
                                        t-att-selected="activityUser.id == env.advancedChatterSearch.advancedFilterState.filters.activityUserId">
                                    <t t-esc="activityUser.name"/>
                                </option>
                            </select>
                        </div>

                        <div class="col-4">
                            <label class="form-label small mb-1">Activity Type</label>
                            <select class="form-select form-select-sm"
                                    t-model="env.advancedChatterSearch.advancedFilterState.filters.activityTypeId"
                                    t-on-change="() => env.advancedChatterSearch.onActivityFilterChanged()">
                                <option value="">All Activity Types</option>
                                <option t-foreach="env.advancedChatterSearch.conversationActivityTypes"
                                        t-as="activityType" t-key="activityType.id" t-att-value="activityType.id"
                                        t-att-selected="activityType.id == env.advancedChatterSearch.advancedFilterState.filters.activityTypeId">
                                    <t t-esc="activityType.name"/>
                                </option>
                            </select>
                        </div>
                        
                        <div class="col-4">
                            <label class="form-label small mb-1">Activity Status</label>
                            <select class="form-select form-select-sm"
                                    t-model="env.advancedChatterSearch.advancedFilterState.filters.activityState"
                                    t-on-change="() => env.advancedChatterSearch.onActivityFilterChanged()">
                                <option value="">All Activity Status</option>
                                <option t-foreach="env.advancedChatterSearch.conversationActivityStates"
                                        t-as="activityState" t-key="activityState.value" t-att-value="activityState.value"
                                        t-att-selected="activityState.value === env.advancedChatterSearch.advancedFilterState.filters.activityState">
                                    <t t-esc="activityState.label"/>
                                </option>
                            </select>
                        </div>
                    </div>
                </t>

                <div class="d-flex justify-content-between align-items-center mt-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary"
                            t-on-click="() => env.advancedChatterSearch.clearAdvancedFilters()">
                        <i class="fa fa-times me-1"/>
                        Clear Filters
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary"
                            t-on-click="() => env.advancedChatterSearch.exportAdvancedResults()">
                        <i class="fa fa-download me-1"/>
                        Export Results
                    </button>
                </div>
            </div>
        </xpath>
    </t>
    
</templates>