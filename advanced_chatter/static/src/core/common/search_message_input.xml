<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="mail.SearchMessageInput" t-inherit-mode="extension">

        <xpath expr="//div[hasclass('o-mail-SearchMessageInput')]" position="attributes">
            <attribute name="class" add="position-relative" separator=" " />
            <attribute name="t-on-focusin">(ev) => this.onAdvancedFocusIn(ev) </attribute>
            <attribute name="t-on-focusout">(ev) => this.onAdvancedFocusOut(ev) </attribute>
        </xpath>

        <xpath expr="//Dropdown[@t-if='env.inChatter']" position="attributes">
            <attribute name="state">filterDropdownState</attribute>
        </xpath>

        <xpath expr="//Dropdown[@t-if='env.inChatter']/button" position="attributes">
            <attribute name="t-att-class">{ 'o-advanced-chatter-filter-active': advancedChatter?.activeAdvancedFilterCount }</attribute>
        </xpath>

        <xpath expr="//Dropdown[@t-if='env.inChatter']/button" position="inside">
            <span t-if="advancedChatter?.activeAdvancedFilterCount" class="o-advanced-chatter-filter-count badge rounded-pill text-bg-success" t-out="advancedChatter.activeAdvancedFilterCount" />
        </xpath>

        <xpath expr="//div[hasclass('o-mail-SearchMessageInput')]" position="inside">
            <div t-if="advancedChatter?.showAdvancedSearch and advancedChatter.advancedSearchState.showSuggestions and state.searchTerm.trim()"
                 class="o-advanced-chatter-search-dropdown dropdown-menu show w-100 py-1"
                 t-on-mousedown.prevent="() => {}">
                <div class="dropdown-item o-advanced-chatter-search-suggestion"
                     t-on-mousedown.prevent="() => this.selectAdvancedKeyword()">
                    Search 
                    <b>Message</b> for:
                    <span class="text-primary fst-italic" t-out="state.searchTerm" />
                </div>
                <t t-foreach="advancedChatter.advancedSearchState.suggestions" t-as="group" t-key="group.key">
                    <div t-if="group.items.length === 1"
                         class="dropdown-item o-advanced-chatter-search-suggestion"
                         t-on-mousedown.prevent="() => this.selectAdvancedSuggestion(group, group.items[0])">
                        Search 
                        <b t-out="group.label" /> for:
                        <span class="text-primary fst-italic" t-out="group.items[0].label" />
                    </div>
                    <t t-else="">
                        <div class="dropdown-item o-advanced-chatter-search-suggestion"
                             t-on-mousedown.prevent="() => this.toggleAdvancedGroup(group.key)">
                            <i class="oi oi-fw me-1" role="img" t-att-class="advancedDropdownState.expandedGroup === group.key ? 'oi-chevron-down' : 'oi-chevron-right'" />
                            Search 
                            <b t-out="group.label" /> for:
                            <span class="text-primary fst-italic" t-out="state.searchTerm" />
                        </div>
                        <t t-if="advancedDropdownState.expandedGroup === group.key">
                            <div t-foreach="group.items" t-as="item" t-key="item_index"
                                 class="dropdown-item o-advanced-chatter-search-suggestion ps-5"
                                 t-on-mousedown.prevent="() => this.selectAdvancedSuggestion(group, item)">
                                <t t-out="item.label" />
                            </div>
                        </t>
                    </t>
                </t>
            </div>
        </xpath>

        <xpath expr="//t[@t-foreach='searchFilters']" position="after">
            <div t-if="advancedChatter?.showAdvancedFilters" class="o-advanced-chatter-filter-panel px-2 pb-2">
                <hr class="my-2" />
                <div t-if="advancedChatter.messageDateField" class="mb-2">
                    <label class="form-label small mb-1" t-out="advancedChatter.messageDateField.label" />
                    <div class="row g-2">
                        <div class="col-6">
                            <DateTimeInput type="'date'"
                                           placeholder.translate="From"
                                           value="advancedChatter.advancedSearchState.dateFrom"
                                           onApply="(date) => this.onAdvancedDateApply('dateFrom', date)"/>
                        </div>
                        <div class="col-6">
                            <DateTimeInput type="'date'"
                                           placeholder.translate="To"
                                           value="advancedChatter.advancedSearchState.dateTo"
                                           onApply="(date) => this.onAdvancedDateApply('dateTo', date)"/>
                        </div>
                    </div>
                </div>
                <t t-foreach="['message', 'activity']" t-as="kind" t-key="kind">
                    <div t-if="kind === 'message' or advancedChatter.showActivityFilters" class="row g-2 mb-2">
                        <t t-foreach="kind === 'message' ? advancedChatter.messageFilterGroups : advancedChatter.activityFilterGroups" t-as="group" t-key="group.field">
                            <div t-if="advancedChatter.isFilterGroupVisible(kind, group)" class="col">
                                <label class="form-label small mb-1" t-out="group.label" />
                                <select class="form-select form-select-sm"
                                        t-on-change="(ev) => this.onAdvancedFilterChange(kind, group, ev.target.value)">
                                    <option value="">All</option>
                                    <option t-foreach="group.options"
                                            t-as="option"
                                            t-key="option.value"
                                            t-att-value="option.value"
                                            t-att-selected="option.value === advancedChatter.getFilterValue(kind, group)"
                                            t-out="option.label" />
                                </select>
                            </div>
                        </t>
                    </div>
                </t>
                <div class="d-flex justify-content-between align-items-center mt-2">
                    <button type="button" class="btn btn-sm btn-secondary" t-on-click="() => this.onAdvancedClearFilters()">
                        <i class="oi oi-close me-1" role="img" />
                        Clear Filters
                    </button>
                    <button type="button" class="btn btn-sm btn-secondary" t-on-click="() => advancedChatter.exportAdvancedResults()">
                        <i class="fa fa-download me-1" role="img" />
                        Export Results
                    </button>
                </div>
            </div>
        </xpath>
    </t>
</templates>