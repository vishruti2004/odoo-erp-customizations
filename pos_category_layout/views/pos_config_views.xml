<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="pos_config_view_form_category_layout" model="ir.ui.view">
        <field name="name">pos.config.form.category.layout</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>

        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">

                <separator string="POS Category Layout"/>

                <group string="Custom Configuration">
                    <field name="enable_custom_layout"/>
                </group>

                <group string="Category Configuration"
                       col="2"
                       invisible="not enable_custom_layout">

                    <group string="Category Layout">
                        <field name="category_layout"
                               widget="radio"
                               options="{'horizontal': true}"/>

                        <field name="category_sidebar_position"
                               widget="radio"
                               options="{'horizontal': true}"
                               invisible="category_layout != 'sidebar'"/>

                        <field name="category_display_style"
                               widget="radio"
                               options="{'horizontal': true}"
                               invisible="category_layout != 'sidebar'"/>

                        <field name="category_card_style"
                               invisible="category_layout == 'sidebar' and category_display_style == 'list'"/>

                        <field name="category_content"
                               widget="radio"
                               options="{'horizontal': true}"
                               invisible="category_card_style != 'classic' and not (category_layout == 'sidebar' and category_display_style == 'list')"/>

                        <field name="category_image_position"
                               widget="radio"
                               options="{'horizontal': true}"
                               invisible="category_content != 'image_name' or category_card_style != 'classic'"/>

                        <field name="category_scope"
                               widget="radio"/>

                        <field name="category_rows"
                               invisible="category_layout == 'sidebar' and not category_show_all_popup"/>
                        <field name="category_carousel"
                               invisible="category_layout == 'sidebar' and not category_show_all_popup"/>
                        <field name="category_scroll_direction"
                               widget="radio"
                               options="{'horizontal': true}"
                               invisible="(category_layout == 'sidebar' and not category_show_all_popup) or category_carousel"/>
                        <field name="category_popup_scroll_direction"
                               widget="radio"
                               options="{'horizontal': true}"
                               invisible="category_layout != 'popup'"/>
                    </group>

                    <group string="Category Display Options">
                        <field name="category_sort_order"/>
                        <field name="category_show_breadcrumb"
                               invisible="category_layout == 'popup'"/>
                        <field name="category_show_product_count"/>
                        <field name="category_show_search"
                               invisible="category_layout == 'popup'"/>
                        <field name="category_use_color"/>
                        <field name="category_show_all_popup"
                               invisible="category_layout == 'popup'"/>
                        <field name="font_family"/>
                    </group>

                </group>

            </xpath>
        </field>
    </record>
</odoo>