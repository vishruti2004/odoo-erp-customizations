<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.CategorySelector" t-inherit-mode="extension">

        <xpath expr="//div[contains(@t-attf-class, 'category-list')]" position="attributes">
            <attribute name="t-if">!this.isCustomLayout</attribute>
        </xpath>

        <xpath expr="//div[contains(@t-attf-class, 'category-list')]" position="after">
            <div t-else="" class="o_pos_cat" t-att-class="this.layoutClass">
                <t t-set="items" t-value="this.getLayoutItems()"/>

                <div t-if="this.showHeader" class="o_pos_cat_controls">
                    <!-- Sidebar toggle + back + breadcrumb -->
                    <div t-if="this.isSidebar or this.showBreadcrumb or this.pos.selectedCategory"
                         class="o_pos_cat_header d-flex align-items-center gap-2">
                        <button t-if="this.isSidebar" type="button" class="o_pos_cat_toggle btn btn-light"
                                t-on-click="() => this.toggleSidebar()"
                                t-att-title="this.layoutState.collapsed ? 'Expand categories' : 'Collapse categories'">
                            <span t-out="this.layoutState.collapsed ? '»' : '«'"/>
                        </button>
                        <button t-if="this.pos.selectedCategory and !this.showBreadcrumb" type="button" class="o_pos_cat_back btn btn-light"
                                title="Back" t-on-click="() => this.onBackClick()">
                            <span>‹</span>
                        </button>
                        <nav t-if="this.showBreadcrumb" class="o_pos_cat_breadcrumb" aria-label="breadcrumb">
                            <button type="button" class="o_pos_cat_crumb btn btn-link p-0"
                                    t-att-class="{'active': !this.pos.selectedCategory}"
                                    t-on-click="() => this.onBreadcrumbClick(0)">All</button>
                            <t t-foreach="this.getBreadcrumbs()" t-as="crumb" t-key="crumb.id">
                                <span class="o_pos_cat_sep">/</span>
                                <button type="button" class="o_pos_cat_crumb btn btn-link p-0"
                                        t-att-class="{'active': crumb_last}"
                                        t-on-click="() => this.onBreadcrumbClick(crumb.id)"
                                        t-out="crumb.name"/>
                            </t>
                        </nav>
                    </div>

                    <!-- Category search -->
                    <div t-if="this.showSearch" class="o_pos_cat_search_wrap">
                        <input type="text" class="o_pos_cat_search form-control form-control-sm"
                               placeholder="Search category..."
                               t-att-value="this.layoutState.search"
                               t-on-input="(ev) => this.onSearchInput(ev)"/>
                        <button t-if="this.isSearching" type="button" class="o_pos_cat_search_clear"
                                title="Clear" t-on-click="() => this.clearSearch()">✕</button>
                    </div>
                </div>

                <div class="o_pos_cat_list">
                    <button t-foreach="items" t-as="item" t-key="item.id" type="button"
                            t-attf-class="o_colorlist_item_color_{{item.color or 'none'}}"
                            t-att-class="this.getItemClass(item)"
                            t-att-style="this.getItemStyle(item)"
                            t-att-title="item.path ? item.path + ' / ' + item.name : item.name"
                            t-on-click="() => this.onCategoryClick(item.id)"
                            class="o_pos_cat_item category-button btn btn-light d-flex align-items-center rounded-3 gap-1 p-1">

                        <span t-if="this.isNested and item.hasChildren" class="o_pos_cat_caret" role="button"
                              t-on-click.stop="() => this.toggleNode(item)"
                              t-out="item.expanded ? '▾' : '▸'"/>
                        <span t-elif="this.isNested" class="o_pos_cat_caret"/>

                        <div t-if="this.showImage" class="o_pos_cat_thumb">
                            <img t-if="item.imgSrc" t-att-src="item.imgSrc" class="o_pos_cat_img pe-none" alt="" draggable="false"/>
                            <span t-else="" class="o_pos_cat_initial" t-out="item.initial"/>
                        </div>

                        <div t-if="this.showName or this.showProductCount" class="o_pos_cat_text">
                            <span t-if="this.showName" class="o_pos_cat_name" t-out="item.name"/>
                            <span t-if="item.path" class="o_pos_cat_path" t-out="item.path"/>
                            <span t-if="this.showProductCount" class="o_pos_cat_count badge rounded-pill" t-out="item.count"/>
                        </div>
                    </button>
                    <div t-if="!items.length and this.isSearching" class="o_pos_cat_empty">No category found</div>
                </div>

            </div>
        </xpath>
    </t>
</templates>